---
interface Props {
  iosUrl?: string;
  androidUrl?: string;
  class?: string;
}

const {
  iosUrl = "#",
  androidUrl = "#",
  class: className = "",
} = Astro.props;
---

<div class:list={["flex flex-wrap gap-3", className]}>
  <a
    href={iosUrl}
    class="inline-flex items-center justify-center w-[180px] py-3.5 text-[12px] uppercase tracking-[1.5px] font-medium text-brand-black bg-white rounded-full hover:bg-brand-gray-200 transition-colors"
  >
    <svg class="w-5 h-5 mr-2 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
    Get for iOS
  </a>
  <a
    href={androidUrl}
    class="inline-flex items-center justify-center w-[180px] py-3.5 text-[12px] uppercase tracking-[1.5px] font-medium text-white border border-white/20 rounded-full hover:border-white/40 transition-colors"
  >
    <svg class="w-5 h-5 mr-2 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M3.18 23.49L14.17 12.5 3.18.51c-.21.2-.18.53-.18.86v21.26c0 .33-.03.66.18.86zm1.63 1.07l12.27-6.87-2.69-2.69-9.58 9.56zm12.27-18.12L4.81-.43l9.58 9.56 2.69-2.69zM21.23 11l-3.45-1.93L14.76 12.1l3.02 3.02L21.23 13c.53-.28.77-.76.77-1s-.24-.72-.77-1z"/></svg>
    Get for Android
  </a>
</div>
