---
import PriceTag from './commerce/PriceTag';
const CF_IMG = "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg";

const devices = [
  { name: "The Scale", slug: "scale", image: `${CF_IMG}/scale-black-pack/public`, metric: "Body Composition · Weight", color: "#3B82F6", desc: "Know your body beyond the number. Track weight, body fat, muscle mass, and more with medical-grade precision.", price: "From $99.99" },
  { name: "BP Monitor", slug: "bp-monitor", image: `${CF_IMG}/bp-black/public`, metric: "Blood Pressure · Pulse", color: "#EF4444", desc: "Hospital-grade accuracy meets home comfort. Monitor blood pressure and heart rhythm in under 30 seconds.", price: "$89.99" },
  { name: "Hydra One", slug: "hydra-one", image: `${CF_IMG}/bottle-studio-wet/public`, metric: "Hydration · Intake", color: "#06B6D4", desc: "The smart bottle that knows when you need to drink. Personalized hydration goals that adapt to your day.", price: "$59.99" },
  { name: "Hema One", slug: "hema-one", image: `${CF_IMG}/hema-one-web/public`, metric: "Lipid Profile · Glucose · Uric Acid", color: "#A855F7", desc: "Lab-quality blood insights without the lab visit. 7 markers including full lipid profile, glucose, uric acid, and hemoglobin.", price: "$99.99" },
  { name: "Ring One", slug: "ring-one", image: `${CF_IMG}/ring-aurora-gold/public`, metric: "Heart Rate · SpO2 · Sleep", color: "#F97316", desc: "Your health, always on. Track heart rate, blood oxygen, sleep, and stress 24/7 from a ring you'll love wearing.", price: "From $179.99" },
];

// 5 evenly spaced positions (72° apart), starting from top (-90°)
const orbitAngles = [-90, -18, 54, 126, 198];
---

<section class="relative bg-brand-dark border-t border-white/5 overflow-hidden" data-ecosystem-section>
  <div class="relative min-h-screen flex flex-col pt-24 sm:pt-28 lg:pt-32 pb-12" data-ecosystem-flipper-wrap>

    <!-- TOP: Text area -->
    <div class="text-center max-w-3xl mx-auto px-6 w-full shrink-0">
      <div class="relative">
        <div data-ecosystem-intro>
          <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4" data-ecosystem-overline>One Ecosystem</p>
          <h2 class="font-display text-4xl sm:text-5xl lg:text-7xl font-300 uppercase leading-[0.95] mb-3" data-ecosystem-heading>
            Five Devices.<br />
            <span class="font-500">One Complete Picture.</span>
          </h2>
          <p class="text-brand-gray-400 leading-relaxed max-w-xl mx-auto" data-ecosystem-desc>
            Each device captures a layer of your health. Together, they reveal the full story. Patterns you'd never see with just one.
          </p>
        </div>

        <div class="absolute inset-0 flex flex-col items-center justify-end pointer-events-none" data-ecosystem-card-area>
          <div class="pointer-events-auto" style="opacity:0" data-flip-header="app">
            <p class="text-[11px] uppercase tracking-[3px] text-brand-gray-500 mb-1">The Hub</p>
            <p class="font-display text-2xl sm:text-3xl lg:text-4xl font-400 uppercase mb-3">SeeMyHealth App</p>
            <p class="text-sm sm:text-base text-brand-gray-400 mb-5 max-w-md mx-auto">Every metric, every device, one beautiful dashboard. See trends, get insights, and take control of your health.</p>
            <a href="/app" class="inline-flex items-center px-6 py-3 text-[12px] uppercase tracking-[1.5px] font-medium text-white border border-white/20 rounded-full hover:border-white/40 transition-colors">
              Explore the App
            </a>
          </div>
          {devices.map((device) => (
            <div class="absolute bottom-0 inset-x-0 pointer-events-auto" style="opacity:0" data-flip-header={device.slug}>
              <p class="text-[11px] uppercase tracking-[3px] mb-1" style={`color: ${device.color}`}>{device.metric}</p>
              <p class="font-display text-2xl sm:text-3xl lg:text-4xl font-400 uppercase mb-3">{device.name}</p>
              <p class="text-sm sm:text-base text-brand-gray-400 mb-2 max-w-md mx-auto">{device.desc}</p>
              <p class="text-[12px] uppercase tracking-[2px] font-medium mb-5" style={`color: ${device.color}`}>
                <PriceTag handle={device.slug} mode="from" prefix={device.price.startsWith("From") ? "From " : ""} fallback={device.price} client:idle />
              </p>
              <a href={`/products/${device.slug}`} class="inline-flex items-center px-6 py-3 text-[12px] uppercase tracking-[1.5px] font-medium text-brand-black rounded-full transition-colors" style={`background: ${device.color}`}>
                Learn More
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- MIDDLE: Circle constellation -->
    <div class="flex-1 flex items-center justify-center">
      <div class="text-center">
        <div class="relative inline-block mb-6" style="isolation: isolate;" data-ecosystem-orbit-wrap>
          <!-- Pulse rings -->
          <div class="absolute inset-0 -m-6 sm:-m-8 rounded-full eco-pulse-1" data-pulse-ring="1"></div>
          <div class="absolute inset-0 -m-14 sm:-m-18 rounded-full eco-pulse-2" data-pulse-ring="2"></div>
          <div class="absolute inset-0 -m-22 sm:-m-28 rounded-full eco-pulse-3" data-pulse-ring="3"></div>

          <!-- Orbit scale wrapper (GSAP scales this) — behind the main circle -->
          <div class="absolute inset-0" style="z-index: 1;" data-orbit-scale>
          <!-- Rotating orbit ring (CSS rotates this) -->
          <div class="absolute inset-0 eco-orbit" data-orbit-ring>
            {devices.map((device, i) => {
              const angle = orbitAngles[i] * (Math.PI / 180);
              return (
                <div
                  class="absolute w-14 h-14 sm:w-18 sm:h-18 lg:w-20 lg:h-20 rounded-full overflow-hidden border-2 shadow-lg shadow-black/40 eco-orbit-counter"
                  style={`border-color: ${device.color}60; --sat-angle: ${orbitAngles[i]}deg;`}
                  data-satellite={device.slug}
                >
                  <img src={device.image} alt={device.name} class="w-full h-full object-cover" loading="lazy" />
                </div>
              );
            })}
          </div>
          </div>

          <!-- Main app circle — always on top, independent of orbit -->
          <div class="relative w-52 h-52 sm:w-72 sm:h-72 lg:w-80 lg:h-80 rounded-full border-2 border-white/20 shadow-2xl shadow-black/60 overflow-hidden" style="z-index: 20;" data-ecosystem-circle>
            <div class="absolute inset-0 flex items-center justify-center bg-brand-gray-900" data-flip-face="app">
              <div class="text-center">
                <div class="w-20 h-20 sm:w-28 sm:h-28 mx-auto mb-2 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <img src={`${CF_IMG}/logo/public`} alt="SeeMyHealth" class="w-16 h-16 sm:w-24 sm:h-24 rounded-xl" loading="lazy" />
                </div>
                <p class="text-[10px] sm:text-[11px] uppercase tracking-[2px] text-brand-gray-400">The App</p>
              </div>
            </div>
            {devices.map((device) => (
              <div class="absolute inset-0" style="opacity:0" data-flip-face={device.slug}>
                <img src={device.image} alt={device.name} class="w-full h-full object-cover" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
              </div>
            ))}
          </div>
        </div>

        <!-- Label below circle -->
        <div class="relative h-5">
          <p class="absolute inset-x-0 top-0 text-[11px] uppercase tracking-[3px] text-brand-gray-500" data-flip-label="app">One app. Every metric.</p>
          {devices.map((device) => (
            <p class="absolute inset-x-0 top-0 text-[11px] uppercase tracking-[3px]" style={`color: ${device.color}; opacity:0`} data-flip-label={device.slug}>{device.metric}</p>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  /* Pulse rings */
  @keyframes eco-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.3; transform: scale(1.08); }
  }
  [data-pulse-ring] {
    border: 1.5px solid rgba(255, 255, 255, 0.12);
    transition: border-color 0.4s ease;
  }
  .eco-pulse-1 { animation: eco-pulse 2.5s ease-in-out infinite; }
  .eco-pulse-2 { animation: eco-pulse 2.5s ease-in-out infinite 0.4s; }
  .eco-pulse-3 { animation: eco-pulse 2.5s ease-in-out infinite 0.8s; }

  /* Orbit rotation */
  @keyframes eco-orbit-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  @keyframes eco-orbit-counter-spin {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to { transform: translate(-50%, -50%) rotate(-360deg); }
  }


  /* Each satellite is positioned at its angle on the orbit, and counter-rotates to stay upright */
  .eco-orbit-counter {
    position: absolute;
    top: 50%;
    left: 50%;
    animation: eco-orbit-counter-spin 30s linear infinite;
    will-change: transform;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    image-rendering: -webkit-optimize-contrast;
  }
  .eco-orbit-counter img {
    image-rendering: -webkit-optimize-contrast;
  }
  .eco-orbit {
    animation: eco-orbit-spin 30s linear infinite;
    will-change: transform;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
</style>
