---
const CF_IMG = "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg";
---

<section data-hero class="relative min-h-screen flex items-end pb-20 pt-24 overflow-hidden">
  <!-- Background image with clip-path reveal -->
  <div data-hero-image class="absolute inset-0" style="clip-path: circle(12% at 55% 45%);">
    <img
      src={`${CF_IMG}/ring-peekaboo/public`}
      alt="Woman looking through Ring One"
      class="w-full h-full object-cover"
    />
    <!-- Dark overlay for readability -->
    <div class="absolute inset-0 bg-gradient-to-t from-brand-black via-brand-black/60 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-brand-black/50 to-transparent"></div>
  </div>

  <div data-hero-content class="relative max-w-7xl mx-auto px-6 lg:px-8 w-full">
    <div class="max-w-2xl">
      <!-- Title -->
      <h1 data-reveal class="font-display text-5xl sm:text-6xl lg:text-8xl font-300 uppercase leading-[0.95] mb-6 opacity-0">
        See Your<br />
        <span class="font-500">Health</span>
      </h1>

      <!-- Subtitle -->
      <p data-reveal class="text-lg sm:text-xl text-brand-gray-300 leading-relaxed max-w-lg mb-10 opacity-0">
        One app. Six devices. Nothing hidden.<br />
        Try it free for a month. Add devices when you're ready.
      </p>

      <!-- CTAs -->
      <div data-reveal class="flex flex-wrap gap-4 opacity-0">
        <a
          href="/app"
          class="inline-flex items-center px-8 py-4 text-[13px] uppercase tracking-[1.5px] font-medium text-brand-black bg-white rounded-full hover:bg-brand-gray-200 transition-colors"
        >
          Get the App
        </a>
        <a
          href="/shop"
          class="inline-flex items-center px-8 py-4 text-[13px] uppercase tracking-[1.5px] font-medium text-white border border-white/20 rounded-full hover:border-white/40 transition-colors"
        >
          Shop Devices
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div data-reveal class="absolute bottom-8 left-1/2 -translate-x-1/2 opacity-0">
    <div class="w-[1px] h-12 bg-gradient-to-b from-transparent to-white/30 animate-pulse"></div>
  </div>
</section>
