---
const promises = [
  { text: "Encrypted", icon: "M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" },
  { text: "Never sold", icon: "M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" },
  { text: "You control sharing", icon: "M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" },
  { text: "Delete anytime", icon: "M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" },
];
---

<section class="py-16 sm:py-24 bg-brand-dark border-t border-white/5">
  <div class="max-w-5xl mx-auto px-6 lg:px-8" data-scroll-reveal>
    <!-- Bold headline statement -->
    <div class="text-center mb-10 sm:mb-14">
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-300 uppercase leading-[0.95] mb-4">
        Your data stays <span class="font-500">yours.</span>
      </h2>
      <p class="text-brand-gray-400 text-sm sm:text-base max-w-md mx-auto">
        Health data is personal. We built our entire platform around that principle.
      </p>
    </div>

    <!-- Compact promise bar -->
    <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 mb-8">
      {promises.map((p) => (
        <div class="inline-flex items-center gap-2 px-4 py-2.5 sm:px-5 sm:py-3 rounded-full border border-white/10 bg-white/[0.02] hover:border-white/20 transition-colors">
          <svg class="w-4 h-4 text-brand-gray-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d={p.icon} />
          </svg>
          <span class="text-[11px] sm:text-xs uppercase tracking-[1.5px] text-brand-gray-300 font-medium whitespace-nowrap">{p.text}</span>
        </div>
      ))}
    </div>

    <!-- Privacy link -->
    <div class="text-center">
      <a href="/privacy" class="inline-flex items-center gap-2 text-[12px] uppercase tracking-[1.5px] text-brand-gray-500 hover:text-white transition-colors">
        Read our privacy policy
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
