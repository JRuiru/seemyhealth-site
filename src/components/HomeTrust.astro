---
const trustPoints = [
  {
    title: "No data selling. Ever.",
    description: "Your health data exists to serve you, no one else. No ads, no selling. You choose if and when to share.",
    icon: "M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636",
  },
  {
    title: "Encrypted end-to-end",
    description: "TLS 1.3 in transit. AES-256 at rest. Your data is protected at every step.",
    icon: "M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z",
  },
  {
    title: "You control sharing",
    description: "Grant your doctor read-only access with a single toggle. Revoke it anytime. No PDFs, no emails. Live data, securely.",
    icon: "M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z",
  },
  {
    title: "Delete anytime",
    description: "Request full data deletion through the app. Processed within 30 days. Your data, your call.",
    icon: "M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16",
  },
];
---

<section class="py-20 sm:py-28 bg-brand-dark border-t border-white/5">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">
    <div class="text-center mb-14" data-scroll-reveal>
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">Trust & Privacy</p>
      <h2 class="font-display text-4xl sm:text-5xl font-300 uppercase leading-[0.95] mb-4">
        Your data. <span class="font-500">Your rules.</span>
      </h2>
      <p class="text-brand-gray-400 max-w-xl mx-auto">
        Health data is personal. We built our entire platform around that principle.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-4" data-scroll-stagger>
      {trustPoints.map((point) => (
        <div class="group rounded-xl bg-brand-black border border-white/5 hover:border-white/15 p-6 sm:p-8 transition-all">
          <svg class="w-6 h-6 text-brand-gray-600 group-hover:text-white mb-4 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d={point.icon} />
          </svg>
          <h3 class="text-base font-medium text-white mb-2">{point.title}</h3>
          <p class="text-sm text-brand-gray-500 leading-relaxed">{point.description}</p>
        </div>
      ))}
    </div>

    <div class="text-center mt-8" data-scroll-reveal>
      <a href="/privacy" class="inline-flex items-center gap-2 text-[12px] uppercase tracking-[1.5px] text-brand-gray-500 hover:text-white transition-colors">
        Read our privacy policy
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
