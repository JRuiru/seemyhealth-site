---
// For somebody who already owns a tracker, told as a chat: we ask, they answer, the coach stares,
// and we come round with an aside or two. Then two options: bring the tracker's data in through the
// phone's health store, or fill what a wrist can't measure with our devices. Then the wink: both.
import HealthPlatformBadges from './HealthPlatformBadges.astro';
import type { Season } from '../lib/season';

const CF_IMG = "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg";

// The thread, in order. `us` is SeeMyHealth, `you` the visitor; an aside is a smaller, quieter
// afterthought; the image is the coach, sent as a message.
type Message =
  | { from: 'us' | 'you'; text: string; aside?: boolean }
  | { from: 'us'; image: string; alt: string; seasonal?: Record<Season, { clip: string; alt: string }> };
const chat: Message[] = [
  { from: 'us', text: 'Hang on.' },
  { from: 'us', text: 'You already have a fitness tracker?' },
  { from: 'you', text: 'Um… yes?' },
  {
    from: 'us',
    image: `${CF_IMG}/fitness-ring-portrait/public`,
    alt: 'A coach in a training vest staring straight at you',
    // A muted loop in season; the still stays for the rest of the year
    seasonal: { halloween: { clip: '/media/coach-halloween', alt: 'The coach dressed as a vampire, eyeing your tracker, then grinning' } },
  },
  { from: 'us', text: 'Cool. Keep it.' },
  { from: 'us', text: '(for now)', aside: true },
  { from: 'us', text: "Seriously, we're not mad." },
  { from: 'us', text: '(or are we?)', aside: true },
];
const chatText = chat.map((m) => ('text' in m ? m.text : '')).join(' ');

const options = [
  {
    overline: "Option one",
    title: "Keep what you've got.",
    text: "Your watch already counts steps, heart rate and sleep. Switch on Apple Health or Health Connect and it all lands in SeeMyHealth. One tap on, one tap off.",
    image: `${CF_IMG}/challenge-accepted/public`,
    alt: "Man grinning at his phone after a workout",
    // The man stands at the left of a wide photo
    position: "object-left",
    platforms: true,
  },
  {
    overline: "Option two",
    title: "Fill the gaps.",
    text: "Blood pressure. Weight and body composition. How much you've had to drink. The stuff a wrist can't measure, from devices built to talk to the app.",
    image: `${CF_IMG}/bp-morning-check/public`,
    alt: "Woman taking her blood pressure at the table in the morning",
    position: "object-center",
    link: { label: "See the devices", href: "/shop" },
  },
];
---

<section class="relative bg-brand-dark border-t border-white/5 py-20 sm:py-28 overflow-hidden" data-connect>
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <!-- The setup, as a chat: each message pops in after a beat of typing, from whoever sends it -->
    <div class="max-w-2xl mx-auto mb-14 sm:mb-20">
    <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-6">Quick Question</p>
    <div class="flex flex-col gap-3" aria-label={chatText} data-connect-chat>
      {chat.map((m) => 'image' in m ? (
        <div class="hidden self-start w-[72%] sm:w-80 lg:w-96 rounded-3xl rounded-bl-md overflow-hidden border border-white/10 bg-brand-gray-900 opacity-0 translate-y-3 scale-95 origin-bottom-left transition duration-500 ease-out" data-connect-msg="us">
          <img src={m.image} alt={m.alt} class="w-full aspect-square object-cover" loading="lazy" data-connect-still />
          {m.seasonal && Object.entries(m.seasonal).map(([season, c]) => (
            <video
              class="hidden w-full aspect-square object-cover"
              poster={`${c.clip}.jpg`}
              aria-label={c.alt}
              muted
              loop
              playsinline
              preload="none"
              data-connect-clip={season}
            >
              <source src={`${c.clip}.webm`} type="video/webm" />
              <source src={`${c.clip}.mp4`} type="video/mp4" />
            </video>
          ))}
        </div>
      ) : (
        <p
          class:list={[
            "hidden max-w-[85%] sm:max-w-[28rem] rounded-3xl border opacity-0 translate-y-3 transition duration-500 ease-out",
            m.from === 'you'
              ? "self-end rounded-br-md bg-white text-brand-black border-white px-5 py-3 text-base sm:text-lg font-medium"
              : m.aside
                ? "self-start rounded-bl-md bg-white/[0.04] border-white/10 px-4 py-2 text-sm sm:text-base italic text-brand-gray-400"
                : "self-start rounded-bl-md bg-white/[0.07] backdrop-blur-xl border-white/10 px-5 py-3.5 sm:px-6 sm:py-4 font-display text-2xl sm:text-4xl font-300 uppercase leading-tight",
          ]}
          data-connect-msg={m.from}
        >
          {m.text}
        </p>
      ))}
      <!-- Typing dots, moved to wherever the next message will appear -->
      <p class="hidden px-5 py-4 rounded-3xl border" aria-hidden="true" data-connect-typing>
        <span class="flex gap-1.5">
          <span class="w-2 h-2 rounded-full bg-current animate-bounce [animation-delay:-0.3s]"></span>
          <span class="w-2 h-2 rounded-full bg-current animate-bounce [animation-delay:-0.15s]"></span>
          <span class="w-2 h-2 rounded-full bg-current animate-bounce"></span>
        </span>
      </p>
      <p class="mt-6 text-center text-brand-gray-400 leading-relaxed opacity-0 transition duration-700" data-connect-after>
        You've got two ways to play this. Pick one.
      </p>
    </div>
    </div>

    <!-- The two options. Swipeable on a phone, side by side from a tablet up. -->
    <div
      class="-mx-6 px-6 md:mx-0 md:px-0 flex md:grid md:grid-cols-2 gap-4 sm:gap-6 overflow-x-auto md:overflow-visible snap-x snap-mandatory scroll-px-6 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      data-scroll-reveal
    >
      {options.map((o) => (
        <div class="shrink-0 w-[84vw] md:w-auto snap-start flex flex-col rounded-3xl overflow-hidden border border-white/10 bg-white/[0.03]">
          <div class="relative aspect-square sm:aspect-[5/4] overflow-hidden bg-brand-gray-900">
            <img src={o.image} alt={o.alt} class={`absolute inset-0 w-full h-full object-cover ${o.position}`} loading="lazy" />
          </div>
          <div class="flex flex-col flex-1 p-6 sm:p-8">
            <p class="text-[11px] uppercase tracking-[3px] text-brand-gray-500 mb-3">{o.overline}</p>
            <p class="font-display text-3xl sm:text-4xl font-400 uppercase leading-tight mb-3">{o.title}</p>
            <p class="text-sm sm:text-base text-brand-gray-400 leading-relaxed">{o.text}</p>
            {o.platforms && (
              <HealthPlatformBadges class="mt-auto pt-6" />
            )}
            {o.link && (
              <div class="mt-auto pt-6">
                <a href={o.link.href} class="inline-flex items-center px-6 py-3 text-[13px] uppercase tracking-[1.5px] font-medium text-brand-black bg-white rounded-full hover:bg-brand-gray-200 transition-colors">
                  {o.link.label} &rarr;
                </a>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- The wink -->
    <div class="mt-12 sm:mt-16 flex items-center justify-center gap-5" data-scroll-reveal>
      <img
        src={`${CF_IMG}/ring-gold-shh-portrait/public`}
        alt="Woman wearing Ring One with a finger to her lips"
        class="w-20 h-20 sm:w-24 sm:h-24 rounded-full object-cover object-top border border-white/15"
        loading="lazy"
      />
      <p class="font-display text-2xl sm:text-4xl font-300 uppercase leading-tight">
        Or both.<br />
        <span class="font-500">We won't tell your watch.</span>
      </p>
    </div>
  </div>
</section>

<script>
  import { currentSeason } from '../lib/season';

  // In season, the coach's still gives way to that season's clip, which plays from the moment
  // its bubble lands
  const season = currentSeason();
  document.querySelectorAll<HTMLVideoElement>("[data-connect-clip]").forEach((clip) => {
    if (clip.dataset.connectClip !== season) return;
    clip.parentElement?.querySelector("[data-connect-still]")?.classList.add("hidden");
    clip.classList.remove("hidden");
    clip.preload = "auto";
  });

  // The chat plays once, when it scrolls into view. Each message waits for a beat of typing from
  // whoever sends it; an aside lands after a longer pause, for timing. Messages take no space until
  // they arrive, so the thread grows like a real one.
  document.querySelectorAll<HTMLElement>("[data-connect-chat]").forEach((chat) => {
    const messages = Array.from(chat.querySelectorAll<HTMLElement>("[data-connect-msg]"));
    const typing = chat.querySelector<HTMLElement>("[data-connect-typing]");
    const after = chat.querySelector<HTMLElement>("[data-connect-after]");
    const reveal = (el: HTMLElement) => {
      el.classList.remove("hidden");
      el.querySelectorAll<HTMLVideoElement>("video:not(.hidden)").forEach((v) => v.play().catch(() => {}));
      requestAnimationFrame(() => requestAnimationFrame(() => el.classList.remove("opacity-0", "translate-y-3", "scale-95")));
    };
    // The thread keeps its finished height from the start, so the cards below never jump as it grows
    let played = false;
    const reserve = () => {
      if (played) return;
      chat.style.minHeight = "";
      messages.forEach((m) => m.classList.remove("hidden"));
      const full = chat.offsetHeight + (typing?.offsetHeight ?? 0);
      messages.forEach((m) => m.classList.add("hidden"));
      chat.style.minHeight = `${full}px`;
    };
    reserve();
    addEventListener("resize", reserve);
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      messages.forEach(reveal);
      if (after) reveal(after);
      return;
    }
    const TYPING_MS = 700;
    const GAP_MS = 300;
    const ASIDE_PAUSE_MS = 600;   // the beat before "(for now)" lands
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    // Typing looks like the sender: our dots on the left in glass, yours on the right in white
    const typingAs = (from: string) => {
      if (!typing) return;
      const ours = from === "us";
      typing.classList.toggle("self-start", ours);
      typing.classList.toggle("rounded-bl-md", ours);
      typing.classList.toggle("bg-white/[0.07]", ours);
      typing.classList.toggle("border-white/10", ours);
      typing.classList.toggle("text-white/60", ours);
      typing.classList.toggle("self-end", !ours);
      typing.classList.toggle("rounded-br-md", !ours);
      typing.classList.toggle("bg-white", !ours);
      typing.classList.toggle("border-white", !ours);
      typing.classList.toggle("text-brand-black/50", !ours);
    };
    const play = async () => {
      played = true;
      for (const msg of messages) {
        const aside = msg.classList.contains("italic");
        if (aside) await wait(ASIDE_PAUSE_MS);
        if (typing) {
          typingAs(msg.dataset.connectMsg ?? "us");
          msg.before(typing);
          typing.classList.remove("hidden");
        }
        await wait(aside ? TYPING_MS * 0.6 : TYPING_MS);
        typing?.classList.add("hidden");
        reveal(msg);
        await wait(GAP_MS);
      }
      if (after) reveal(after);
    };
    new IntersectionObserver((entries, observer) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      observer.disconnect();
      play();
    }, { threshold: 0.2 }).observe(chat);
  });
</script>
