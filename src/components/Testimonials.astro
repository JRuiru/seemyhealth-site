---
const testimonials = [
  {
    quote: "I've been part of the early testing group for Ring One since day one. Watching it evolve from prototype to this — I'm genuinely blown away. The sleep insights alone have changed how I plan my mornings.",
    author: "Sarah M.",
    role: "Beta Tester · Hardware & App",
  },
  {
    quote: "Our family was invited to test the ecosystem during development. Seeing the app pull data from the Scale, the Ring, and Hydra One into a single dashboard — it just clicked. The team has built something truly special.",
    author: "James K.",
    role: "Beta Tester · Family Program",
  },
  {
    quote: "I participated in the clinical validation of the BP Monitor and Hema One. The accuracy rivals lab-grade equipment, and the software experience is years ahead of anything else I've recommended to patients. Blown away by what this team has achieved.",
    author: "Dr. Amina N.",
    role: "Clinical Advisor · Early Development",
  },
];
---

<section class="py-24 sm:py-32 bg-brand-dark border-t border-white/5">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <!-- Section Header -->
    <div class="mb-16" data-scroll-reveal>
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">From Our Early Testers</p>
      <h2 class="font-display text-4xl sm:text-5xl font-300 uppercase leading-[0.95]">
        Built <span class="font-500">With Them</span>
      </h2>
    </div>

    <!-- Testimonials -->
    <div class="grid lg:grid-cols-3 gap-8" data-scroll-stagger>
      {testimonials.map((t) => (
        <div class="border-t border-white/10 pt-8">
          <p class="text-lg text-brand-gray-300 leading-relaxed mb-8 italic">
            &ldquo;{t.quote}&rdquo;
          </p>
          <div>
            <div class="text-sm font-medium text-white">{t.author}</div>
            <div class="text-[12px] text-brand-gray-500 uppercase tracking-wider mt-1">{t.role}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
