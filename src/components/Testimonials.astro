---
const CF_IMG = "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg";

const testimonials = [
  {
    quote: "The accuracy rivals lab-grade equipment, and the software experience is years ahead of anything else I've recommended to patients.",
    author: "Dr. Amina N.",
    role: "Clinical Advisor",
    image: `${CF_IMG}/family-grandma/public`,
    color: "#A855F7",
  },
  {
    quote: "The sleep insights alone have changed how I plan my mornings. Watching Ring One evolve from prototype to this, I'm genuinely blown away.",
    author: "Sarah M.",
    role: "Beta Tester",
    image: `${CF_IMG}/family-daughter/public`,
    color: "#F97316",
  },
  {
    quote: "Seeing the app pull data from the Scale, the Ring, and Hydra One into a single dashboard... it just clicked. Something truly special.",
    author: "James K.",
    role: "Family Program Tester",
    image: `${CF_IMG}/family-husband/public`,
    color: "#3B82F6",
  },
];
---

<section class="py-20 sm:py-32 bg-brand-dark border-t border-white/5 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <!-- Section Header -->
    <div class="mb-10 sm:mb-16" data-scroll-reveal>
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">From Our Early Testers</p>
      <h2 class="font-display text-4xl sm:text-5xl font-300 uppercase leading-[0.95]">
        Built <span class="font-500">With Them</span>
      </h2>
    </div>

    <!-- Testimonials — horizontal scroll on mobile, 3-col grid on desktop -->
    <div class="flex gap-4 overflow-x-auto no-scrollbar -mx-6 px-6 lg:mx-0 lg:px-0 lg:grid lg:grid-cols-3 lg:gap-6 lg:overflow-visible" data-scroll-stagger>
      {testimonials.map((t, i) => (
        <div class:list={["shrink-0 w-[78vw] sm:w-[70vw] lg:w-auto rounded-2xl border border-white/5 bg-brand-black p-6 sm:p-8 flex flex-col justify-between group hover:border-white/15 transition-all relative overflow-hidden"]}>
          <div class:list={["absolute top-0 left-0 rounded-full opacity-10 pointer-events-none", i === 0 ? "w-32 h-32 blur-[80px]" : "w-24 h-24 blur-[60px]"]} style={`background: ${t.color}`}></div>
          <div class="relative">
            <span class={`font-display ${i === 0 ? 'text-6xl' : 'text-5xl'} text-white/[0.06] leading-none block mb-2`}>&ldquo;</span>
            <p class={`${i === 0 ? 'text-lg sm:text-xl text-brand-gray-200' : 'text-base text-brand-gray-300'} leading-relaxed font-light`}>
              {t.quote}
            </p>
          </div>
          <div class="relative flex items-center gap-3 mt-6 sm:mt-8">
            <div class={`${i === 0 ? 'w-10 h-10' : 'w-9 h-9'} rounded-full overflow-hidden shrink-0`} style={`border: 2px solid ${t.color}50`}>
              <img src={t.image} alt={t.author} class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div>
              <div class="text-sm font-medium text-white">{t.author}</div>
              <div class="text-[11px] text-brand-gray-500 uppercase tracking-wider">{t.role}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
