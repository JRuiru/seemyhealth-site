---
const CF_IMG = "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg";

// A reviewer with a public profile links to it from the far right of their name
type Testimonial = {
  quote: string;
  author: string;
  role: string;
  // Without a headshot, the reviewer's initial stands in
  image?: string;
  color: string;
  profile?: { network: "LinkedIn"; href: string };
};

const testimonials: Testimonial[] = [
  {
    quote: "Between theatre lists and night calls, I'm the worst at taking my own advice. Now my sleep, meals and steps sit in one place, and I actually notice when the balance slips.",
    author: "Dr Adella",
    role: "Paediatric Surgeon",
    image: `${CF_IMG}/review-adella/public`,
    color: "#A855F7",
    profile: { network: "LinkedIn", href: "https://www.linkedin.com/in/adella-wambui-8b1b6689" },
  },
  {
    quote: "I spend my days weighing up other people's risks. Now I keep an eye on my own: water, steps and sleep, without turning my life into a spreadsheet.",
    author: "Esther",
    role: "Insurance",
    image: `${CF_IMG}/review-esther/public`,
    color: "#F97316",
    profile: { network: "LinkedIn", href: "https://www.linkedin.com/in/esther-muiruri-cert-cii-ab2a573a7" },
  },
  {
    quote: "My body rarely knows which time zone it's in. Seeing my sleep across trips helps me plan proper rest, wherever I land.",
    author: "Eve",
    role: "Pilot",
    color: "#3B82F6",
    profile: { network: "LinkedIn", href: "https://www.linkedin.com/in/evelyne-frank-wanza" },
  },
];
---

<section class="py-20 sm:py-32 bg-brand-dark border-t border-white/5 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <!-- Section Header -->
    <div class="mb-10 sm:mb-16" data-scroll-reveal>
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">Don't Just Take Our Word for It</p>
      <h2 class="font-display text-4xl sm:text-5xl font-300 uppercase leading-[0.95]">
        They Got In <span class="font-500">Early</span>
      </h2>
    </div>

    <!-- Testimonials — horizontal scroll on mobile, 3-col grid on desktop -->
    <div class="flex gap-4 overflow-x-auto no-scrollbar -mx-6 px-6 lg:mx-0 lg:px-0 lg:grid lg:grid-cols-3 lg:gap-6 lg:overflow-visible" data-scroll-stagger>
      {testimonials.map((t) => (
        <div class:list={["shrink-0 w-[78vw] sm:w-[70vw] lg:w-auto rounded-2xl border border-white/5 bg-brand-black p-6 sm:p-8 flex flex-col justify-between group hover:border-white/15 transition-all relative overflow-hidden"]}>
          <div class="absolute top-0 left-0 w-24 h-24 rounded-full opacity-10 blur-[60px] pointer-events-none" style={`background: ${t.color}`}></div>
          <div class="relative">
            <span class="font-display text-5xl text-white/[0.06] leading-none block mb-2">&ldquo;</span>
            <p class="text-base sm:text-lg text-brand-gray-200 leading-relaxed font-light">
              {t.quote}
            </p>
          </div>
          <div class="relative flex items-center gap-3 mt-6 sm:mt-8">
            <div class={`w-10 h-10 rounded-full overflow-hidden shrink-0`} style={`border: 2px solid ${t.color}50`}>
              {t.image ? (
                <img src={t.image} alt={t.author} class="w-full h-full object-cover" loading="lazy" />
              ) : (
                <span class="w-full h-full flex items-center justify-center text-sm font-medium text-white" style={`background: ${t.color}33`} aria-hidden="true">
                  {t.author.replace(/^Dr /, '').charAt(0)}
                </span>
              )}
            </div>
            <div>
              <div class="text-sm font-medium text-white">{t.author}</div>
              <div class="text-[11px] text-brand-gray-500 uppercase tracking-wider">{t.role}</div>
            </div>
            {t.profile && (
              <a
                href={t.profile.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${t.author} on ${t.profile.network}`}
                class="ml-auto p-2 -m-2 text-brand-gray-500 hover:text-white transition-colors"
              >
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.8 0 0 .77 0 1.73v20.54C0 23.23.8 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" />
                </svg>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
