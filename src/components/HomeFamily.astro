---
const CF_IMG = "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg";

const familyMembers = [
  { label: "You", metric: "Sleep · 7h 42m", color: "#F97316" },
  { label: "Partner", metric: "Weight · 78.4 kg", color: "#3B82F6" },
  { label: "Mum", metric: "BP · 124/82", color: "#EF4444" },
  { label: "Son", metric: "Hydration · 1.8L", color: "#06B6D4" },
];
---

<section class="relative bg-brand-dark border-t border-white/5 overflow-hidden">

  <!-- Full-bleed family photo -->
  <div class="relative">
    <div class="aspect-[16/10] sm:aspect-[21/9] lg:aspect-[24/9] w-full relative overflow-hidden">
      <img
        src={`${CF_IMG}/app-family-sharing/public`}
        alt="Family together on the couch"
        class="w-full h-full object-cover object-top"
        loading="lazy"
      />
      <!-- Gradient overlays for text readability -->
      <div class="absolute inset-0 bg-gradient-to-t from-brand-dark via-brand-dark/50 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-brand-dark/60 to-transparent"></div>
    </div>

    <!-- Text overlay on the image -->
    <div class="absolute inset-0 flex items-end">
      <div class="max-w-7xl mx-auto px-6 lg:px-8 w-full pb-10 sm:pb-16" data-scroll-reveal>
        <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-400 mb-3 sm:mb-4">Family Wellness</p>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-6xl font-300 uppercase leading-[0.95] mb-2 sm:mb-3">
          Health is personal.<br />
          <span class="font-500">Care is shared.</span>
        </h2>
        <p class="text-brand-gray-400 text-sm sm:text-base max-w-md">
          One dashboard for everyone you love. Each person controls their own privacy.
        </p>
      </div>
    </div>
  </div>

  <!-- Floating metric cards — the family's live data -->
  <div class="max-w-7xl mx-auto px-6 lg:px-8 -mt-6 sm:-mt-10 relative z-10 pb-16 sm:pb-24">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4" data-scroll-stagger>
      {familyMembers.map((m) => (
        <div class="group rounded-lg sm:rounded-xl bg-brand-black/80 backdrop-blur-sm border border-white/10 hover:border-white/20 px-3 py-2 sm:p-5 transition-all overflow-hidden h-full">
          <div class="flex items-center gap-1.5 sm:gap-3 sm:mb-3">
            <div class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full shrink-0 animate-pulse" style={`background: ${m.color}`}></div>
            <span class="text-[11px] sm:text-sm font-medium text-white shrink-0">{m.label}</span>
            <span class="text-[9px] uppercase tracking-wider text-brand-gray-500 sm:hidden truncate min-w-0">{m.metric}</span>
          </div>
          <p class="text-[11px] sm:text-xs uppercase tracking-[1.5px] text-brand-gray-400 hidden sm:block truncate">{m.metric}</p>
        </div>
      ))}
    </div>

    <!-- Feature strip — horizontally scrollable on mobile, centered on desktop -->
    <div class="flex gap-2 sm:gap-3 mt-6 sm:mt-10 overflow-x-auto snap-x snap-mandatory no-scrollbar -mx-6 px-6 lg:mx-0 lg:px-0 lg:flex-wrap lg:justify-center" data-scroll-reveal>
      {[
        { label: "Monitor remotely", icon: "M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" },
        { label: "Privacy per person", icon: "M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" },
        { label: "Share with doctors", icon: "M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" },
        { label: "One device, whole family", icon: "M18 18.72a9.094 9.094 0 003.741-5.728M12 2.25c-4.97 0-9 4.03-9 9s4.03 9 9 9m0-18a8.96 8.96 0 015.672 2.018M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0" },
      ].map((f) => (
        <div class="snap-start shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 sm:px-4 sm:py-2 rounded-full border border-white/5 bg-white/[0.02] hover:border-white/15 transition-colors">
          <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-brand-gray-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d={f.icon} />
          </svg>
          <span class="text-[9px] sm:text-[11px] uppercase tracking-wider text-brand-gray-400 whitespace-nowrap">{f.label}</span>
        </div>
      ))}
    </div>
  </div>

</section>
