---
const CF_IMG = "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg";

const features = [
  {
    title: "Monitor loved ones",
    description: "Check in on a parent's blood pressure or a child's hydration, right from your own dashboard.",
  },
  {
    title: "Control what's shared",
    description: "Each person decides exactly which metrics are visible and to whom. Full privacy controls.",
  },
  {
    title: "Coordinate care together",
    description: "Flag a reading, share with a doctor, or loop in a partner. All from one place.",
  },
  {
    title: "One device, whole family",
    description: "Shared devices mean everyone can step on the scale or check blood pressure. Data routes to their own profile.",
  },
];
---

<section class="py-20 sm:py-28 bg-brand-dark border-t border-white/5">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-2 lg:gap-16 xl:gap-24 items-center">

      <!-- Left: Text -->
      <div>
        <div class="mb-10" data-scroll-reveal>
          <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">Family Wellness</p>
          <h2 class="font-display text-4xl sm:text-5xl font-300 uppercase leading-[0.95] mb-4">
            Health is personal. <span class="font-500">Care is shared.</span>
          </h2>
          <p class="text-brand-gray-400 leading-relaxed max-w-lg">
            SeeMyHealth isn't just for you. Share dashboards with family, monitor parents remotely, and keep everyone's health in view, without giving up anyone's privacy.
          </p>
        </div>

        <div class="space-y-5" data-scroll-stagger>
          {features.map((f) => (
            <div class="flex gap-4">
              <div class="w-1.5 h-1.5 rounded-full bg-white/30 mt-2 shrink-0"></div>
              <div>
                <p class="text-sm font-medium text-white mb-0.5">{f.title}</p>
                <p class="text-[13px] text-brand-gray-500 leading-relaxed">{f.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Family ecosystem visual -->
      <div class="relative mt-12 lg:mt-0" data-scroll-reveal>
        <div class="relative max-w-[400px] mx-auto">
          <!-- Central "You" — daughter -->
          <div class="flex justify-center mb-8">
            <div class="relative text-center">
              <div class="w-24 h-24 rounded-full overflow-hidden border-2 border-white/20 mx-auto shadow-lg shadow-black/30">
                <img src={`${CF_IMG}/family-daughter/public`} alt="You" class="w-full h-full object-cover" loading="lazy" />
              </div>
              <p class="text-[11px] uppercase tracking-[2px] text-white mt-3 font-medium">You</p>
              <!-- Pulse ring -->
              <div class="absolute -inset-2 top-0 w-[calc(100%+16px)] h-[calc(6rem+16px)] rounded-full border border-white/5 animate-pulse"></div>
            </div>
          </div>

          <!-- Connecting lines -->
          <div class="flex justify-center mb-4">
            <div class="flex items-end gap-0">
              <div class="w-[100px] h-px bg-gradient-to-r from-transparent to-white/10"></div>
              <div class="w-px h-10 bg-white/10"></div>
              <div class="w-[100px] h-px bg-gradient-to-l from-transparent to-white/10"></div>
            </div>
          </div>

          <!-- Family members -->
          <div class="grid grid-cols-3 gap-6">
            <!-- Husband -->
            <div class="text-center">
              <div class="w-[64px] h-[64px] rounded-full overflow-hidden border-2 border-white/10 mx-auto shadow-lg shadow-black/20">
                <img src={`${CF_IMG}/family-husband/public`} alt="Husband" class="w-full h-full object-cover" loading="lazy" />
              </div>
              <p class="text-[10px] uppercase tracking-[2px] text-brand-gray-400 mt-3">Partner</p>
              <div class="mt-2 space-y-1">
                <div class="h-1.5 rounded-full bg-orange-500/20 w-3/4 mx-auto"></div>
                <div class="h-1.5 rounded-full bg-blue-500/20 w-1/2 mx-auto"></div>
              </div>
            </div>

            <!-- Grandma -->
            <div class="text-center">
              <div class="w-[64px] h-[64px] rounded-full overflow-hidden border-2 border-white/10 mx-auto shadow-lg shadow-black/20">
                <img src={`${CF_IMG}/family-grandma/public`} alt="Mum" class="w-full h-full object-cover" loading="lazy" />
              </div>
              <p class="text-[10px] uppercase tracking-[2px] text-brand-gray-400 mt-3">Parent</p>
              <div class="mt-2 space-y-1">
                <div class="h-1.5 rounded-full bg-red-500/20 w-3/4 mx-auto"></div>
                <div class="h-1.5 rounded-full bg-purple-500/20 w-1/2 mx-auto"></div>
              </div>
            </div>

            <!-- Child -->
            <div class="text-center">
              <div class="w-[64px] h-[64px] rounded-full overflow-hidden border-2 border-white/10 mx-auto shadow-lg shadow-black/20">
                <img src={`${CF_IMG}/family-child/public`} alt="Child" class="w-full h-full object-cover" loading="lazy" />
              </div>
              <p class="text-[10px] uppercase tracking-[2px] text-brand-gray-400 mt-3">Child</p>
              <div class="mt-2 space-y-1">
                <div class="h-1.5 rounded-full bg-cyan-500/20 w-3/4 mx-auto"></div>
                <div class="h-1.5 rounded-full bg-green-500/20 w-1/2 mx-auto"></div>
              </div>
            </div>
          </div>

          <!-- Shared device indicator -->
          <div class="mt-8 rounded-xl border border-white/5 bg-white/[0.02] p-4 text-center">
            <p class="text-[10px] uppercase tracking-[2px] text-brand-gray-600 mb-2">Shared devices</p>
            <div class="flex justify-center gap-6">
              <div class="text-center">
                <div class="w-2 h-2 rounded-full bg-blue-500 mx-auto mb-1"></div>
                <p class="text-[9px] text-brand-gray-600">Scale</p>
              </div>
              <div class="text-center">
                <div class="w-2 h-2 rounded-full bg-red-500 mx-auto mb-1"></div>
                <p class="text-[9px] text-brand-gray-600">BP</p>
              </div>
              <div class="text-center">
                <div class="w-2 h-2 rounded-full bg-purple-500 mx-auto mb-1"></div>
                <p class="text-[9px] text-brand-gray-600">Hema</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
