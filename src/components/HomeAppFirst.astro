---
const CF_IMG = "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg";

const appFeatures = [
  { title: "Journal & Mood", image: `${CF_IMG}/app-mood-journal/public`, alt: "Woman journalling her mood" },
  { title: "Meals & Nutrition", image: `${CF_IMG}/app-meal-logging/public`, alt: "Person logging a meal" },
  { title: "Hydration", image: `${CF_IMG}/app-hydration-log/public`, alt: "Hydration logging screen" },
  { title: "Challenges", image: `${CF_IMG}/app-community-challenges/public`, alt: "Community challenges screen" },
  { title: "Family Sharing", image: `${CF_IMG}/app-hubby-progress/public`, alt: "Checking on hubby's weight loss progress" },
  { title: "Care Providers", image: `${CF_IMG}/app-video-consultation/public`, alt: "Video consultation screen" },
];
---

<section class="py-16 sm:py-28 bg-brand-dark border-t border-white/5 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <!-- Header -->
    <div class="mb-8 sm:mb-12" data-scroll-reveal>
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-3 sm:mb-4">No Device Required</p>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-6xl font-300 uppercase leading-[0.95] mb-3 sm:mb-4">
        The app works <span class="font-500">from day one.</span>
      </h2>
      <p class="text-sm sm:text-base text-brand-gray-400 leading-relaxed max-w-lg">
        Journalling, mood, meals, and challenges. No device needed.
      </p>
    </div>
  </div>

  <!-- Horizontally scrollable app screenshot cards -->
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex gap-4 sm:gap-5 overflow-x-auto scroll-smooth pb-6 -mx-6 px-6 lg:-mx-8 lg:px-8 no-scrollbar" data-scroll-stagger>
      {appFeatures.map((f) => (
        <div class="group relative shrink-0 w-[200px] sm:w-[260px] lg:w-[280px] rounded-2xl overflow-hidden">
          <!-- App screenshot -->
          <div class="aspect-[9/16] sm:aspect-[9/15] bg-brand-gray-900 relative overflow-hidden">
            <img
              src={f.image}
              alt={f.alt}
              class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
          </div>

          <!-- Feature label pill -->
          <div class="absolute top-3 left-3 z-10">
            <span class="inline-flex items-center px-3 py-1.5 rounded-full bg-white/10 backdrop-blur-md text-[10px] sm:text-[11px] text-white uppercase tracking-wider font-medium">
              {f.title}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- CTA + device teaser -->
  <div class="max-w-7xl mx-auto px-6 lg:px-8 mt-8 sm:mt-12" data-scroll-reveal>
    <a href="/app" class="inline-flex items-center gap-2 text-[12px] uppercase tracking-[1.5px] font-medium text-white hover:text-brand-gray-300 transition-colors mb-8 sm:mb-12">
      Explore the app
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>

    <div class="border-t border-white/5 pt-8 sm:pt-12 flex items-start gap-4">
      <div class="relative w-10 h-10 rounded-full border border-white/10 bg-white/[0.03] flex items-center justify-center shrink-0 mt-0.5 ecosystem-pulse">
        <!-- Pulse rings -->
        <div class="absolute inset-0 rounded-full border border-white/10 ecosystem-ring ecosystem-ring-1"></div>
        <div class="absolute -inset-2 rounded-full border border-white/5 ecosystem-ring ecosystem-ring-2"></div>
        <!-- Stacked layers icon -->
        <svg class="w-5 h-5 text-brand-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2L2 7l10 5 10-5-10-5z" />
          <path d="M2 17l10 5 10-5" />
          <path d="M2 12l10 5 10-5" />
        </svg>
      </div>
      <div>
        <p class="text-sm sm:text-base text-brand-gray-300 leading-relaxed max-w-lg">
          The app is powerful on its own. But the experience is taken to another level when paired with our ecosystem of devices. Sleep stages, heart rate, blood pressure, body composition, hydration, blood markers, all flowing into one place.
        </p>
        <a href="/shop" class="inline-flex items-center gap-2 text-[12px] uppercase tracking-[1.5px] font-medium text-white hover:text-brand-gray-300 transition-colors mt-3">
          Meet the ecosystem
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .ecosystem-ring {
    animation: ecosystem-expand 2.5s ease-out infinite;
    opacity: 0;
  }
  .ecosystem-ring-2 {
    animation-delay: 0.8s;
  }

  @keyframes ecosystem-expand {
    0% { transform: scale(0.8); opacity: 0.5; }
    100% { transform: scale(1.8); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ecosystem-ring { animation: none; }
  }
</style>
