---
const CF_IMG = "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg";

const features = [
  {
    title: "Journal & mood",
    description: "Daily check-ins, prompts, and streaks",
    icon: "M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z",
  },
  {
    title: "Meals, nutrition & fasting",
    description: "Log meals, build nutrition plans, set fasting schedules",
    icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
  },
  {
    title: "Hydration tracking",
    description: "Log water, set goals, get reminders",
    icon: "M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zM12.75 9a.75.75 0 00-1.5 0v2.25H9a.75.75 0 000 1.5h2.25V15a.75.75 0 001.5 0v-2.25H15a.75.75 0 000-1.5h-2.25V9z",
  },
  {
    title: "Care providers",
    description: "Video consults without leaving the app",
    icon: "M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z",
  },
  {
    title: "Family sharing",
    description: "Share dashboards with role-based privacy",
    icon: "M18 18.72a9.094 9.094 0 003.741-5.728M12 2.25c-4.97 0-9 4.03-9 9s4.03 9 9 9m0-18a8.96 8.96 0 015.672 2.018M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0",
  },
  {
    title: "Challenges",
    description: "Sleep, steps, nutrition. Compete and stay accountable.",
    icon: "M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z",
  },
];
---

<section class="py-12 sm:py-28 bg-brand-dark border-t border-white/5" data-app-first-section>
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-2 lg:gap-16 xl:gap-24 items-center">

      <!-- Left: Text + feature grid -->
      <div>
        <div class="mb-4 lg:mb-10" data-scroll-reveal data-app-header>
          <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-3 lg:mb-4">No Device Required</p>
          <h2 class="font-display text-3xl sm:text-5xl font-300 uppercase leading-[0.95] mb-3 lg:mb-4">
            The app works <span class="font-500">from day one.</span>
          </h2>
          <div class="relative min-h-[3.5rem] lg:min-h-[4.5rem]">
            {[
              "Track your mood daily, journal your thoughts, and build streaks. Understand how you feel over time, no wearable needed.",
              "Log meals, track calories and macros, plan your nutrition, and set fasting schedules. Everything in one place.",
              "View a family member's body composition, weight trends, and health scores, right from your own dashboard.",
            ].map((text, i) => (
              <p
                class:list={[
                  "text-sm lg:text-base text-brand-gray-400 leading-relaxed max-w-lg absolute inset-0 transition-opacity duration-500",
                  i === 0 ? "opacity-100" : "opacity-0"
                ]}
                data-app-desc={i}
              >{text}</p>
            ))}
          </div>
        </div>

        <!-- Collapsible on mobile: feature grid + CTA -->
        <div data-app-collapsible class="overflow-hidden">
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-8" data-scroll-stagger>
            {features.map((f) => (
              <div class="group rounded-xl bg-white/[0.03] border border-white/5 hover:border-white/15 p-4 transition-all">
                <svg class="w-5 h-5 text-brand-gray-600 group-hover:text-white mb-2 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={f.icon} />
                </svg>
                <p class="text-sm font-medium text-white mb-0.5">{f.title}</p>
                <p class="text-[11px] text-brand-gray-600 leading-snug">{f.description}</p>
              </div>
            ))}
          </div>

          <a href="/app" class="inline-flex items-center gap-2 text-[12px] uppercase tracking-[1.5px] font-medium text-white hover:text-brand-gray-300 transition-colors" data-scroll-reveal>
            Explore the app
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right: Rotating app screenshots -->
      <div class="relative mt-4 lg:mt-0" data-scroll-reveal data-app-phone>
        <div class="relative mx-auto max-w-[360px] lg:max-w-none overflow-hidden rounded-[2rem]" data-app-carousel style="mask-image: radial-gradient(ellipse 85% 88% at center, black 45%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse 85% 88% at center, black 45%, transparent 100%);">
          {[
            { src: `${CF_IMG}/app-mood-tracking/public`, alt: "Mood tracking & journalling", label: "Journal & Mood" },
            { src: `${CF_IMG}/app-nutrition-view/public`, alt: "Meal logging & nutrition tracking", label: "Meals & Nutrition" },
            { src: `${CF_IMG}/app-family-weight-view/public`, alt: "Family body composition sharing", label: "Family Sharing" },
          ].map((screen, i) => (
            <img
              src={screen.src}
              alt={screen.alt}
              class:list={[
                "absolute inset-0 w-full h-full object-contain transition-opacity duration-700",
                i === 0 ? "opacity-100" : "opacity-0",
                i !== 0 && "pointer-events-none"
              ]}
              data-app-slide={i}
              data-app-label={screen.label}
              loading="lazy"
            />
          ))}
          <!-- Spacer for aspect ratio -->
          <img
            src={`${CF_IMG}/app-mood-tracking/public`}
            alt=""
            class="w-full invisible"
            aria-hidden="true"
            loading="lazy"
          />
        </div>

        <!-- Label + dots (hidden on mobile, visible on desktop) -->
        <div class="hidden lg:block text-center mt-2">
          <p class="text-[10px] uppercase tracking-[2px] text-brand-gray-600 mb-3 transition-opacity duration-300" data-app-label-text>Journal & Mood</p>
          <div class="flex justify-center gap-2">
            {[0, 1, 2].map((i) => (
              <button
                class:list={[
                  "w-2 h-2 rounded-full transition-all duration-300",
                  i === 0 ? "bg-white/60 w-6" : "bg-white/20"
                ]}
                data-app-dot={i}
                aria-label={`View slide ${i + 1}`}
              ></button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initAppCarousel() {
    const carousel = document.querySelector('[data-app-carousel]');
    if (!carousel) return;

    const slides = carousel.querySelectorAll<HTMLImageElement>('[data-app-slide]');
    const dots = document.querySelectorAll<HTMLButtonElement>('[data-app-dot]');
    const descs = document.querySelectorAll<HTMLParagraphElement>('[data-app-desc]');
    const label = document.querySelector('[data-app-label-text]');
    if (!slides.length) return;

    let current = 0;
    let interval: ReturnType<typeof setInterval>;

    function goTo(index: number) {
      slides.forEach((s, i) => {
        s.classList.toggle('opacity-100', i === index);
        s.classList.toggle('opacity-0', i !== index);
      });
      dots.forEach((d, i) => {
        d.classList.toggle('bg-white/60', i === index);
        d.classList.toggle('w-6', i === index);
        d.classList.toggle('bg-white/20', i !== index);
        d.classList.toggle('w-2', i !== index);
      });
      descs.forEach((d, i) => {
        d.classList.toggle('opacity-100', i === index);
        d.classList.toggle('opacity-0', i !== index);
      });
      if (label) {
        label.textContent = slides[index].getAttribute('data-app-label') || '';
      }
      current = index;
    }

    function next() {
      goTo((current + 1) % slides.length);
    }

    // Auto-rotate every 4 seconds
    interval = setInterval(next, 4000);

    // Click dots to navigate
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        clearInterval(interval);
        goTo(i);
        interval = setInterval(next, 4000);
      });
    });
  }

  document.addEventListener('astro:page-load', initAppCarousel);
  initAppCarousel();
</script>
