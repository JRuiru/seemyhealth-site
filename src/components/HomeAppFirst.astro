---
const CF_IMG = "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg";

const appFeatures = [
  { title: "Journal & Mood", image: `${CF_IMG}/app-mood-tracking/public`, alt: "Mood tracking screen" },
  { title: "Meals & Nutrition", image: `${CF_IMG}/app-nutrition-view/public`, alt: "Nutrition tracking screen" },
  { title: "Hydration", image: `${CF_IMG}/app-hydration-log/public`, alt: "Hydration logging screen" },
  { title: "Challenges", image: `${CF_IMG}/app-community-challenges/public`, alt: "Community challenges screen" },
  { title: "Family Sharing", image: `${CF_IMG}/app-family-weight-view/public`, alt: "Family sharing dashboard" },
  { title: "Care Providers", image: `${CF_IMG}/app-video-consultation/public`, alt: "Video consultation screen" },
];
---

<section class="py-16 sm:py-28 bg-brand-dark border-t border-white/5 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <!-- Header -->
    <div class="mb-8 sm:mb-12" data-scroll-reveal>
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-3 sm:mb-4">No Device Required</p>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-6xl font-300 uppercase leading-[0.95] mb-3 sm:mb-4">
        The app works <span class="font-500">from day one.</span>
      </h2>
      <p class="text-sm sm:text-base text-brand-gray-400 leading-relaxed max-w-lg">
        Journalling, mood, meals, and challenges. No device needed.
      </p>
    </div>
  </div>

  <!-- Horizontally scrollable app screenshot cards -->
  <div class="max-w-7xl mx-auto pl-6 lg:pl-8">
    <div class="flex gap-4 sm:gap-5 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-6 pr-6 lg:pr-8 no-scrollbar" data-scroll-stagger>
      {appFeatures.map((f) => (
        <div class="group relative shrink-0 w-[200px] sm:w-[260px] lg:w-[280px] snap-start rounded-2xl overflow-hidden">
          <!-- App screenshot -->
          <div class="aspect-[9/16] sm:aspect-[9/15] bg-brand-gray-900 relative overflow-hidden">
            <img
              src={f.image}
              alt={f.alt}
              class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
          </div>

          <!-- Feature label pill -->
          <div class="absolute top-3 left-3 z-10">
            <span class="inline-flex items-center px-3 py-1.5 rounded-full bg-white/10 backdrop-blur-md text-[10px] sm:text-[11px] text-white uppercase tracking-wider font-medium">
              {f.title}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- CTA -->
  <div class="max-w-7xl mx-auto px-6 lg:px-8 mt-6 sm:mt-8" data-scroll-reveal>
    <a href="/app" class="inline-flex items-center gap-2 text-[12px] uppercase tracking-[1.5px] font-medium text-white hover:text-brand-gray-300 transition-colors">
      Explore the app
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  </div>
</section>
