---
const CF_IMG = "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg";

const features = [
  {
    title: "Journal & mood",
    description: "Daily check-ins, prompts, and streaks",
    icon: "M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z",
  },
  {
    title: "Meals, nutrition & fasting",
    description: "Log meals, build nutrition plans, set fasting schedules",
    icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
  },
  {
    title: "Hydration tracking",
    description: "Log water, set goals, get reminders",
    icon: "M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zM12.75 9a.75.75 0 00-1.5 0v2.25H9a.75.75 0 000 1.5h2.25V15a.75.75 0 001.5 0v-2.25H15a.75.75 0 000-1.5h-2.25V9z",
  },
  {
    title: "Care providers",
    description: "Video consults without leaving the app",
    icon: "M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z",
  },
  {
    title: "Family sharing",
    description: "Share dashboards with role-based privacy",
    icon: "M18 18.72a9.094 9.094 0 003.741-5.728M12 2.25c-4.97 0-9 4.03-9 9s4.03 9 9 9m0-18a8.96 8.96 0 015.672 2.018M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0",
  },
  {
    title: "Challenges",
    description: "Sleep, steps, nutrition — compete and stay accountable",
    icon: "M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z",
  },
];
---

<section class="py-20 sm:py-28 bg-brand-dark border-t border-white/5">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-2 lg:gap-16 xl:gap-24 items-center">

      <!-- Left: Text + feature grid -->
      <div>
        <div class="mb-10" data-scroll-reveal>
          <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">No Device Required</p>
          <h2 class="font-display text-4xl sm:text-5xl font-300 uppercase leading-[0.95] mb-4">
            The app works <span class="font-500">from day one.</span>
          </h2>
          <p class="text-brand-gray-400 leading-relaxed max-w-lg">
            Most health apps need hardware to be useful. Ours doesn't. Your first month is free — journalling, mood tracking, meal logging, care provider access, and community challenges all work before you buy a single device.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-8" data-scroll-stagger>
          {features.map((f) => (
            <div class="group rounded-xl bg-white/[0.03] border border-white/5 hover:border-white/15 p-4 transition-all">
              <svg class="w-5 h-5 text-brand-gray-600 group-hover:text-white mb-2 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={f.icon} />
              </svg>
              <p class="text-sm font-medium text-white mb-0.5">{f.title}</p>
              <p class="text-[11px] text-brand-gray-600 leading-snug">{f.description}</p>
            </div>
          ))}
        </div>

        <a href="/app" class="inline-flex items-center gap-2 text-[12px] uppercase tracking-[1.5px] font-medium text-white hover:text-brand-gray-300 transition-colors" data-scroll-reveal>
          Explore the app
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Right: Phone mockup -->
      <div class="relative mt-12 lg:mt-0" data-scroll-reveal>
        <div class="relative mx-auto w-[260px] sm:w-[300px]">
          <div class="rounded-[2.5rem] border-2 border-white/10 bg-brand-gray-900 p-3 shadow-2xl shadow-black/50">
            <div class="rounded-[2rem] bg-brand-black overflow-hidden">
              <div class="px-5 pt-5 pb-6 space-y-3">
                <div>
                  <p class="text-[9px] uppercase tracking-[2px] text-brand-gray-600 mb-1">Good Morning</p>
                  <p class="text-base font-display font-400">Your Day</p>
                </div>

                <!-- Mood -->
                <div class="rounded-lg bg-brand-gray-900 p-3">
                  <p class="text-[8px] uppercase tracking-wider text-brand-gray-600 mb-1.5">How are you feeling?</p>
                  <div class="flex gap-2">
                    {["😴", "😐", "🙂", "😊", "🤩"].map((e, i) => (
                      <div class:list={["w-7 h-7 rounded-full flex items-center justify-center text-[12px]", i === 3 ? "bg-white/10 ring-1 ring-white/20" : "bg-brand-gray-800"]}>
                        {e}
                      </div>
                    ))}
                  </div>
                </div>

                <!-- Meals -->
                <div class="rounded-lg bg-brand-gray-900 p-3">
                  <p class="text-[8px] uppercase tracking-wider text-brand-gray-600 mb-1.5">Today's Meals</p>
                  <div class="space-y-1">
                    <div class="flex justify-between"><span class="text-[9px] text-brand-gray-400">Breakfast</span><span class="text-[9px] text-brand-gray-600">420 cal</span></div>
                    <div class="flex justify-between"><span class="text-[9px] text-brand-gray-400">Lunch</span><span class="text-[9px] text-brand-gray-600">580 cal</span></div>
                    <div class="flex justify-between"><span class="text-[9px] text-brand-gray-400">+ Add meal</span><span class="text-[9px] text-brand-gray-600"></span></div>
                  </div>
                </div>

                <!-- Hydration -->
                <div class="rounded-lg bg-brand-gray-900 p-3">
                  <div class="flex items-center justify-between mb-1.5">
                    <p class="text-[8px] uppercase tracking-wider text-brand-gray-600">Hydration</p>
                    <p class="text-[8px] text-cyan-400">1.2 / 2.5L</p>
                  </div>
                  <div class="h-1.5 rounded-full bg-white/5 overflow-hidden">
                    <div class="h-full rounded-full bg-cyan-500/40" style="width: 48%"></div>
                  </div>
                </div>

                <!-- Fasting -->
                <div class="rounded-lg bg-brand-gray-900 p-3">
                  <div class="flex items-center justify-between">
                    <div>
                      <p class="text-[8px] uppercase tracking-wider text-brand-gray-600">Fasting · 16:8</p>
                      <p class="text-[9px] text-brand-gray-400">4h 12m remaining</p>
                    </div>
                    <div class="w-8 h-8 rounded-full border border-green-500/30 flex items-center justify-center">
                      <span class="text-[8px] text-green-400">ON</span>
                    </div>
                  </div>
                </div>

                <!-- Challenge -->
                <div class="rounded-lg bg-brand-gray-900 p-3">
                  <div class="flex items-center gap-2">
                    <div class="w-6 h-6 rounded-full bg-orange-500/20 flex items-center justify-center">
                      <span class="text-[9px]">🏆</span>
                    </div>
                    <div>
                      <p class="text-[9px] text-white">7-Day Sleep Challenge</p>
                      <p class="text-[8px] text-brand-gray-600">Day 3 of 7 · 2nd place</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- Glow -->
          <div class="absolute -inset-10 bg-gradient-to-b from-white/[0.02] to-transparent rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- Label -->
        <p class="text-center text-[10px] uppercase tracking-[2px] text-brand-gray-600 mt-4">No devices connected</p>
      </div>
    </div>
  </div>
</section>
