---
interface Benefit {
  title: string;
  description: string;
}

interface Props {
  headline: string;
  color: string;
  benefits: Benefit[];
  backgroundImage?: string;
}

const { headline, color, benefits, backgroundImage } = Astro.props;
---

<section class="relative py-20 sm:py-28 border-t border-white/5 overflow-hidden">
  {/* Background image layer */}
  {backgroundImage ? (
    <>
      <div class="absolute inset-0">
        <img
          src={backgroundImage}
          alt=""
          class="w-full h-full object-cover"
          loading="lazy"
          aria-hidden="true"
        />
      </div>
      {/* Dark overlay for readability */}
      <div class="absolute inset-0 bg-brand-black/75"></div>
      {/* Gradient edges */}
      <div class="absolute inset-0 bg-gradient-to-b from-brand-black via-transparent to-brand-black"></div>
    </>
  ) : (
    <div class="absolute inset-0 bg-brand-dark"></div>
  )}

  <div class="relative max-w-6xl mx-auto px-6 lg:px-8">
    <div class="mb-14" data-scroll-reveal>
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">What It Does for You</p>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-300 uppercase leading-[0.95] max-w-xl">
        {headline}
      </h2>
    </div>

    <div class="grid sm:grid-cols-2 gap-6" data-scroll-stagger>
      {benefits.map((b) => (
        <div
          class:list={[
            "p-8 rounded-2xl border border-white/5",
            backgroundImage ? "bg-brand-black/60 backdrop-blur-md" : "bg-brand-gray-900",
          ]}
        >
          <div class="w-2 h-2 rounded-full mb-4" style={`background: ${color}`}></div>
          <h3 class="font-display text-lg font-400 uppercase mb-3">{b.title}</h3>
          <p class="text-sm text-brand-gray-500 leading-relaxed">{b.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
