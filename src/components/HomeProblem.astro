---
const fragments = [
  { name: "Sleep app", color: "#6366F1" },
  { name: "Fitness tracker", color: "#F97316" },
  { name: "BP readings", color: "#EF4444" },
  { name: "Lab PDFs", color: "#A855F7" },
  { name: "Nutrition app", color: "#22C55E" },
  { name: "Doctor portal", color: "#06B6D4" },
];
---

<section class="py-20 sm:py-28 bg-brand-dark border-t border-white/5 overflow-hidden">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">

    <!-- The problem -->
    <div class="text-center mb-16" data-scroll-reveal>
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">The Problem</p>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-300 uppercase leading-[0.95] mb-6">
        Your health data is <span class="font-500">everywhere.</span>
      </h2>
      <p class="text-brand-gray-400 max-w-xl mx-auto">
        Sleep in one app. Blood pressure in another. Lab results in a PDF. Nutrition somewhere else. Nothing talks to anything, so you're left connecting the dots yourself.
      </p>
    </div>

    <!-- Fragmented grid -->
    <div class="grid grid-cols-3 sm:grid-cols-6 gap-3 mb-16" data-scroll-stagger>
      {fragments.map((f) => (
        <div class="rounded-xl border border-dashed border-white/10 bg-white/[0.02] p-4 text-center">
          <div class="w-3 h-3 rounded-full mx-auto mb-2 opacity-40" style={`background: ${f.color}`}></div>
          <p class="text-[10px] text-brand-gray-600 uppercase tracking-wider">{f.name}</p>
        </div>
      ))}
    </div>

    <!-- The merge -->
    <div class="flex justify-center mb-16" data-scroll-reveal>
      <div class="flex flex-col items-center">
        <div class="w-px h-12 bg-gradient-to-b from-white/10 to-white/30"></div>
        <svg class="w-5 h-5 text-brand-gray-500 my-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>
    </div>

    <!-- The solution -->
    <div class="text-center" data-scroll-reveal>
      <div class="inline-flex items-center gap-3 px-6 py-3 rounded-full border border-white/10 bg-white/[0.03] mb-8">
        <div class="flex -space-x-1.5">
          {fragments.map((f) => (
            <div class="w-3 h-3 rounded-full border border-brand-black" style={`background: ${f.color}`}></div>
          ))}
        </div>
        <span class="text-[11px] uppercase tracking-[2px] text-brand-gray-400">One platform</span>
      </div>
      <h3 class="font-display text-3xl sm:text-4xl lg:text-5xl font-300 uppercase leading-[0.95] mb-4">
        SeeMyHealth connects <span class="font-500">everything.</span>
      </h3>
      <p class="text-brand-gray-400 max-w-lg mx-auto">
        Devices, meals, mood, providers, family. One app, one dashboard, one picture of your health that actually makes sense.
      </p>
    </div>
  </div>
</section>
