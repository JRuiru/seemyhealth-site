---
const CF_IMG = "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg";

const fragments = [
  { name: "Sleep app", color: "#6366F1", icon: "M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" },
  { name: "Fitness tracker", color: "#F97316", icon: "M13 10V3L4 14h7v7l9-11h-7z" },
  { name: "BP readings", color: "#EF4444", icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" },
  { name: "Lab PDFs", color: "#A855F7", icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" },
  { name: "Nutrition app", color: "#22C55E", icon: "M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" },
  { name: "Doctor portal", color: "#06B6D4", icon: "M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" },
];

const unifiedDevices = [
  { name: "Ring One", image: `${CF_IMG}/ring-hand-closeup-black/public`, color: "#F97316" },
  { name: "The Scale", image: `${CF_IMG}/scale-bathroom-stepon-v3/public`, color: "#3B82F6" },
  { name: "BP Monitor", image: `${CF_IMG}/bp-morning-check/public`, color: "#EF4444" },
  { name: "Hydra One", image: `${CF_IMG}/bottle-white-cafe-v2/public`, color: "#06B6D4" },
];
---

<section class="py-20 sm:py-32 bg-brand-dark border-t border-white/5 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <!-- BEFORE: The fragmented world -->
    <div class="text-center mb-6 sm:mb-8" data-scroll-reveal>
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">The Problem</p>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-300 uppercase leading-[0.95]">
        Your health data is <span class="font-500">everywhere.</span>
      </h2>
    </div>

    <!-- Scattered app cards — tilted, chaotic, drifting -->
    <div class="relative max-w-3xl mx-auto mb-20 sm:mb-28" data-scroll-stagger data-chaos-zone>
      <div class="relative h-[220px] sm:h-[280px]">
        {fragments.map((f, i) => {
          const positions = [
            "left-[2%] top-[15%] -rotate-6",
            "left-[18%] top-[55%] rotate-3",
            "left-[38%] top-[5%] rotate-2",
            "left-[55%] top-[50%] -rotate-4",
            "right-[18%] top-[10%] rotate-5",
            "right-[2%] top-[45%] -rotate-2",
          ];
          return (
            <div class={`absolute ${positions[i]} w-[120px] sm:w-[150px] rounded-xl border border-dashed border-white/10 bg-white/[0.02] backdrop-blur-sm p-3 sm:p-4 opacity-60 hover:opacity-90 fragment-card`}>
              <svg class="w-5 h-5 mb-2 opacity-50" fill="none" viewBox="0 0 24 24" stroke={f.color} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d={f.icon} />
              </svg>
              <p class="text-[10px] sm:text-[11px] text-brand-gray-500 font-medium">{f.name}</p>
              <div class="mt-2 space-y-1">
                <div class="h-1 rounded-full bg-white/5 w-full"></div>
                <div class="h-1 rounded-full bg-white/5 w-2/3"></div>
              </div>
            </div>
          );
        })}
        <!-- Disconnected lines between cards -->
        <svg class="absolute inset-0 w-full h-full pointer-events-none" aria-hidden="true">
          <line x1="22%" y1="35%" x2="40%" y2="25%" stroke="white" stroke-opacity="0.04" stroke-width="1" stroke-dasharray="4 6" />
          <line x1="52%" y1="20%" x2="68%" y2="30%" stroke="white" stroke-opacity="0.04" stroke-width="1" stroke-dasharray="4 6" />
          <line x1="30%" y1="65%" x2="55%" y2="60%" stroke="white" stroke-opacity="0.04" stroke-width="1" stroke-dasharray="4 6" />
        </svg>
      </div>
    </div>

    <!-- Transition arrow -->
    <div class="flex justify-center mb-16 sm:mb-24" data-scroll-reveal data-chaos-arrow>
      <div class="flex flex-col items-center gap-3">
        <div class="w-px h-16 bg-gradient-to-b from-white/5 to-white/20"></div>
        <div class="w-10 h-10 rounded-full border border-white/10 bg-white/[0.03] flex items-center justify-center">
          <svg class="w-4 h-4 text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </div>
      </div>
    </div>

    <!-- AFTER: The unified world -->
    <div class="text-center mb-8 sm:mb-12" data-scroll-reveal data-unified-header>
      <h3 class="font-display text-3xl sm:text-4xl lg:text-5xl font-300 uppercase leading-[0.95] mb-3">
        SeeMyHealth connects <span class="font-500">everything.</span>
      </h3>
      <p class="text-brand-gray-400 max-w-md mx-auto text-sm sm:text-base">
        One app, one dashboard, one picture of your health.
      </p>
    </div>

    <!-- Unified visual — real device images flowing into a central dashboard -->
    <div class="relative max-w-4xl mx-auto" data-scroll-reveal data-unified-grid>
      <!-- Device images in a clean row -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 mb-6">
        {unifiedDevices.map((d) => (
          <div class="group relative rounded-2xl overflow-hidden aspect-[4/5] bg-brand-gray-900">
            <img src={d.image} alt={d.name} class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4 flex items-center gap-2">
              <div class="w-2 h-2 rounded-full shrink-0" style={`background: ${d.color}`}></div>
              <p class="text-[11px] font-medium text-white uppercase tracking-wider">{d.name}</p>
            </div>
            <!-- Connection line going up -->
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-px h-0 group-hover:h-8 bg-gradient-to-b from-transparent transition-all duration-500" style={`--tw-gradient-to: ${d.color}40`}></div>
          </div>
        ))}
      </div>

      <!-- Central app dashboard hint -->
      <div class="flex justify-center">
        <div class="inline-flex items-center gap-3 px-6 py-3 rounded-full border border-white/10 bg-white/[0.03]">
          <div class="flex -space-x-1.5">
            {unifiedDevices.map((d) => (
              <div class="w-3 h-3 rounded-full border border-brand-dark" style={`background: ${d.color}`}></div>
            ))}
          </div>
          <span class="text-[11px] uppercase tracking-[2px] text-brand-gray-400">All in one dashboard</span>
        </div>
      </div>
    </div>

    <!-- Manifesto -->
    <div class="max-w-3xl mx-auto text-center mt-16 sm:mt-24" data-scroll-reveal>
      <p class="text-base sm:text-lg lg:text-xl text-brand-gray-300 leading-relaxed font-light">
        SeeMyHealth brings it all together, lets your family participate in care, keeps you in control, and gives you the app + devices to make it effortless.
      </p>
    </div>

  </div>
</section>

