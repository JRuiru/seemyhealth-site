---
const CF_IMG = "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg";

const steps = [
  {
    number: "01",
    verb: "Download",
    subtitle: "Start with the app",
    image: `${CF_IMG}/app-couch-download/public`,
    imageAlt: "Woman on couch downloading the SeeMyHealth app",
  },
  {
    number: "02",
    verb: "Connect",
    subtitle: "Add your first device",
    image: `${CF_IMG}/ring-app-phone/public`,
    imageAlt: "Girl connecting Ring One with the app",
  },
  {
    number: "03",
    verb: "See",
    subtitle: "The full picture",
    image: `${CF_IMG}/app-family-weight-view/public`,
    imageAlt: "SeeMyHealth unified dashboard",
  },
];
---

<section id="how-it-works" class="py-16 sm:py-32 bg-brand-black border-t border-white/5 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-12 sm:mb-20" data-scroll-reveal>
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">How It Works</p>
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-300 uppercase leading-[0.95]">
        Download. Connect. <span class="font-500">See.</span>
      </h2>
    </div>

    <!-- Steps with images -->
    <div class="grid lg:grid-cols-3 gap-4 sm:gap-6 max-w-5xl mx-auto" data-scroll-stagger>
      {steps.map((step) => (
        <div class="group relative rounded-2xl overflow-hidden bg-brand-dark border border-white/5 hover:border-white/15 transition-all duration-500">
          <!-- Image -->
          <div class="relative aspect-[3/4] sm:aspect-[4/5] overflow-hidden">
            <img
              src={step.image}
              alt={step.imageAlt}
              class="w-full h-full object-cover opacity-70 group-hover:opacity-90 group-hover:scale-105 transition-all duration-700"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-dark via-brand-dark/40 to-transparent"></div>

            <!-- Number overlay -->
            <span class="absolute top-4 right-4 font-display text-6xl sm:text-7xl font-200 text-white/[0.06] group-hover:text-white/[0.12] transition-colors duration-500 leading-none">
              {step.number}
            </span>
          </div>

          <!-- Text overlay at bottom -->
          <div class="absolute bottom-0 left-0 right-0 p-5 sm:p-6">
            <h3 class="font-display text-2xl sm:text-3xl uppercase font-500 mb-1">{step.verb}</h3>
            <p class="text-sm text-brand-gray-400">{step.subtitle}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
