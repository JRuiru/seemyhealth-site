---
const CF_IMG = "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg";

const steps = [
  {
    number: "01",
    verb: "Download",
    title: "Start with the app",
    description: "Create your account and start your 1-month free trial. Journalling, mood, meals, and challenges work from day one. No device needed.",
  },
  {
    number: "02",
    verb: "Add",
    title: "Connect your devices",
    description: "Buy your own or walk up to a shared one. Open the app, tap connect, and your reading saves to your profile instantly.",
  },
  {
    number: "03",
    verb: "See",
    title: "The full picture",
    description: "Every device feeds one dashboard. The app finds patterns across your data: sleep vs. weight, hydration vs. energy, blood markers vs. diet.",
  },
];
---

<section id="how-it-works" class="py-24 sm:py-32 bg-brand-black border-t border-white/5">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-20" data-scroll-reveal>
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">How It Works</p>
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-300 uppercase leading-[0.95]">
        Download. Add. <span class="font-500">See.</span>
      </h2>
    </div>

    <!-- Steps -->
    <div class="grid lg:grid-cols-3 gap-px bg-white/5 rounded-2xl overflow-hidden max-w-5xl mx-auto" data-scroll-stagger>
      {steps.map((step) => (
        <div class="bg-brand-black p-10 sm:p-12 text-center group hover:bg-brand-gray-900 transition-colors duration-300">
          <span class="font-display text-5xl font-200 text-brand-gray-800 group-hover:text-brand-gray-600 transition-colors block mb-4">
            {step.number}
          </span>
          <h3 class="font-display text-2xl uppercase font-400 mb-2">{step.verb}</h3>
          <p class="text-sm text-brand-gray-400 mb-4">{step.title}</p>
          <p class="text-sm text-brand-gray-600 leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
