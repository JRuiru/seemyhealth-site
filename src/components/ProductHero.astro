---
import PriceTag from './commerce/PriceTag';

interface Props {
  slug: string;
  name: string;
  tagline: string;
  headline: string;
  description: string;
  image: string;
  streamId?: string;
  price: string;
}

const { slug, name, tagline, headline, description, image, streamId, price } = Astro.props;
const videoSrc = streamId ? `https://customer-5zjora8ha9v60sg3.cloudflarestream.com/${streamId}/downloads/default.mp4` : null;
---

<section class="relative min-h-screen flex items-end pb-20 pt-24">
  <div class="absolute inset-0">
    {videoSrc ? (
      <video
        autoplay
        muted
        loop
        playsinline
        poster={image || undefined}
        class="w-full h-full object-cover"
      >
        <source src={videoSrc} type="video/mp4" />
      </video>
    ) : image ? (
      <img
        src={image}
        alt={name}
        class="w-full h-full object-cover"
      />
    ) : (
      <div class="w-full h-full bg-brand-black"></div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-brand-black via-brand-black/50 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-brand-black/60 to-transparent"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-8 w-full">
    <div class="max-w-2xl" data-scroll-reveal>
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-400 mb-4">{tagline}</p>
      <h1 class="font-display text-5xl sm:text-6xl lg:text-8xl font-300 uppercase leading-[0.95] mb-6 whitespace-pre-line">
        {headline}
      </h1>
      <p class="text-lg text-brand-gray-300 leading-relaxed max-w-lg mb-8">
        {description}
      </p>
      <div class="flex items-center gap-6">
        <a
          href={`/configure/${slug}`}
          class="inline-flex items-center px-8 py-4 text-[13px] uppercase tracking-[1.5px] font-medium text-brand-black bg-white rounded-full hover:bg-brand-gray-200 transition-colors"
        >
          Shop Now — <PriceTag handle={slug} mode="from" prefix="From " fallback={price} client:idle />
        </a>
      </div>
    </div>
  </div>
</section>
