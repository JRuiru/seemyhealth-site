---
interface Step {
  title: string;
  description: string;
  icon: string;
}

interface Props {
  color: string;
  steps: Step[];
}

const { color, steps } = Astro.props;
// Ensure exactly 3 steps for the triangular prism
const cards = steps.slice(0, 3);
---

<section class="py-20 sm:py-28 bg-brand-black border-t border-white/5 overflow-hidden">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">
    <div class="text-center mb-16" data-scroll-reveal>
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">How It Works</p>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-300 uppercase leading-[0.95]">
        Simple by <span class="font-500">Design</span>
      </h2>
    </div>

    <!-- 3D Rotating Carousel -->
    <div class="flex justify-center items-center" style="perspective: 1000px;">
      <div
        data-how-carousel
        class="relative w-[260px] h-[320px] sm:w-[320px] sm:h-[380px]"
        style="transform-style: preserve-3d;"
      >
        {cards.map((step, i) => {
          const angle = i * 120;
          return (
            <div
              class="absolute inset-0 w-full h-full backface-hidden how-card-face"
              style={`transform: rotateY(${angle}deg) translateZ(var(--carousel-z, 160px)); backface-visibility: hidden;`}
              data-how-card
            >
              <div
                class="w-full h-full rounded-3xl border p-8 flex flex-col items-center justify-center text-center gap-5 backdrop-blur-sm"
                style={`background: linear-gradient(145deg, ${color}08, ${color}04); border-color: ${color}25; box-shadow: 0 0 40px ${color}08;`}
              >
                <div
                  class="w-14 h-14 rounded-2xl flex items-center justify-center shrink-0"
                  style={`background: ${color}15; border: 1px solid ${color}30;`}
                >
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke={color} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d={step.icon} />
                  </svg>
                </div>
                <p class="text-[11px] uppercase tracking-[3px] font-medium" style={`color: ${color}`}>Step {i + 1}</p>
                <h3 class="font-display text-xl font-400 uppercase leading-tight">{step.title}</h3>
                <p class="text-sm text-brand-gray-400 leading-relaxed">{step.description}</p>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Step indicators -->
    <div class="flex justify-center gap-3 mt-20" data-how-dots>
      {cards.map((_, i) => (
        <button
          class="w-2 h-2 rounded-full transition-all duration-500"
          style={`background: ${color}30;`}
          data-how-dot={i}
          aria-label={`Step ${i + 1}`}
        />
      ))}
    </div>

    <div class="text-center mt-14" data-scroll-reveal>
      <a
        href="/app"
        class="inline-flex items-center px-8 py-3.5 text-[12px] uppercase tracking-[1.5px] font-medium text-white border border-white/20 rounded-full hover:border-white/40 transition-colors"
      >
        Get the App
      </a>
    </div>
  </div>
</section>

<style>
  [data-how-carousel] {
    --carousel-z: 140px;
  }
  @media (min-width: 640px) {
    [data-how-carousel] {
      --carousel-z: 200px;
    }
  }
</style>
