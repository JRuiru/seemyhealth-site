---
interface Step {
  title: string;
  description: string;
  icon: string;
}

interface Props {
  color: string;
  steps: Step[];
}

const { color, steps } = Astro.props;
// Ensure exactly 3 steps for the triangular prism
const cards = steps.slice(0, 3);
---

<section class="py-20 sm:py-28 bg-brand-black border-t border-white/5 overflow-hidden">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">
    <div class="text-center mb-16" data-scroll-reveal>
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">How It Works</p>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-300 uppercase leading-[0.95]">
        Simple by <span class="font-500">Design</span>
      </h2>
    </div>

    <!-- 3D Rotating Carousel -->
    <div class="flex justify-center items-center relative" style="perspective: 1000px;">
      <!-- Ambient glow behind active card -->
      <div
        class="absolute w-[300px] h-[300px] sm:w-[400px] sm:h-[400px] rounded-full blur-[100px] opacity-20 pointer-events-none"
        style={`background: radial-gradient(circle, ${color}, transparent 70%);`}
        data-how-glow
      ></div>

      <div
        data-how-carousel
        class="relative w-[260px] h-[320px] sm:w-[320px] sm:h-[380px]"
        style="transform-style: preserve-3d;"
      >
        {cards.map((step, i) => {
          const angle = i * 120;
          return (
            <div
              class="absolute inset-0 w-full h-full backface-hidden how-card-face"
              style={`transform: rotateY(${angle}deg) translateZ(var(--carousel-z, 160px)); backface-visibility: hidden;`}
              data-how-card
            >
              <div
                class="w-full h-full rounded-3xl border p-8 flex flex-col items-center justify-center text-center gap-5 relative overflow-hidden"
                style={`background: linear-gradient(160deg, ${color}12 0%, ${color}06 40%, rgba(0,0,0,0.3) 100%); border-color: ${color}25; box-shadow: 0 0 60px ${color}10, inset 0 1px 0 ${color}15;`}
              >
                {/* Gradient shimmer overlay */}
                <div
                  class="absolute inset-0 opacity-30 pointer-events-none how-shimmer"
                  style={`background: linear-gradient(135deg, transparent 40%, ${color}15 50%, transparent 60%); background-size: 200% 200%;`}
                ></div>

                {/* Corner accent */}
                <div
                  class="absolute top-0 right-0 w-24 h-24 pointer-events-none"
                  style={`background: radial-gradient(circle at top right, ${color}12, transparent 70%);`}
                ></div>

                {/* Icon container with pulse ring */}
                <div class="relative shrink-0">
                  {/* Pulse ring */}
                  <div
                    class="absolute inset-0 rounded-2xl how-pulse"
                    style={`box-shadow: 0 0 0 0 ${color}40;`}
                    data-how-pulse={i}
                  ></div>
                  <div
                    class="w-16 h-16 rounded-2xl flex items-center justify-center relative"
                    style={`background: linear-gradient(135deg, ${color}20, ${color}10); border: 1px solid ${color}35;`}
                  >
                    <svg
                      class="w-7 h-7 how-icon"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke={color}
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      data-how-icon={i}
                    >
                      <path d={step.icon} class="how-icon-path" />
                    </svg>
                  </div>
                </div>

                <p class="text-[11px] uppercase tracking-[3px] font-medium relative" style={`color: ${color}`}>Step {i + 1}</p>
                <h3 class="font-display text-xl font-400 uppercase leading-tight relative">{step.title}</h3>
                <p class="text-sm text-brand-gray-400 leading-relaxed relative">{step.description}</p>

                {/* Bottom gradient line */}
                <div
                  class="absolute bottom-0 left-1/2 -translate-x-1/2 h-[2px] w-0 rounded-full how-line"
                  style={`background: linear-gradient(90deg, transparent, ${color}, transparent);`}
                  data-how-line={i}
                ></div>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Step indicators -->
    <div class="flex justify-center gap-3 mt-20" data-how-dots>
      {cards.map((_, i) => (
        <button
          class="w-2 h-2 rounded-full transition-all duration-500"
          style={`background: ${color}30;`}
          data-how-dot={i}
          aria-label={`Step ${i + 1}`}
        />
      ))}
    </div>

    <div class="text-center mt-14" data-scroll-reveal>
      <a
        href="/app"
        class="inline-flex items-center px-8 py-3.5 text-[12px] uppercase tracking-[1.5px] font-medium text-white border border-white/20 rounded-full hover:border-white/40 transition-colors"
      >
        Get the App
      </a>
    </div>
  </div>
</section>

<style>
  [data-how-carousel] {
    --carousel-z: 140px;
  }
  @media (min-width: 640px) {
    [data-how-carousel] {
      --carousel-z: 200px;
    }
  }

  /* Icon stroke draw-on animation */
  .how-icon-path {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }

  /* Shimmer sweep */
  @keyframes shimmer {
    0% { background-position: 200% 200%; }
    100% { background-position: -200% -200%; }
  }
  .how-shimmer {
    animation: shimmer 6s ease-in-out infinite;
  }

  /* Pulse ring */
  @keyframes pulse-ring {
    0% { box-shadow: 0 0 0 0 var(--pulse-color, rgba(255,255,255,0.3)); }
    70% { box-shadow: 0 0 0 12px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
</style>
