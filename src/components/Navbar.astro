---
import CartIcon from './commerce/CartIcon';
import AccountMenu from './commerce/AccountMenu';

interface Props {
  variant?: 'default' | 'transparent';
}

const { variant = 'default' } = Astro.props;

const navLinks = [
  { label: "Ring One", href: "/products/ring-one" },
  { label: "The Scale", href: "/products/scale" },
  { label: "The Scale Pro", href: "/products/scale-pro" },
  { label: "BP Monitor", href: "/products/bp-monitor" },
  { label: "Hydra One", href: "/products/hydra-one" },
  { label: "Hema One", href: "/products/hema-one" },
  { label: "App", href: "/app" },
];

const isTransparent = variant === 'transparent';

// The page you are on lights up its own link; a device's configure page counts as that device
const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => {
  if (path === href) return true;
  const device = href.match(/^\/products\/(.+)$/)?.[1];
  return device ? path === `/configure/${device}` : false;
};
---

<nav
  class:list={[
    "fixed top-0 left-0 right-0 z-50 transition-all duration-300",
    isTransparent
      ? "bg-brand-black/30 backdrop-blur-xl backdrop-saturate-150 border-b border-white/10"
      : "bg-brand-black/80 backdrop-blur-lg border-b border-white/5"
  ]}
  id="navbar"
  data-navbar-variant={variant}
>
  <div class="px-6 lg:px-12">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3">
        <img
          src="https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg/logo/public"
          alt="SeeMyHealth"
          class="w-8 h-8 rounded-lg"
        />
        <span class="text-base font-semibold text-white tracking-wide">SeeMyHealth</span>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden xl:flex items-center gap-5 2xl:gap-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              "text-[12px] 2xl:text-[13px] uppercase tracking-[1.5px] 2xl:tracking-[2px] hover:text-white transition-colors duration-300 whitespace-nowrap",
              isActive(link.href) ? "text-white" : "text-brand-gray-400",
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- CTA -->
      <div class="flex items-center gap-4">
        <a
          href="/shop"
          class="hidden sm:inline-flex items-center px-6 py-2.5 text-[13px] uppercase tracking-[1.5px] font-medium text-brand-black bg-white rounded-full hover:bg-brand-gray-200 transition-colors"
        >
          Shop Now
        </a>
        <AccountMenu client:idle />
        <CartIcon client:load />
        <button
          class="xl:hidden p-2 text-brand-gray-400 hover:text-white"
          id="mobile-menu-btn"
          aria-label="Menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div class="hidden xl:hidden bg-brand-black border-t border-white/5" id="mobile-menu">
    <div class="px-6 py-4 space-y-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[
            "block py-3 text-[13px] uppercase tracking-[2px] hover:text-white transition-colors",
            isActive(link.href) ? "text-white" : "text-brand-gray-400",
          ]}
        >
          {link.label}
        </a>
      ))}
      <!-- An action, not a page: the same pill as the desktop button, so it never reads as the active link -->
      <a
        href="/shop"
        class="flex items-center justify-center !mt-4 px-6 py-3 text-[13px] uppercase tracking-[1.5px] font-medium text-brand-black bg-white rounded-full hover:bg-brand-gray-200 transition-colors"
      >
        Shop Now
      </a>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const navbar = document.getElementById('navbar');

  // The bar steps out of the way while somebody scrolls down the page and comes back the moment they
  // scroll up. It stays near the top of the page and while the phone menu is open. Other fixed bars
  // can follow it through <html data-nav-hidden>.
  const NAV_SHOW_ABOVE = 120;   // px from the top, where the bar always shows
  const NAV_DEADBAND = 6;       // px of scroll ignored, so a finger's wobble doesn't flicker it
  let lastY = scrollY;
  let ticking = false;
  const setHidden = (hidden: boolean) => {
    if (!navbar) return;
    navbar.style.transform = hidden ? 'translateY(-100%)' : '';
    document.documentElement.toggleAttribute('data-nav-hidden', hidden);
  };
  addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      const y = scrollY;
      const dy = y - lastY;
      if (Math.abs(dy) < NAV_DEADBAND) return;
      lastY = y;
      const menuOpen = menu ? !menu.classList.contains('hidden') : false;
      setHidden(dy > 0 && y > NAV_SHOW_ABOVE && !menuOpen);
    });
  }, { passive: true });
  // Keyboard users tabbing into the bar always see it
  navbar?.addEventListener('focusin', () => setHidden(false));

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    // Force the opaque bar while the mobile menu is open (the glass variant is too sheer behind a menu)
    if (navbar?.dataset.navbarVariant === 'transparent' && menu && !menu.classList.contains('hidden')) {
      navbar.classList.add('bg-brand-black/80');
      navbar.classList.remove('bg-brand-black/30');
      navbar.style.borderColor = 'rgba(255,255,255,0.05)';
    }
  });
</script>
