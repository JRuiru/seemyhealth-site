---
import CartIcon from './commerce/CartIcon';
import AccountMenu from './commerce/AccountMenu';

interface Props {
  variant?: 'default' | 'transparent' | 'product';
  productName?: string;
  productColor?: string;
}

const { variant = 'default', productName, productColor } = Astro.props;

const navLinks = [
  { label: "Ring One", href: "/products/ring-one" },
  { label: "The Scale", href: "/products/scale" },
  { label: "The Scale Pro", href: "/products/scale-pro" },
  { label: "BP Monitor", href: "/products/bp-monitor" },
  { label: "Hydra One", href: "/products/hydra-one" },
  { label: "Hema One", href: "/products/hema-one" },
  { label: "App", href: "/app" },
];

const isTransparent = variant === 'transparent';
const isProduct = variant === 'product';
---

<nav
  class:list={[
    "fixed top-0 left-0 right-0 z-50 transition-all duration-500",
    isTransparent
      ? "bg-transparent border-b border-transparent"
      : "bg-brand-black/80 backdrop-blur-lg border-b border-white/5"
  ]}
  id="navbar"
  data-navbar-variant={variant}
>
  <div class="px-6 lg:px-12">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3">
        <img
          src="https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg/logo/public"
          alt="SeeMyHealth"
          class="w-8 h-8 rounded-lg"
        />
        <span class="text-base font-semibold text-white tracking-wide">SeeMyHealth</span>
        {isProduct && productName && (
          <span class="hidden sm:flex items-center gap-2 ml-2 pl-4 border-l border-white/10">
            <span
              class="w-2 h-2 rounded-full"
              style={`background-color: ${productColor || '#fff'}`}
            ></span>
            <span class="text-[12px] uppercase tracking-[2px] text-brand-gray-400">{productName}</span>
          </span>
        )}
      </a>

      <!-- Desktop Nav -->
      <div class="hidden xl:flex items-center gap-5 2xl:gap-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-[12px] 2xl:text-[13px] uppercase tracking-[1.5px] 2xl:tracking-[2px] text-brand-gray-400 hover:text-white transition-colors duration-300 whitespace-nowrap"
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- CTA -->
      <div class="flex items-center gap-4">
        <a
          href="/shop"
          class="hidden sm:inline-flex items-center px-6 py-2.5 text-[13px] uppercase tracking-[1.5px] font-medium text-brand-black bg-white rounded-full hover:bg-brand-gray-200 transition-colors"
        >
          Shop Now
        </a>
        <AccountMenu client:idle />
        <CartIcon client:load />
        <button
          class="xl:hidden p-2 text-brand-gray-400 hover:text-white"
          id="mobile-menu-btn"
          aria-label="Menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div class="hidden xl:hidden bg-brand-black border-t border-white/5" id="mobile-menu">
    <div class="px-6 py-4 space-y-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="block py-3 text-[13px] uppercase tracking-[2px] text-brand-gray-400 hover:text-white transition-colors"
        >
          {link.label}
        </a>
      ))}
      <a
        href="/shop"
        class="block py-3 mt-2 text-[13px] uppercase tracking-[1.5px] font-medium text-white"
      >
        Shop Now
      </a>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const navbar = document.getElementById('navbar');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    // Force opaque background when mobile menu is open (especially for transparent variant)
    if (navbar?.dataset.navbarVariant === 'transparent' && menu && !menu.classList.contains('hidden')) {
      navbar.classList.add('bg-brand-black/80', 'backdrop-blur-lg', 'border-white/5');
      navbar.classList.remove('bg-transparent', 'border-transparent');
    }
  });
</script>
