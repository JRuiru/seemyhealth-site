---
import type { ProductSpec } from '../data/products';
import PriceTag from './commerce/PriceTag';

interface Props {
  slug: string;
  name: string;
  price: string;
  specs: ProductSpec[];
  backgroundImage?: string;
}

const { slug, name, price, specs, backgroundImage } = Astro.props;
---

<section class="relative pt-24 pb-16 sm:pt-32 sm:pb-20 bg-brand-dark border-t border-white/5 overflow-hidden">
  {backgroundImage && (
    <div class="absolute inset-0 pointer-events-none">
      <img src={backgroundImage} alt="" aria-hidden="true" class:list={["absolute right-0 top-1/2 -translate-y-1/2 w-auto object-contain opacity-15 sm:opacity-20", slug.startsWith('scale') ? 'h-full' : 'h-[120%]']} loading="lazy" />
    </div>
  )}
  <div class="relative max-w-5xl mx-auto px-6 lg:px-8">
    <div class="mb-16" data-scroll-reveal>
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">Technical</p>
      <h2 class="font-display text-4xl sm:text-5xl font-300 uppercase leading-[0.95]">
        Specifications
      </h2>
    </div>

    <div class="border-t border-white/10" data-scroll-stagger>
      {specs.map((spec) => (
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 sm:gap-4 py-5 border-b border-white/5">
          <span class="text-sm text-brand-gray-500 uppercase tracking-wider shrink-0">{spec.label}</span>
          <span class="text-sm text-white sm:text-right">{spec.value}</span>
        </div>
      ))}
    </div>

    <div class="mt-12 text-center" data-scroll-reveal>
      <a
        href={`/configure/${slug}`}
        class="inline-flex items-center justify-center px-6 sm:px-10 py-3.5 text-[11px] sm:text-[13px] uppercase tracking-[1.5px] font-medium text-brand-black bg-white rounded-full hover:bg-brand-gray-200 transition-colors whitespace-nowrap"
      >
        Shop {name}&nbsp;·&nbsp;<PriceTag handle={slug} mode="from" prefix="From " fallback={price} client:idle />
      </a>
    </div>
  </div>
</section>
