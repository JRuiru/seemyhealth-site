---
interface Props {
  slug: string;
  name: string;
  color: string;
}

const { slug, name, color } = Astro.props;
---

<section
  id="reviews"
  class="py-20 sm:py-28 bg-brand-black border-t border-white/5"
  data-reviews-section
  data-slug={slug}
  data-name={name}
  data-color={color}
>
  <div class="max-w-5xl mx-auto px-6 lg:px-8">
    <!-- Section header -->
    <div class="mb-12" data-scroll-reveal>
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">Reviews</p>
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div>
          <h2 class="font-display text-3xl sm:text-4xl font-300 uppercase leading-[0.95]" data-reviews-heading>
            <span class="font-500" data-reviews-count-text>Reviews</span>
          </h2>
          <div class="flex items-center gap-3 mt-3" data-reviews-summary>
            <div class="flex gap-0.5" data-reviews-avg-stars></div>
            <span class="text-sm text-brand-gray-500" data-reviews-avg-text></span>
          </div>
        </div>
        <button
          class="inline-flex items-center justify-center px-6 py-3 text-[11px] uppercase tracking-[1.5px] font-medium rounded-full border transition-colors"
          data-reviews-write-btn
        >
          Write a Review
        </button>
      </div>
    </div>

    <!-- Review form (hidden by default) -->
    <div class="hidden mb-12" data-reviews-form-container>
      <div class="bg-[#141414] border border-[#1a1a1a] rounded-xl p-6 sm:p-8">
        <div class="flex items-center justify-between mb-6">
          <h3 class="font-display text-xl uppercase font-300 text-brand-gray-100">Write a <span class="font-500">Review</span></h3>
          <button class="text-brand-gray-500 hover:text-white transition-colors" data-reviews-form-close>
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <form data-reviews-form class="space-y-5">
          <!-- Star rating -->
          <div>
            <label class="block text-[11px] uppercase tracking-[2px] text-brand-gray-500 mb-3">Rating</label>
            <div class="flex gap-1.5" data-reviews-form-stars>
              {[1, 2, 3, 4, 5].map((i) => (
                <button type="button" class="w-8 h-8 transition-colors" data-star-btn data-star-value={i}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-full h-full">
                    <path d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                  </svg>
                </button>
              ))}
            </div>
            <input type="hidden" name="rating" value="0" data-reviews-form-rating />
          </div>
          <!-- Name + Email row -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-[11px] uppercase tracking-[2px] text-brand-gray-500 mb-2">Name</label>
              <input type="text" name="name" required class="w-full bg-brand-black border border-white/10 rounded-lg px-4 py-3 text-sm text-white placeholder:text-brand-gray-600 focus:outline-none focus:border-white/20 transition-colors" placeholder="Your name" />
            </div>
            <div>
              <label class="block text-[11px] uppercase tracking-[2px] text-brand-gray-500 mb-2">Email</label>
              <input type="email" name="email" required class="w-full bg-brand-black border border-white/10 rounded-lg px-4 py-3 text-sm text-white placeholder:text-brand-gray-600 focus:outline-none focus:border-white/20 transition-colors" placeholder="your@email.com" />
            </div>
          </div>
          <!-- Title -->
          <div>
            <label class="block text-[11px] uppercase tracking-[2px] text-brand-gray-500 mb-2">Title</label>
            <input type="text" name="title" required class="w-full bg-brand-black border border-white/10 rounded-lg px-4 py-3 text-sm text-white placeholder:text-brand-gray-600 focus:outline-none focus:border-white/20 transition-colors" placeholder="Summary of your review" />
          </div>
          <!-- Body -->
          <div>
            <label class="block text-[11px] uppercase tracking-[2px] text-brand-gray-500 mb-2">Review</label>
            <textarea name="body" required rows="4" class="w-full bg-brand-black border border-white/10 rounded-lg px-4 py-3 text-sm text-white placeholder:text-brand-gray-600 focus:outline-none focus:border-white/20 transition-colors resize-none" placeholder="Share your experience..."></textarea>
          </div>
          <!-- Submit -->
          <div class="flex items-center gap-4">
            <button type="submit" class="inline-flex items-center justify-center px-8 py-3 text-[11px] uppercase tracking-[1.5px] font-medium text-brand-black rounded-full transition-colors" data-reviews-form-submit>
              Submit Review
            </button>
            <span class="text-sm text-brand-gray-500 hidden" data-reviews-form-status></span>
          </div>
        </form>
      </div>
    </div>

    <!-- Loading skeleton -->
    <div data-reviews-skeleton class="space-y-4">
      {[1, 2, 3].map(() => (
        <div class="bg-[#141414] border border-[#1a1a1a] rounded-xl p-6 animate-pulse">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex gap-0.5">
              {[1, 2, 3, 4, 5].map(() => (
                <div class="w-4 h-4 bg-brand-gray-800 rounded" />
              ))}
            </div>
            <div class="w-20 h-3 bg-brand-gray-800 rounded" />
          </div>
          <div class="w-48 h-4 bg-brand-gray-800 rounded mb-3" />
          <div class="space-y-2">
            <div class="w-full h-3 bg-brand-gray-800 rounded" />
            <div class="w-3/4 h-3 bg-brand-gray-800 rounded" />
          </div>
          <div class="flex items-center gap-2 mt-4">
            <div class="w-24 h-3 bg-brand-gray-800 rounded" />
            <div class="w-16 h-3 bg-brand-gray-800 rounded" />
          </div>
        </div>
      ))}
    </div>

    <!-- Reviews list -->
    <div class="hidden space-y-4" data-reviews-list></div>

    <!-- Empty state -->
    <div class="hidden text-center py-16" data-reviews-empty>
      <svg class="w-12 h-12 mx-auto mb-4 text-brand-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" />
      </svg>
      <p class="text-brand-gray-500 text-sm mb-1">No reviews yet</p>
      <p class="text-brand-gray-600 text-xs" data-reviews-empty-cta></p>
    </div>

    <!-- Load more -->
    <div class="hidden mt-8 text-center" data-reviews-load-more>
      <button class="inline-flex items-center justify-center px-8 py-3 text-[11px] uppercase tracking-[1.5px] font-medium text-white border border-white/10 rounded-full hover:border-white/20 transition-colors" data-reviews-load-more-btn>
        Load More Reviews
      </button>
    </div>
  </div>
</section>

<script>
  (function () {
    const section = document.querySelector('[data-reviews-section]') as HTMLElement;
    if (!section) return;

    const slug = section.dataset.slug!;
    const productName = section.dataset.name!;
    const color = section.dataset.color!;

    // Element refs
    const heading = section.querySelector('[data-reviews-count-text]') as HTMLElement;
    const avgStars = section.querySelector('[data-reviews-avg-stars]') as HTMLElement;
    const avgText = section.querySelector('[data-reviews-avg-text]') as HTMLElement;
    const summary = section.querySelector('[data-reviews-summary]') as HTMLElement;
    const skeleton = section.querySelector('[data-reviews-skeleton]') as HTMLElement;
    const list = section.querySelector('[data-reviews-list]') as HTMLElement;
    const empty = section.querySelector('[data-reviews-empty]') as HTMLElement;
    const emptyCta = section.querySelector('[data-reviews-empty-cta]') as HTMLElement;
    const loadMoreWrap = section.querySelector('[data-reviews-load-more]') as HTMLElement;
    const loadMoreBtn = section.querySelector('[data-reviews-load-more-btn]') as HTMLButtonElement;
    const writeBtn = section.querySelector('[data-reviews-write-btn]') as HTMLButtonElement;
    const formContainer = section.querySelector('[data-reviews-form-container]') as HTMLElement;
    const formClose = section.querySelector('[data-reviews-form-close]') as HTMLButtonElement;
    const form = section.querySelector('[data-reviews-form]') as HTMLFormElement;
    const formStars = section.querySelector('[data-reviews-form-stars]') as HTMLElement;
    const formRating = section.querySelector('[data-reviews-form-rating]') as HTMLInputElement;
    const formSubmit = section.querySelector('[data-reviews-form-submit]') as HTMLButtonElement;
    const formStatus = section.querySelector('[data-reviews-form-status]') as HTMLElement;

    // Apply product color to button styles
    writeBtn.style.borderColor = color;
    writeBtn.style.color = color;
    writeBtn.addEventListener('mouseenter', () => { writeBtn.style.backgroundColor = color; writeBtn.style.color = '#0a0a0a'; });
    writeBtn.addEventListener('mouseleave', () => { writeBtn.style.backgroundColor = 'transparent'; writeBtn.style.color = color; });
    formSubmit.style.backgroundColor = color;

    // State
    let currentPage = 1;
    const perPage = 5;
    let allReviews: any[] = [];
    let formSelectedRating = 0;

    // Star SVG helper
    function starSVG(filled: boolean, size = 16): string {
      const fill = filled ? color : 'none';
      const stroke = filled ? color : '#404040';
      return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="${fill}" stroke="${stroke}" stroke-width="1.5"><path d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/></svg>`;
    }

    function renderStars(rating: number, size = 16): string {
      return Array.from({ length: 5 }, (_, i) => starSVG(i < Math.round(rating), size)).join('');
    }

    function formatDate(dateStr: string): string {
      const d = new Date(dateStr);
      return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    }

    function renderReviewCard(review: any): string {
      const verified = review.verified
        ? `<span class="inline-flex items-center gap-1 text-[11px] uppercase tracking-wider" style="color:${color}"><svg width="12" height="12" viewBox="0 0 24 24" fill="${color}" stroke="none"><path d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>Verified</span>`
        : '';
      return `
        <div class="bg-[#141414] border border-[#1a1a1a] rounded-xl p-6">
          <div class="flex items-center gap-3 mb-3">
            <div class="flex gap-0.5">${renderStars(review.rating)}</div>
            <span class="text-xs text-brand-gray-600">${formatDate(review.created_at)}</span>
          </div>
          ${review.title ? `<h4 class="text-sm font-medium text-brand-gray-100 mb-2">${escapeHtml(review.title)}</h4>` : ''}
          ${review.body ? `<p class="text-sm text-brand-gray-400 leading-relaxed mb-4">${escapeHtml(review.body)}</p>` : ''}
          <div class="flex items-center gap-3">
            <span class="text-xs text-brand-gray-500">${escapeHtml(review.reviewer?.name || 'Anonymous')}</span>
            ${verified}
          </div>
        </div>
      `;
    }

    function escapeHtml(str: string): string {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    function renderList() {
      const visible = allReviews.slice(0, currentPage * perPage);
      list.innerHTML = visible.map(renderReviewCard).join('');

      if (allReviews.length > visible.length) {
        loadMoreWrap.classList.remove('hidden');
      } else {
        loadMoreWrap.classList.add('hidden');
      }
    }

    // Fetch summary
    async function fetchSummary() {
      try {
        const res = await fetch(`/api/reviews/summary?handle=${slug}`);
        if (!res.ok) return;
        const data = await res.json();
        if (data.count > 0) {
          heading.textContent = `${data.count} Review${data.count !== 1 ? 's' : ''}`;
          avgStars.innerHTML = renderStars(data.rating, 18);
          avgText.textContent = `${data.rating.toFixed(1)} out of 5`;
          summary.classList.remove('hidden');
        }
      } catch {}
    }

    // Fetch reviews
    async function fetchReviews() {
      try {
        const res = await fetch(`/api/reviews?handle=${slug}`);
        if (!res.ok) throw new Error('Failed to fetch');
        const data = await res.json();
        allReviews = data.reviews || data || [];

        skeleton.classList.add('hidden');

        if (allReviews.length === 0) {
          empty.classList.remove('hidden');
          emptyCta.textContent = `Be the first to review ${productName}`;
        } else {
          list.classList.remove('hidden');
          renderList();
        }
      } catch {
        skeleton.classList.add('hidden');
        empty.classList.remove('hidden');
        emptyCta.textContent = `Be the first to review ${productName}`;
      }
    }

    // Load more
    loadMoreBtn.addEventListener('click', () => {
      currentPage++;
      renderList();
    });

    // Write review toggle
    writeBtn.addEventListener('click', () => {
      formContainer.classList.toggle('hidden');
      if (!formContainer.classList.contains('hidden')) {
        formContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
    formClose.addEventListener('click', () => {
      formContainer.classList.add('hidden');
    });

    // Form star selection
    const starBtns = formStars.querySelectorAll<HTMLButtonElement>('[data-star-btn]');
    function updateFormStars(rating: number) {
      formSelectedRating = rating;
      formRating.value = String(rating);
      starBtns.forEach((btn) => {
        const val = Number(btn.dataset.starValue);
        const svg = btn.querySelector('svg')!;
        if (val <= rating) {
          svg.setAttribute('fill', color);
          svg.setAttribute('stroke', color);
        } else {
          svg.setAttribute('fill', 'none');
          svg.setAttribute('stroke', '#404040');
        }
      });
    }
    starBtns.forEach((btn) => {
      btn.addEventListener('click', () => updateFormStars(Number(btn.dataset.starValue)));
      btn.addEventListener('mouseenter', () => {
        const val = Number(btn.dataset.starValue);
        starBtns.forEach((b) => {
          const v = Number(b.dataset.starValue);
          const svg = b.querySelector('svg')!;
          svg.setAttribute('fill', v <= val ? color : 'none');
          svg.setAttribute('stroke', v <= val ? color : '#404040');
        });
      });
      btn.addEventListener('mouseleave', () => updateFormStars(formSelectedRating));
    });

    // Form submit
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (formSelectedRating === 0) {
        formStatus.textContent = 'Please select a rating';
        formStatus.classList.remove('hidden');
        return;
      }

      const fd = new FormData(form);
      const payload = {
        handle: slug,
        rating: formSelectedRating,
        title: fd.get('title'),
        body: fd.get('body'),
        reviewer: {
          name: fd.get('name'),
          email: fd.get('email'),
        },
      };

      formSubmit.disabled = true;
      formSubmit.textContent = 'Submitting...';
      formStatus.classList.add('hidden');

      try {
        const res = await fetch('/api/reviews', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (!res.ok) throw new Error('Submit failed');

        formStatus.textContent = 'Review submitted! It will appear after moderation.';
        formStatus.style.color = color;
        formStatus.classList.remove('hidden');
        form.reset();
        updateFormStars(0);

        // Refresh reviews after a short delay
        setTimeout(() => {
          fetchSummary();
          fetchReviews();
        }, 1500);
      } catch {
        formStatus.textContent = 'Something went wrong. Please try again.';
        formStatus.style.color = '#EF4444';
        formStatus.classList.remove('hidden');
      } finally {
        formSubmit.disabled = false;
        formSubmit.textContent = 'Submit Review';
      }
    });

    // Init
    fetchSummary();
    fetchReviews();
  })();
</script>
