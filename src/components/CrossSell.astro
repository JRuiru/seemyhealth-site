---
import { products } from '../data/products';
import PriceTag from './commerce/PriceTag';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;

const otherProducts = Object.entries(products)
  .filter(([slug]) => slug !== currentSlug)
  .slice(0, 3)
  .map(([slug, product]) => ({ slug, ...product }));
---

<section class="py-24 sm:py-32 bg-brand-dark border-t border-white/5">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="mb-16 text-center" data-scroll-reveal>
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">Ecosystem</p>
      <h2 class="font-display text-4xl sm:text-5xl font-300 uppercase leading-[0.95]">
        Complete Your <span class="font-500">Picture</span>
      </h2>
      <p class="text-brand-gray-500 mt-4 max-w-lg mx-auto">
        Every SeeMyHealth device feeds into one app. The more you add, the clearer your health becomes.
      </p>
    </div>

    <div class="grid sm:grid-cols-3 gap-6" data-scroll-stagger>
      {otherProducts.map((product) => (
        <a href={`/products/${product.slug}`} class="group block rounded-2xl overflow-hidden bg-brand-gray-900 hover:bg-brand-gray-900/80 transition-colors">
          <div class="relative h-56 overflow-hidden">
            <img
              src={product.crossSellImage || product.image}
              alt={product.name}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-gray-900 to-transparent"></div>
          </div>
          <div class="p-6">
            <p class="text-[10px] uppercase tracking-[3px] text-brand-gray-500 mb-1">{product.tagline}</p>
            <h3 class="font-display text-lg uppercase mb-1">{product.name}</h3>
            <div class="flex items-center justify-between mt-3">
              <span class="text-sm font-display text-brand-gray-300">
                <PriceTag handle={product.slug} mode="from" prefix="From " fallback={product.price} client:idle />
              </span>
              <span class="text-[11px] uppercase tracking-[1.5px] text-brand-gray-500 group-hover:text-white transition-colors">
                Explore &rarr;
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
