---
import type { ProductFeature } from '../data/products';

interface Props {
  features: ProductFeature[];
  color?: string;
}

const { features, color = "#ffffff" } = Astro.props;
---

<section class="py-24 sm:py-32 bg-brand-dark border-t border-white/5">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="mb-16" data-scroll-reveal>
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">What It Does</p>
      <h2 class="font-display text-4xl sm:text-5xl font-300 uppercase leading-[0.95]">
        Built for <span class="font-500">Real Life</span>
      </h2>
    </div>

    <!-- Stacking cards -->
    <div class="relative" id="feature-stack">
      {features.map((feature, i) => (
        <div
          class="feature-stack-card sticky top-24 sm:top-28 mb-6 sm:mb-8 last:mb-0"
          style={`z-index: ${i + 1};`}
        >
          <div
            class="rounded-2xl sm:rounded-3xl overflow-hidden border border-white/5 bg-brand-black shadow-2xl"
            style={`transform: translateY(${i * 8}px);`}
          >
            <div class="grid lg:grid-cols-2 h-[380px] sm:h-[420px] lg:h-[400px]">
              <!-- Image -->
              {feature.image && (
                <div class="relative h-48 sm:h-56 lg:h-full overflow-hidden">
                  <img
                    src={feature.image}
                    alt={feature.title}
                    class="w-full h-full object-cover"
                    style={feature.imagePosition ? `object-position: ${feature.imagePosition}` : undefined}
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-r from-transparent to-brand-black/40 hidden lg:block"></div>
                  <div class="absolute inset-0 bg-gradient-to-t from-brand-black to-transparent lg:hidden"></div>
                  <!-- Card number -->
                  <div class="absolute top-4 left-4 sm:top-6 sm:left-6">
                    <span
                      class="text-[11px] uppercase tracking-[3px] font-medium px-2.5 py-1 rounded-full bg-black/40 backdrop-blur-sm"
                      style={`color: ${color}`}
                    >
                      0{i + 1}
                    </span>
                  </div>
                </div>
              )}

              <!-- Content -->
              <div class="flex flex-col justify-center p-6 sm:p-10 lg:p-12 -mt-6 lg:mt-0 relative overflow-hidden">
                <svg
                  class="w-8 h-8 mb-5 hidden sm:block"
                  style={`color: ${color}`}
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d={feature.icon} />
                </svg>
                <h3 class="font-display text-2xl sm:text-3xl uppercase mb-3 sm:mb-4">{feature.title}</h3>
                <p class="text-sm sm:text-base text-brand-gray-400 leading-relaxed">{feature.description}</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
