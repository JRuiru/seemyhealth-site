---
const stats = [
  { value: 5, suffix: "", label: "Connected Devices" },
  { value: 13, suffix: "+", label: "Body Metrics Tracked" },
  { value: 7, suffix: " days", label: "Ring Battery Life" },
  { value: 24, suffix: "/7", label: "Continuous Monitoring" },
];
---

<section class="py-20 sm:py-28 bg-brand-dark border-t border-b border-white/5">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12" data-scroll-stagger>
      {stats.map((stat) => (
        <div class="text-center lg:text-left">
          <div class="flex items-baseline justify-center lg:justify-start gap-1">
            <span
              class="font-display text-5xl sm:text-6xl lg:text-7xl font-300 leading-none"
              data-counter={stat.value}
            >
              0
            </span>
            {stat.suffix && (
              <span class="font-display text-2xl sm:text-3xl font-300 text-brand-gray-400">{stat.suffix}</span>
            )}
          </div>
          <p class="text-[11px] uppercase tracking-[3px] text-brand-gray-500 mt-3">{stat.label}</p>
          <div class="h-px bg-white/10 mt-6 origin-left" data-line-wipe></div>
        </div>
      ))}
    </div>
  </div>
</section>
