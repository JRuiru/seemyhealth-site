---
interface FAQ {
  q: string;
  a: string;
}

interface Props {
  faqs: FAQ[];
}

const { faqs } = Astro.props;
---

<section class="py-20 sm:py-28 bg-brand-black border-t border-white/5">
  <div class="max-w-3xl mx-auto px-6 lg:px-8">
    <div class="mb-12" data-scroll-reveal>
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">FAQ</p>
      <h2 class="font-display text-3xl sm:text-4xl font-300 uppercase leading-[0.95]">
        Common <span class="font-500">Questions</span>
      </h2>
    </div>

    <div class="space-y-0 border-t border-white/10" data-scroll-stagger>
      {faqs.map((faq, i) => (
        <details class="group border-b border-white/5" data-faq-item>
          <summary class="flex items-center justify-between py-5 cursor-pointer list-none">
            <span class="text-sm text-white pr-6">{faq.q}</span>
            <svg class="w-4 h-4 text-brand-gray-600 shrink-0 transition-transform duration-200 group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m6-6H6" />
            </svg>
          </summary>
          <div class="pb-5 pr-10">
            <p class="text-sm text-brand-gray-500 leading-relaxed">{faq.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
