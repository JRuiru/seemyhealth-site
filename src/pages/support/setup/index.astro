---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

export const prerender = true;

const CF_IMG = "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg";

const devices = [
  {
    slug: "ring-one",
    name: "Ring One",
    tagline: "HRV · Sleep · Recovery",
    image: `${CF_IMG}/ring-hero-hands/public`,
    time: "~5 min",
  },
  {
    slug: "scale",
    name: "The Scale",
    tagline: "Body composition",
    image: `${CF_IMG}/scale-black-pack/public`,
    time: "~3 min",
  },
  {
    slug: "scale-pro",
    name: "The Scale Pro",
    tagline: "Segmental analysis",
    image: `${CF_IMG}/scale-pro-hero-new/public`,
    time: "~3 min",
  },
  {
    slug: "bp-monitor",
    name: "BP Monitor",
    tagline: "Blood pressure",
    image: `${CF_IMG}/bp-black/public`,
    time: "~4 min",
  },
  {
    slug: "hydra-one",
    name: "Hydra One",
    tagline: "Hydration",
    image: `${CF_IMG}/bottle-office-scene/public`,
    time: "~2 min",
  },
  {
    slug: "hema-one",
    name: "Hema One",
    tagline: "At-home bloodwork",
    image: `${CF_IMG}/hema-one-hero/public`,
    time: "~5 min",
  },
];
---

<Layout
  title="Setup Guides — SeeMyHealth Help Center"
  description="Step-by-step setup guides for every SeeMyHealth device. Pair, calibrate, and get your first reading in under 5 minutes."
  canonicalPath="/support/setup"
>
  <Navbar />

  <!-- Hero -->
  <section class="pt-32 pb-12 sm:pt-40 sm:pb-16 bg-brand-black">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <a href="/support" class="inline-flex items-center gap-2 text-[12px] uppercase tracking-[1.5px] text-brand-gray-500 hover:text-white transition-colors mb-6">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Help Center
      </a>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-300 uppercase leading-[0.95] mb-4" data-scroll-reveal>
        Setup <span class="font-500">guides.</span>
      </h1>
      <p class="text-lg text-brand-gray-400 leading-relaxed max-w-lg">
        Pair, calibrate, and get the first reading in under 5 minutes.
      </p>
    </div>
  </section>

  <!-- Device grid -->
  <section class="py-12 sm:py-16 bg-brand-black">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5" data-scroll-stagger>
        {devices.map((device) => (
          <div class="group rounded-2xl bg-brand-gray-900 border border-white/5 hover:border-white/15 overflow-hidden transition-all duration-300">
            {/* Image */}
            <div class="aspect-[4/3] bg-brand-gray-800 overflow-hidden">
              <img
                src={device.image}
                alt={device.name}
                class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
                loading="lazy"
              />
            </div>

            {/* Info */}
            <div class="p-5">
              <h3 class="text-lg font-medium text-white mb-0.5">{device.name}</h3>
              <p class="text-[13px] text-brand-gray-500 mb-4">{device.tagline}</p>

              <div class="flex items-center justify-between">
                <span class="text-[11px] text-brand-gray-600">{device.time}</span>
                <a
                  href={`/support/setup/${device.slug}`}
                  class="inline-flex items-center px-4 py-2 text-[12px] uppercase tracking-[1px] font-medium text-brand-black bg-white rounded-full hover:bg-brand-gray-200 transition-colors"
                >
                  Start guide
                  <svg class="w-3 h-3 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
