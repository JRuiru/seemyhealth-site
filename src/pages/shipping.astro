---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;

const CF_IMG = "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg";
---

<Layout title="Shipping & Returns | SeeMyHealth" description="Free shipping on orders over $150. 30-day hassle-free returns on all SeeMyHealth devices." canonicalPath="/shipping">
  <Navbar />

  <!-- Hero -->
  <section class="pt-32 pb-16 sm:pt-40 sm:pb-20 bg-brand-black relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-blue-500/[0.03] blur-[120px]"></div>
    </div>
    <div class="max-w-4xl mx-auto px-6 lg:px-8 relative z-10">
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">Shipping & Returns</p>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-300 uppercase leading-[0.95] mb-6">
        Fast Shipping.<br /><span class="font-500">Easy Returns.</span>
      </h1>
      <p class="text-lg text-brand-gray-400 leading-relaxed max-w-xl">
        We ship worldwide from the warehouse closest to you. If it's not right, send it back within 30 days. No drama.
      </p>
    </div>
  </section>

  <!-- Key promises -->
  <section class="py-12 sm:py-16 bg-brand-black border-t border-white/5">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="text-center p-5 rounded-2xl bg-brand-gray-900 border border-white/5">
          <svg class="w-6 h-6 mx-auto text-brand-gray-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
          </svg>
          <p class="text-white text-sm font-medium">Free Shipping</p>
          <p class="text-[11px] text-brand-gray-500 mt-1">Orders over $150</p>
        </div>
        <div class="text-center p-5 rounded-2xl bg-brand-gray-900 border border-white/5">
          <svg class="w-6 h-6 mx-auto text-brand-gray-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p class="text-white text-sm font-medium">2-10 Days</p>
          <p class="text-[11px] text-brand-gray-500 mt-1">Delivery window</p>
        </div>
        <div class="text-center p-5 rounded-2xl bg-brand-gray-900 border border-white/5">
          <svg class="w-6 h-6 mx-auto text-brand-gray-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3" />
          </svg>
          <p class="text-white text-sm font-medium">30-Day Returns</p>
          <p class="text-[11px] text-brand-gray-500 mt-1">No questions asked</p>
        </div>
        <div class="text-center p-5 rounded-2xl bg-brand-gray-900 border border-white/5">
          <svg class="w-6 h-6 mx-auto text-brand-gray-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
          </svg>
          <p class="text-white text-sm font-medium">50+ Countries</p>
          <p class="text-[11px] text-brand-gray-500 mt-1">Worldwide delivery</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Shipping timeline -->
  <section class="py-16 sm:py-24 bg-brand-dark border-t border-white/5">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <p class="text-[10px] uppercase tracking-[3px] text-brand-gray-500 mb-8">How It Works</p>

      <div class="relative">
        <!-- Timeline line -->
        <div class="hidden sm:block absolute left-0 right-0 top-8 h-px bg-gradient-to-r from-white/10 via-white/20 to-white/10" aria-hidden="true"></div>

        <div class="grid sm:grid-cols-4 gap-6 sm:gap-4">
          <div class="relative">
            <div class="w-10 h-10 rounded-full bg-brand-gray-900 border border-white/10 flex items-center justify-center text-white text-sm font-medium mb-4 relative z-10">1</div>
            <h3 class="text-white font-medium mb-1.5">Order Placed</h3>
            <p class="text-sm text-brand-gray-500 leading-relaxed">Confirmation email with order details sent instantly.</p>
          </div>
          <div class="relative">
            <div class="w-10 h-10 rounded-full bg-brand-gray-900 border border-white/10 flex items-center justify-center text-white text-sm font-medium mb-4 relative z-10">2</div>
            <h3 class="text-white font-medium mb-1.5">Packed & Shipped</h3>
            <p class="text-sm text-brand-gray-500 leading-relaxed">Ships from the warehouse nearest to you within 1-2 business days.</p>
          </div>
          <div class="relative">
            <div class="w-10 h-10 rounded-full bg-brand-gray-900 border border-white/10 flex items-center justify-center text-white text-sm font-medium mb-4 relative z-10">3</div>
            <h3 class="text-white font-medium mb-1.5">Track It</h3>
            <p class="text-sm text-brand-gray-500 leading-relaxed">Tracking number emailed the moment your package moves.</p>
          </div>
          <div class="relative">
            <div class="w-10 h-10 rounded-full bg-brand-gray-900 border border-white/10 flex items-center justify-center text-white text-sm font-medium mb-4 relative z-10">4</div>
            <h3 class="text-white font-medium mb-1.5">Delivered</h3>
            <p class="text-sm text-brand-gray-500 leading-relaxed">Standard: 5-10 days. Express: 2-4 days ($14.99).</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Shipping details -->
  <section class="py-16 sm:py-24 bg-brand-black border-t border-white/5">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 gap-6">
        <div class="rounded-2xl bg-brand-gray-900 border border-white/5 p-6 sm:p-8">
          <svg class="w-6 h-6 text-blue-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
          </svg>
          <h3 class="text-white font-medium mb-2">Express Shipping</h3>
          <p class="text-sm text-brand-gray-400 leading-relaxed mb-3">2-4 business days for $14.99. Available in US, Canada, UK, EU, and select Asian markets.</p>
          <p class="text-[11px] text-brand-gray-600">Selected at checkout</p>
        </div>
        <div class="rounded-2xl bg-brand-gray-900 border border-white/5 p-6 sm:p-8">
          <svg class="w-6 h-6 text-emerald-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
          </svg>
          <h3 class="text-white font-medium mb-2">International Orders</h3>
          <p class="text-sm text-brand-gray-400 leading-relaxed mb-3">We ship to 50+ countries. Import duties and taxes may apply and are the buyer's responsibility.</p>
          <p class="text-[11px] text-brand-gray-600">Shipped from nearest warehouse</p>
        </div>
      </div>

      <!-- Warehouse locations -->
      <div class="mt-8 rounded-2xl bg-brand-gray-900 border border-white/5 p-6 sm:p-8">
        <h3 class="text-white font-medium mb-4">Our Warehouses</h3>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {[
            { city: "United States", flag: "🇺🇸", region: "Americas" },
            { city: "Nairobi", flag: "🇰🇪", region: "Africa" },
            { city: "Qatar", flag: "🇶🇦", region: "Middle East" },
            { city: "Shenzhen", flag: "🇨🇳", region: "Asia Pacific" },
          ].map((loc) => (
            <div class="flex items-center gap-3">
              <span class="text-2xl">{loc.flag}</span>
              <div>
                <p class="text-sm text-white">{loc.city}</p>
                <p class="text-[11px] text-brand-gray-600">{loc.region}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Returns section -->
  <section class="py-16 sm:py-24 bg-brand-dark border-t border-white/5">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class="flex items-start gap-4 mb-10">
        <div class="w-12 h-12 rounded-full bg-brand-gray-900 border border-white/5 flex items-center justify-center flex-shrink-0">
          <svg class="w-6 h-6 text-brand-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3" />
          </svg>
        </div>
        <div>
          <h2 class="font-display text-2xl sm:text-3xl font-300 uppercase">
            Returns & <span class="font-500">Exchanges</span>
          </h2>
          <p class="text-brand-gray-400 mt-1">Changed your mind? No worries.</p>
        </div>
      </div>

      <!-- Return steps -->
      <div class="grid sm:grid-cols-3 gap-4 mb-10">
        <div class="rounded-2xl bg-brand-gray-900 border border-white/5 p-6 hover:border-white/10 transition-colors">
          <div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-sm text-white font-medium mb-4">1</div>
          <h3 class="text-white font-medium mb-2">Email Us</h3>
          <p class="text-sm text-brand-gray-500 leading-relaxed">
            Send your order number to <a href="mailto:support@seemyhealth.ai" class="text-white hover:underline">support@seemyhealth.ai</a>. We'll reply with a prepaid label within 24 hours.
          </p>
        </div>
        <div class="rounded-2xl bg-brand-gray-900 border border-white/5 p-6 hover:border-white/10 transition-colors">
          <div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-sm text-white font-medium mb-4">2</div>
          <h3 class="text-white font-medium mb-2">Ship It Back</h3>
          <p class="text-sm text-brand-gray-500 leading-relaxed">
            Pack it in the original box and drop it off. We cover return shipping for exchanges.
          </p>
        </div>
        <div class="rounded-2xl bg-brand-gray-900 border border-white/5 p-6 hover:border-white/10 transition-colors">
          <div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-sm text-white font-medium mb-4">3</div>
          <h3 class="text-white font-medium mb-2">Refund or Exchange</h3>
          <p class="text-sm text-brand-gray-500 leading-relaxed">
            Refunds processed in 5 business days. Exchanges shipped free at no extra cost.
          </p>
        </div>
      </div>

      <!-- Return details -->
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="rounded-xl bg-brand-black border border-white/5 p-5">
          <h4 class="text-white text-sm font-medium mb-2">30-Day Window</h4>
          <p class="text-[13px] text-brand-gray-500 leading-relaxed">Return any device within 30 days of delivery. Items must be in original packaging and good condition.</p>
        </div>
        <div class="rounded-xl bg-brand-black border border-white/5 p-5">
          <h4 class="text-white text-sm font-medium mb-2">Refund Timeline</h4>
          <p class="text-[13px] text-brand-gray-500 leading-relaxed">Refunds appear on your original payment method within 5-10 business days after we receive the return.</p>
        </div>
        <div class="rounded-xl bg-brand-black border border-white/5 p-5">
          <h4 class="text-white text-sm font-medium mb-2">Free Exchanges</h4>
          <p class="text-[13px] text-brand-gray-500 leading-relaxed">Wrong size or color? We'll swap it at no extra cost and cover the return shipping.</p>
        </div>
        <div class="rounded-xl bg-brand-black border border-white/5 p-5">
          <h4 class="text-white text-sm font-medium mb-2">Consumables</h4>
          <p class="text-[13px] text-brand-gray-500 leading-relaxed">Hema One test strips are non-returnable once opened. Unopened packs can be returned within 30 days.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 sm:py-20 bg-brand-black border-t border-white/5">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <h2 class="font-display text-xl sm:text-2xl font-300 uppercase mb-3">Still Have Questions?</h2>
      <p class="text-brand-gray-500 text-sm mb-8">We're here to help. Reach out anytime.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="mailto:support@seemyhealth.ai"
          class="inline-flex items-center px-8 py-3.5 text-[12px] uppercase tracking-[1.5px] font-medium text-brand-black bg-white rounded-full hover:bg-brand-gray-200 transition-colors"
        >
          Contact Support
        </a>
        <a
          href="/support"
          class="inline-flex items-center px-8 py-3.5 text-[12px] uppercase tracking-[1.5px] font-medium text-white border border-white/20 rounded-full hover:border-white/40 transition-colors"
        >
          Visit Help Center
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
