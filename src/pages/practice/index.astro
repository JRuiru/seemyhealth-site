---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import AppStoreButtons from '../../components/AppStoreButtons.astro';

export const prerender = true;

// The universal-link fallback for printed practice QR codes
// (https://seemyhealth.ai/practice/{slug}[/location/{id}]). With the app installed the tap never
// reaches the browser — iOS hands the URL to the app. Anyone landing HERE doesn't have the app,
// so the page's one job is the handoff: name the clinic (slug read client-side; one static page
// serves every slug via the /practice/* rewrite in public/_redirects) and get the app installed.
---

<Layout
  title="Check In | SeeMyHealth"
  description="Check in at your clinic with the SeeMyHealth app."
  canonicalPath="/practice"
  noindex
>
  <Navbar />

  <section class="min-h-[80vh] flex flex-col items-center justify-center bg-brand-black relative overflow-hidden">
    <!-- Soft glow backdrop -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full bg-white/[0.015] blur-[100px]"></div>
    </div>

    <div class="max-w-2xl mx-auto px-6 text-center relative z-10 py-16 sm:py-20">
      <!-- Location pin over ECG line -->
      <div class="relative mb-10">
        <svg class="w-full max-w-md mx-auto h-16 mb-4 opacity-20" viewBox="0 0 400 60" fill="none" preserveAspectRatio="xMidYMid meet">
          <path
            d="M0 30 L80 30 L100 30 L120 10 L140 50 L160 5 L180 55 L200 30 L220 30 L400 30"
            stroke="url(#ecg-gradient-practice)"
            stroke-width="2"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <defs>
            <linearGradient id="ecg-gradient-practice" x1="0" y1="0" x2="400" y2="0">
              <stop offset="0%" stop-color="#ffffff" stop-opacity="0" />
              <stop offset="50%" stop-color="#22C55E" stop-opacity="1" />
              <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
            </linearGradient>
          </defs>
        </svg>

        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-white/5 border border-white/10 mb-6">
          <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
          </svg>
        </div>

        <p class="text-[10px] uppercase tracking-[3px] text-brand-gray-600 mb-3">You've arrived at</p>
        <h1
          id="practice-name"
          class="font-display text-2xl sm:text-3xl font-300 uppercase tracking-wide text-white leading-snug"
        >
          Your Clinic
        </h1>
      </div>

      <p class="text-sm text-brand-gray-400 mb-10 max-w-md mx-auto leading-relaxed">
        This code checks you in through the SeeMyHealth app. Open it there to confirm your
        arrival, or get the app and book your first visit.
      </p>

      <div class="flex flex-col items-center gap-6">
        <a
          id="open-app"
          href="seemyhealth://practice"
          class="inline-flex items-center px-8 py-3.5 text-[12px] uppercase tracking-[1.5px] font-medium text-brand-black bg-white rounded-full hover:bg-brand-gray-200 transition-colors"
        >
          Open in the App
        </a>

        <p class="text-[10px] uppercase tracking-[3px] text-brand-gray-600">Don't have it yet?</p>
        <AppStoreButtons class="justify-center" />
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  // One static page serves every /practice/{slug}[/location/{id}] path (see public/_redirects),
  // so the slug is read from the URL here: it names the clinic and builds the same
  // seemyhealth:// payload the printed QR carries.
  const parts = window.location.pathname.split('/').filter(Boolean);
  const slug = parts[0] === 'practice' ? parts[1] : undefined;

  if (slug) {
    const name = slug
      .split(/[-_]/)
      .filter(Boolean)
      .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
      .join(' ');
    const heading = document.getElementById('practice-name');
    if (heading && name) heading.textContent = name;

    const openApp = document.getElementById('open-app');
    if (openApp) {
      openApp.setAttribute('href', `seemyhealth://${parts.join('/')}`);
    }
  }
</script>
