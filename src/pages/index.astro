---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import HomeProblem from '../components/HomeProblem.astro';
import HomeFamily from '../components/HomeFamily.astro';
import HomeTrust from '../components/HomeTrust.astro';
import HomeAppFirst from '../components/HomeAppFirst.astro';
import Products from '../components/Products.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Stats from '../components/Stats.astro';
import Testimonials from '../components/Testimonials.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "SeeMyHealth",
  alternateName: ["C-MyHealth", "See My Health", "SeeMyHealth AI", "See MyHealth"],
  url: "https://www.seemyhealth.ai",
  logo: "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg/logo/public",
  sameAs: [],
  description: "Health monitoring devices designed around you. Track body composition, blood pressure, hydration, blood markers, heart rate, SpO2, and sleep. Download the C-MyHealth app on iOS and Android.",
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "SeeMyHealth",
  alternateName: ["C-MyHealth", "See My Health", "SeeMyHealth AI", "See MyHealth"],
  url: "https://www.seemyhealth.ai",
};
---

<Layout
  title="SeeMyHealth | One App. Six Devices. Nothing Hidden."
  description="One app, six devices, nothing hidden. Smart ring, smart scale, BP monitor, smart water bottle, and blood analyzer. Try it free for a month."
  canonicalPath="/"
  jsonLd={[orgSchema, webSiteSchema]}
>
  <Navbar variant="transparent" />

  <!-- 1. Hero — See Your Health -->
  <Hero />

  <!-- 2. The problem — fragmented health data → we connect everything -->
  <HomeProblem />

  <!-- 3. Family wellness — not just you, your whole family -->
  <HomeFamily />

  <!-- 5. Trust & privacy — your data stays yours -->
  <HomeTrust />

  <!-- 6. The app — works from day one -->
  <HomeAppFirst />

  <!-- 7. The devices -->
  <Products />

  <!-- 8. How it works — Download. Connect. See. -->
  <HowItWorks />

  <!-- 9. Stats -->
  <Stats />

  <!-- 10. Social proof -->
  <Testimonials />

  <!-- 11. Final CTA -->
  <CTA />

  <Footer />
</Layout>
