---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import HomeWhy from '../components/HomeWhy.astro';
import Products from '../components/Products.astro';
import HomeConnect from '../components/HomeConnect.astro';
import HomePerks from '../components/HomePerks.astro';
import Testimonials from '../components/Testimonials.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "SeeMyHealth",
  alternateName: ["C-MyHealth", "See My Health", "SeeMyHealth AI", "See MyHealth"],
  url: "https://www.seemyhealth.ai",
  logo: "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg/logo/public",
  sameAs: [],
  description: "One app and a family of health devices built together. Track body composition, blood pressure, hydration, blood markers, heart rate, SpO2 and sleep, and bring in Apple Health or Health Connect. On iOS and Android.",
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "SeeMyHealth",
  alternateName: ["C-MyHealth", "See My Health", "SeeMyHealth AI", "See MyHealth"],
  url: "https://www.seemyhealth.ai",
};
---

<Layout
  title="SeeMyHealth | Hey. Your Body's Talking."
  description="One app for every health app you're juggling, plus a ring, scales, a BP monitor, a smart bottle and a blood analyser we built ourselves. Already have devices? Bring them. Your first month is on us."
  canonicalPath="/"
  jsonLd={[orgSchema, webSiteSchema]}
>
  <Navbar variant="transparent" />

  <!-- 1. Hero -->
  <Hero />

  <!-- 2. Why: many apps become one (Spline scene) -->
  <HomeWhy />

  <!-- 3. How we differ from aggregators: our own devices, each taking centre stage -->
  <Products />

  <!-- 4. Already have devices: Apple Health and Health Connect -->
  <HomeConnect />

  <!-- 5. Perks: privacy, community, family -->
  <HomePerks />

  <!-- 6. Early testers -->
  <Testimonials />

  <!-- 7. The offer: one month free -->
  <CTA />

  <Footer />
</Layout>
