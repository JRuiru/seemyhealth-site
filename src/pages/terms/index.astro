---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;
---

<Layout title="Terms of Use | SeeMyHealth" description="Terms of use for SeeMyHealth website, mobile application, and connected health devices." canonicalPath="/terms" noindex={true}>
  <Navbar />

  <!-- Hero -->
  <section class="pt-32 pb-16 sm:pt-40 sm:pb-20 bg-brand-black relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-white/[0.02] blur-[120px]"></div>
    </div>
    <div class="max-w-4xl mx-auto px-6 lg:px-8 relative z-10">
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">Legal</p>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-300 uppercase leading-[0.95] mb-6">
        Terms of <span class="font-500">Use</span>
      </h1>
      <p class="text-lg text-brand-gray-400 leading-relaxed max-w-xl">The rules of the road for using SeeMyHealth products, services, and platforms.</p>
      <p class="text-brand-gray-600 text-sm mt-4">Last updated: May 22, 2026</p>
    </div>
  </section>

  <!-- Important Notice -->
  <section class="py-8 bg-brand-dark border-t border-white/5">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class="rounded-xl bg-amber-500/5 border border-amber-500/10 p-5">
        <p class="text-amber-300 text-sm font-medium mb-2">Important Notice</p>
        <p class="text-sm text-brand-gray-400 leading-relaxed">These Terms of Use contain a binding arbitration clause and class action waiver (Section 12) that affect your legal rights. By using our services, you agree to resolve disputes through individual arbitration rather than court proceedings. Please read Section 12 carefully. EEA, UK, and Swiss residents are exempt from the arbitration clause.</p>
      </div>
    </div>
  </section>

  <!-- Content -->
  <section class="py-16 sm:py-24 bg-brand-black border-t border-white/5">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 space-y-16">

      <!-- 1. Acceptance -->
      <div>
        <h2 class="font-display text-2xl uppercase mb-4">1. Acceptance of Terms</h2>
        <div class="text-sm text-brand-gray-400 leading-relaxed space-y-4">
          <p>By accessing or using the SeeMyHealth website (seemyhealth.ai), our online store (shop.seemyhealth.ai), mobile application, or any SeeMyHealth device, you agree to be bound by these Terms of Use. If you do not agree, please do not use our services.</p>
          <p>These Terms of Use govern your use of our platforms and devices. For purchasing, payment, shipping, and return policies, please refer to our <a href="/terms/sale" class="text-white hover:underline">Terms of Sale</a>. For data handling practices, see our <a href="/privacy" class="text-white hover:underline">Privacy Policy</a>.</p>
          <p>If you are a minor under the age of majority in your country of residence, you should review these Terms with a parent or guardian before using our services.</p>
        </div>
      </div>

      <!-- 2. Account Registration -->
      <div>
        <h2 class="font-display text-2xl uppercase mb-4">2. Account Registration</h2>
        <div class="text-sm text-brand-gray-400 leading-relaxed space-y-4">
          <p>To access certain features, you may need to create a SeeMyHealth account. You agree to:</p>
          <ul class="list-disc list-inside space-y-2 pl-2">
            <li>Provide accurate, current, and complete information during registration</li>
            <li>Update your information to keep it accurate</li>
            <li>Maintain the confidentiality of your account credentials</li>
            <li>Accept responsibility for all activities that occur under your account</li>
            <li>Notify us immediately at <a href="mailto:support@seemyhealth.ai" class="text-white hover:underline">support@seemyhealth.ai</a> if you suspect unauthorized use</li>
          </ul>
          <p>We reserve the right to suspend or terminate accounts that violate these terms, contain inaccurate information, or show signs of fraudulent activity.</p>
        </div>
      </div>

      <!-- 3. Use of Services -->
      <div>
        <h2 class="font-display text-2xl uppercase mb-4">3. Use of Services</h2>
        <div class="text-sm text-brand-gray-400 leading-relaxed space-y-4">
          <p>We grant you a limited, non-exclusive, non-transferable, revocable license to use the SeeMyHealth website, app, and device firmware for your personal, non-commercial use in accordance with these terms.</p>
          <p><strong class="text-white">You agree not to:</strong></p>
          <ul class="list-disc list-inside space-y-2 pl-2">
            <li>Reverse-engineer, decompile, or disassemble any SeeMyHealth software or firmware</li>
            <li>Use automated tools (bots, scrapers, crawlers) to access our services</li>
            <li>Attempt to gain unauthorized access to our systems, networks, or other user accounts</li>
            <li>Use our services for any unlawful purpose or in violation of any applicable law</li>
            <li>Interfere with or disrupt the integrity or performance of our services</li>
            <li>Transmit malware, viruses, or other harmful code through our platforms</li>
            <li>Manipulate or falsify health data, activity results, or other metrics</li>
            <li>Resell, sublicense, or redistribute access to our services without authorization</li>
          </ul>
        </div>
      </div>

      <!-- 4. App Subscription -->
      <div>
        <h2 class="font-display text-2xl uppercase mb-4">4. App Subscription</h2>
        <div class="text-sm text-brand-gray-400 leading-relaxed space-y-4">
          <p>The SeeMyHealth app offers both free and premium subscription tiers. If you subscribe to a paid plan:</p>
          <ul class="list-disc list-inside space-y-2 pl-2">
            <li><strong class="text-white">Auto-renewal:</strong> Subscriptions automatically renew at the end of each billing period (monthly or annual) until you cancel</li>
            <li><strong class="text-white">Cancellation:</strong> You may cancel at any time through the app or by contacting support. Cancellation takes effect at the end of the current billing period — no prorated refunds for partial periods</li>
            <li><strong class="text-white">Free trial:</strong> If offered, free trials automatically convert to a paid subscription unless you cancel before the trial ends. You will be notified before conversion.</li>
            <li><strong class="text-white">Price changes:</strong> We will notify you at least 30 days before any subscription price increase. Continued use after the effective date constitutes acceptance of the new price.</li>
            <li><strong class="text-white">Feature access:</strong> Certain app features require an active subscription. If your subscription lapses, you retain access to your stored data but may lose access to premium features.</li>
          </ul>
          <p>Subscriptions purchased through the Apple App Store or Google Play Store are governed by the respective store's terms and refund policies.</p>
        </div>
      </div>

      <!-- 5. Health & Medical Disclaimer -->
      <div>
        <h2 class="font-display text-2xl uppercase mb-4">5. Health & Medical Disclaimer</h2>
        <div class="rounded-xl bg-red-500/5 border border-red-500/10 p-5 mb-4">
          <p class="text-red-300 text-xs font-medium uppercase tracking-wider mb-3">Important Health Information</p>
          <div class="text-sm text-brand-gray-400 leading-relaxed space-y-3">
            <p><strong class="text-white">SEEMYHEALTH DEVICES AND SERVICES ARE NOT MEDICAL DEVICES.</strong> They are consumer wellness products intended for general health and wellness monitoring only.</p>
            <p><strong class="text-white">NOT INTENDED TO DIAGNOSE, TREAT, CURE, OR PREVENT ANY DISEASE</strong> or medical condition. Data from our devices should not be used as the basis for medical decisions.</p>
            <p><strong class="text-white">NO DOCTOR-PATIENT RELATIONSHIP.</strong> Use of SeeMyHealth products and services does not constitute or create a doctor-patient, therapist-patient, or other healthcare professional relationship between you and SeeMyHealth.</p>
            <p><strong class="text-white">IN AN EMERGENCY, CALL YOUR LOCAL EMERGENCY NUMBER (e.g., 911) IMMEDIATELY.</strong> Do not rely on SeeMyHealth devices or the app for emergency medical situations.</p>
          </div>
        </div>
        <div class="text-sm text-brand-gray-400 leading-relaxed space-y-4">
          <p>Always consult a qualified healthcare professional before making any health-related decisions. Health data displayed by our devices and app is for informational purposes only and may not reflect your actual health status with clinical accuracy.</p>
          <p>If you use the SeeMyHealth app to share health data with a healthcare provider through our provider platform, the relationship is between you and that provider — SeeMyHealth is not a healthcare provider.</p>
        </div>
      </div>

      <!-- 6. Device Safety Warnings -->
      <div>
        <h2 class="font-display text-2xl uppercase mb-4">6. Device Safety & Wearable Warnings</h2>
        <div class="text-sm text-brand-gray-400 leading-relaxed space-y-4">
          <p><strong class="text-white">Skin irritation:</strong> Some users may experience skin irritation or contact dermatitis from wearing the Ring One or BP Monitor cuff for extended periods. If you experience persistent redness, swelling, itching, or irritation that lasts more than 2-3 days, discontinue use and consult a physician.</p>
          <p><strong class="text-white">Proper wear:</strong> For accurate readings, wear devices as described in the setup guides. Clean devices regularly and allow your skin to breathe by removing wearables periodically.</p>
          <p><strong class="text-white">Allergies:</strong> The Ring One is made from hypoallergenic titanium. The BP Monitor cuff uses medical-grade nylon. If you have known metal or textile allergies, review the materials list on the product page before purchasing.</p>
          <p><strong class="text-white">Small parts:</strong> SeeMyHealth devices contain small components. Keep away from children under 3 years of age due to choking hazard. The Hema One uses lancets and test strips — handle with care and dispose of responsibly per local biohazard regulations.</p>
          <p><strong class="text-white">Water resistance:</strong> Ring One is rated IP68 (up to 100m). Do not exceed rated depth or expose to high-pressure water. The Scale, BP Monitor, Hydra One, and Hema One are not water resistant — keep away from submersion.</p>
        </div>
      </div>

      <!-- 7. User Content -->
      <div>
        <h2 class="font-display text-2xl uppercase mb-4">7. User Content</h2>
        <div class="text-sm text-brand-gray-400 leading-relaxed space-y-4">
          <p>If you submit content to SeeMyHealth (reviews, feedback, community posts, support communications), you grant us a non-exclusive, worldwide, royalty-free license to use, display, and distribute that content in connection with our services.</p>
          <p>You retain ownership of your content and may request its removal at any time. We will not use your individual health data for marketing or advertising without your explicit consent.</p>
          <p>You agree not to submit content that is defamatory, obscene, threatening, infringing on third-party rights, or otherwise unlawful.</p>
        </div>
      </div>

      <!-- 8. Intellectual Property -->
      <div>
        <h2 class="font-display text-2xl uppercase mb-4">8. Intellectual Property</h2>
        <div class="text-sm text-brand-gray-400 leading-relaxed space-y-4">
          <p>All content on SeeMyHealth platforms — including text, graphics, logos, images, software, device firmware, hardware designs, and UI design — is the property of SeeMyHealth and is protected by applicable intellectual property laws.</p>
          <p>You may not reproduce, distribute, modify, create derivative works from, or reverse-engineer any SeeMyHealth content or technology without our prior written consent.</p>
          <p>The SeeMyHealth name, logo, Ring One, The Scale, Scale Pro, BP Monitor, Hydra One, and Hema One are trademarks of SeeMyHealth. Unauthorized use of our trademarks is prohibited.</p>
        </div>
      </div>

      <!-- 9. Disclaimer of Warranties -->
      <div>
        <h2 class="font-display text-2xl uppercase mb-4">9. Disclaimer of Warranties</h2>
        <div class="text-sm text-brand-gray-400 leading-relaxed space-y-4">
          <p>TO THE MAXIMUM EXTENT PERMITTED BY APPLICABLE LAW, SEEMYHEALTH PROVIDES ITS SERVICES, WEBSITE, APP, AND DEVICE SOFTWARE ON AN "AS IS" AND "AS AVAILABLE" BASIS WITHOUT WARRANTIES OF ANY KIND, WHETHER EXPRESS, IMPLIED, OR STATUTORY.</p>
          <p>WE DISCLAIM ALL IMPLIED WARRANTIES, INCLUDING BUT NOT LIMITED TO WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, AND NON-INFRINGEMENT.</p>
          <p>We do not warrant that our services will be uninterrupted, error-free, or free from harmful components, or that health data will be 100% accurate. Hardware products are covered by our separate <a href="/warranty" class="text-white hover:underline">Warranty Policy</a>.</p>
        </div>
      </div>

      <!-- 10. Limitation of Liability -->
      <div>
        <h2 class="font-display text-2xl uppercase mb-4">10. Limitation of Liability</h2>
        <div class="text-sm text-brand-gray-400 leading-relaxed space-y-4">
          <p>TO THE FULLEST EXTENT PERMITTED BY LAW, SEEMYHEALTH SHALL NOT BE LIABLE FOR ANY INDIRECT, INCIDENTAL, SPECIAL, CONSEQUENTIAL, OR PUNITIVE DAMAGES ARISING FROM YOUR USE OF OUR PRODUCTS OR SERVICES, INCLUDING BUT NOT LIMITED TO:</p>
          <ul class="list-disc list-inside space-y-2 pl-2">
            <li>Loss of data, profits, or revenue</li>
            <li>Personal injury or emotional distress</li>
            <li>Health decisions made based on device data</li>
            <li>Service interruptions or data loss</li>
            <li>Unauthorized access to your account</li>
          </ul>
          <p>OUR TOTAL LIABILITY FOR ANY CLAIM SHALL NOT EXCEED THE GREATER OF: (A) THE AMOUNT YOU PAID TO SEEMYHEALTH IN THE 12 MONTHS PRECEDING THE CLAIM, OR (B) $100 USD.</p>
          <p>This limitation does not apply to liability for death or personal injury caused by our negligence, fraud, or any liability that cannot be excluded under applicable law. Nothing in these terms limits your statutory rights as a consumer.</p>
        </div>
      </div>

      <!-- 11. Indemnification -->
      <div>
        <h2 class="font-display text-2xl uppercase mb-4">11. Indemnification</h2>
        <div class="text-sm text-brand-gray-400 leading-relaxed space-y-4">
          <p>You agree to indemnify and hold harmless SeeMyHealth, its officers, directors, employees, and agents from any claims, damages, losses, or expenses (including reasonable legal fees) arising from:</p>
          <ul class="list-disc list-inside space-y-2 pl-2">
            <li>Your violation of these Terms of Use</li>
            <li>Your violation of any applicable law or third-party rights</li>
            <li>Content you submit through our services</li>
            <li>Your misuse of our products or services</li>
          </ul>
        </div>
      </div>

      <!-- 12. Dispute Resolution -->
      <div>
        <h2 class="font-display text-2xl uppercase mb-4">12. Dispute Resolution & Arbitration</h2>
        <div class="text-sm text-brand-gray-400 leading-relaxed space-y-4">
          <p><strong class="text-white">Informal Resolution First:</strong> Before filing any formal dispute, you agree to contact us at <a href="mailto:legal@seemyhealth.ai" class="text-white hover:underline">legal@seemyhealth.ai</a> and attempt to resolve the matter informally for at least 45 days.</p>

          <p><strong class="text-white">Binding Arbitration:</strong> If the dispute is not resolved informally, you agree that it shall be resolved through binding individual arbitration administered by a mutually agreed-upon arbitration body, rather than in court. The arbitration shall be conducted in English.</p>

          <p><strong class="text-white">Class Action Waiver:</strong> YOU AGREE THAT ANY DISPUTE RESOLUTION PROCEEDINGS WILL BE CONDUCTED ONLY ON AN INDIVIDUAL BASIS AND NOT AS A CLASS, CONSOLIDATED, OR REPRESENTATIVE ACTION. If this waiver is found unenforceable, the entire arbitration clause shall be void.</p>

          <p><strong class="text-white">Opt-Out:</strong> You may opt out of this arbitration clause by sending written notice to <a href="mailto:legal@seemyhealth.ai" class="text-white hover:underline">legal@seemyhealth.ai</a> within 30 days of first agreeing to these terms. The opt-out notice must include your name, account email, and a clear statement that you wish to opt out.</p>

          <p><strong class="text-white">Exceptions:</strong> Either party may bring claims in small claims court if eligible. Either party may seek injunctive relief in court for intellectual property infringement.</p>

          <p><strong class="text-white">EEA/UK/Swiss Residents:</strong> If you are located in the European Economic Area, United Kingdom, or Switzerland, the arbitration clause does not apply to you. Disputes will be resolved in the courts of your country of residence, and you retain all rights to bring proceedings under your local consumer protection laws.</p>
        </div>
      </div>

      <!-- 13. Governing Law -->
      <div>
        <h2 class="font-display text-2xl uppercase mb-4">13. Governing Law</h2>
        <div class="text-sm text-brand-gray-400 leading-relaxed space-y-4">
          <p>For users outside the EEA/UK/Switzerland: these terms are governed by and construed in accordance with the laws of the State of Delaware, United States, without regard to conflict of law principles.</p>
          <p>For users in the EEA/UK/Switzerland: these terms are governed by the laws of your country of residence. Nothing in these terms limits your rights under applicable mandatory consumer protection legislation.</p>
        </div>
      </div>

      <!-- 14. Export Control -->
      <div>
        <h2 class="font-display text-2xl uppercase mb-4">14. Export Control</h2>
        <div class="text-sm text-brand-gray-400 leading-relaxed space-y-4">
          <p>SeeMyHealth products and software may be subject to export control laws of the United States and other jurisdictions. You agree not to export, re-export, or transfer our products or technology to any country, entity, or person prohibited by applicable export control laws, including those subject to U.S. trade sanctions.</p>
        </div>
      </div>

      <!-- 15. Termination -->
      <div>
        <h2 class="font-display text-2xl uppercase mb-4">15. Termination</h2>
        <div class="text-sm text-brand-gray-400 leading-relaxed space-y-4">
          <p>We may suspend or terminate your access to our services at any time for material breach of these terms, with notice where practicable. Upon termination:</p>
          <ul class="list-disc list-inside space-y-2 pl-2">
            <li>Your license to use our software and services is immediately revoked</li>
            <li>You may export your health data within 30 days of notice by contacting <a href="mailto:support@seemyhealth.ai" class="text-white hover:underline">support@seemyhealth.ai</a></li>
            <li>Sections that by their nature should survive termination (liability, indemnification, IP, arbitration) will continue to apply</li>
          </ul>
          <p>You may terminate your account at any time by deleting it through the app or contacting support.</p>
        </div>
      </div>

      <!-- 16. Changes -->
      <div>
        <h2 class="font-display text-2xl uppercase mb-4">16. Changes to These Terms</h2>
        <div class="text-sm text-brand-gray-400 leading-relaxed space-y-4">
          <p>We reserve the right to update these terms at any time. For material changes, we will notify registered users via email at least 30 days before the changes take effect. Continued use of our services following any changes constitutes acceptance of those changes.</p>
        </div>
      </div>

      <!-- 17. Contact -->
      <div>
        <h2 class="font-display text-2xl uppercase mb-4">17. Contact Us</h2>
        <div class="text-sm text-brand-gray-400 leading-relaxed space-y-4">
          <p>If you have questions about these Terms of Use:</p>
          <p>
            <strong class="text-white">Legal inquiries:</strong> <a href="mailto:legal@seemyhealth.ai" class="text-white hover:underline">legal@seemyhealth.ai</a><br />
            <strong class="text-white">General support:</strong> <a href="mailto:support@seemyhealth.ai" class="text-white hover:underline">support@seemyhealth.ai</a><br />
            <strong class="text-white">Website:</strong> <a href="https://seemyhealth.ai" class="text-white hover:underline">seemyhealth.ai</a>
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- Related Legal Pages -->
  <section class="py-14 sm:py-18 bg-brand-dark border-t border-white/5">
    <div class="max-w-3xl mx-auto px-6 lg:px-8 text-center">
      <p class="text-brand-gray-400 mb-6">Related legal documents</p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/terms/sale" class="inline-flex items-center px-6 py-3 text-[11px] uppercase tracking-[1.5px] font-medium text-white border border-white/20 rounded-full hover:border-white/40 transition-colors">Terms of Sale</a>
        <a href="/privacy" class="inline-flex items-center px-6 py-3 text-[11px] uppercase tracking-[1.5px] font-medium text-white border border-white/20 rounded-full hover:border-white/40 transition-colors">Privacy Policy</a>
        <a href="/warranty" class="inline-flex items-center px-6 py-3 text-[11px] uppercase tracking-[1.5px] font-medium text-white border border-white/20 rounded-full hover:border-white/40 transition-colors">Warranty</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
