---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;
---

<Layout title="Privacy Policy | SeeMyHealth" description="How SeeMyHealth protects your health data. Our privacy policy covers data collection, encryption, sharing, and your rights." canonicalPath="/privacy" noindex={true}>
  <Navbar />

  <!-- Hero -->
  <section class="pt-32 pb-16 sm:pt-40 sm:pb-20 bg-brand-black relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-blue-500/[0.03] blur-[120px]"></div>
    </div>
    <div class="max-w-4xl mx-auto px-6 lg:px-8 relative z-10">
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">Legal</p>
      <div class="flex items-start gap-5 mb-6">
        <div class="w-14 h-14 rounded-2xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center flex-shrink-0 mt-1 hidden sm:flex">
          <svg class="w-7 h-7 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
          </svg>
        </div>
        <div>
          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-300 uppercase leading-[0.95] mb-4">
            Privacy <span class="font-500">Policy</span>
          </h1>
          <p class="text-lg text-brand-gray-400 leading-relaxed max-w-xl">Your data is yours. Period. Here's exactly how we protect it.</p>
        </div>
      </div>
      <p class="text-brand-gray-600 text-sm">Last updated: May 10, 2026</p>
    </div>
  </section>

  <!-- Trust Promise Cards -->
  <section class="py-12 sm:py-16 bg-brand-dark border-t border-white/5">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="rounded-xl bg-brand-gray-900 border border-white/5 p-5 text-center">
          <div class="w-10 h-10 rounded-lg bg-blue-500/10 flex items-center justify-center mx-auto mb-3">
            <svg class="w-5 h-5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
            </svg>
          </div>
          <p class="text-xs text-white font-medium mb-1">Never Sold</p>
          <p class="text-[11px] text-brand-gray-500">We never sell your data. Ever.</p>
        </div>
        <div class="rounded-xl bg-brand-gray-900 border border-white/5 p-5 text-center">
          <div class="w-10 h-10 rounded-lg bg-blue-500/10 flex items-center justify-center mx-auto mb-3">
            <svg class="w-5 h-5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
            </svg>
          </div>
          <p class="text-xs text-white font-medium mb-1">Encrypted</p>
          <p class="text-[11px] text-brand-gray-500">End-to-end, in transit and at rest.</p>
        </div>
        <div class="rounded-xl bg-brand-gray-900 border border-white/5 p-5 text-center">
          <div class="w-10 h-10 rounded-lg bg-blue-500/10 flex items-center justify-center mx-auto mb-3">
            <svg class="w-5 h-5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
            </svg>
          </div>
          <p class="text-xs text-white font-medium mb-1">Delete Anytime</p>
          <p class="text-[11px] text-brand-gray-500">One tap in the app. Gone.</p>
        </div>
        <div class="rounded-xl bg-brand-gray-900 border border-white/5 p-5 text-center">
          <div class="w-10 h-10 rounded-lg bg-blue-500/10 flex items-center justify-center mx-auto mb-3">
            <svg class="w-5 h-5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" />
            </svg>
          </div>
          <p class="text-xs text-white font-medium mb-1">You're in Control</p>
          <p class="text-[11px] text-brand-gray-500">Toggle sharing on or off.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Policy Content -->
  <section class="py-16 sm:py-24 bg-brand-black border-t border-white/5">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 space-y-16">

      <!-- Intro -->
      <div class="text-sm text-brand-gray-400 leading-relaxed space-y-4">
        <p>SeeMyHealth ("we," "our," or "us") is committed to protecting your privacy. This Privacy Policy explains how we collect, use, share, and safeguard your information when you use our website (seemyhealth.ai), online store (shop.seemyhealth.ai), mobile application, and connected health devices.</p>
      </div>

      <!-- 1. Data Collection -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-9 h-9 rounded-lg bg-white/5 flex items-center justify-center flex-shrink-0">
            <svg class="w-4.5 h-4.5 text-brand-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
            </svg>
          </div>
          <h2 class="font-display text-2xl uppercase">1. Information We Collect</h2>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="rounded-xl bg-white/[0.02] border border-white/5 p-5">
            <h3 class="text-white text-sm font-medium mb-2">Personal Information</h3>
            <p class="text-sm text-brand-gray-400 leading-relaxed">Name, email address, shipping address, phone number, and payment details when you create an account or place an order.</p>
          </div>
          <div class="rounded-xl bg-white/[0.02] border border-white/5 p-5">
            <h3 class="text-white text-sm font-medium mb-2">Device & Health Data</h3>
            <p class="text-sm text-brand-gray-400 leading-relaxed">Health metrics from your devices — heart rate, blood pressure, blood oxygen, sleep, hydration, body composition, and blood biomarkers. Synced via the SeeMyHealth app.</p>
          </div>
          <div class="rounded-xl bg-white/[0.02] border border-white/5 p-5">
            <h3 class="text-white text-sm font-medium mb-2">Usage Data</h3>
            <p class="text-sm text-brand-gray-400 leading-relaxed">How you interact with our website, app, and devices — IP address, browser type, device identifiers, pages visited, and feature usage patterns.</p>
          </div>
          <div class="rounded-xl bg-white/[0.02] border border-white/5 p-5">
            <h3 class="text-white text-sm font-medium mb-2">Communications</h3>
            <p class="text-sm text-brand-gray-400 leading-relaxed">Records of support interactions, survey responses, and your marketing preferences.</p>
          </div>
        </div>
      </div>

      <!-- 2. How We Use Data -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-9 h-9 rounded-lg bg-white/5 flex items-center justify-center flex-shrink-0">
            <svg class="w-4.5 h-4.5 text-brand-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h2 class="font-display text-2xl uppercase">2. How We Use Your Data</h2>
        </div>
        <div class="text-sm text-brand-gray-400 leading-relaxed space-y-4">
          <p>We use your information to:</p>
          <ul class="list-disc list-inside space-y-2 pl-2">
            <li>Process orders, payments, and deliver products</li>
            <li>Provide and improve health tracking features in the SeeMyHealth app</li>
            <li>Personalize your experience and deliver relevant content</li>
            <li>Send transactional emails (order confirmations, shipping updates)</li>
            <li>Send marketing communications (with your consent)</li>
            <li>Analyze usage patterns to improve our products and services</li>
            <li>Ensure security and prevent fraud</li>
            <li>Comply with legal obligations</li>
          </ul>
        </div>
      </div>

      <!-- 3. Data Sharing -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-9 h-9 rounded-lg bg-white/5 flex items-center justify-center flex-shrink-0">
            <svg class="w-4.5 h-4.5 text-brand-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" />
            </svg>
          </div>
          <h2 class="font-display text-2xl uppercase">3. How We Share Your Data</h2>
        </div>
        <div class="text-sm text-brand-gray-400 leading-relaxed space-y-4">
          <div class="rounded-xl bg-blue-500/5 border border-blue-500/10 p-5 mb-4">
            <p class="text-blue-300 text-sm font-medium">We do not sell your personal or health data. Full stop.</p>
          </div>
          <p>We may share information with:</p>
          <ul class="list-disc list-inside space-y-2 pl-2">
            <li><strong class="text-white">Service providers</strong> who assist with order fulfillment, payment processing, and email delivery</li>
            <li><strong class="text-white">Analytics partners</strong> to help us understand usage and improve our products</li>
            <li><strong class="text-white">Legal authorities</strong> when required by law or to protect our rights</li>
          </ul>
          <p>All service providers are contractually obligated to protect your data and use it only for the purposes we specify.</p>
        </div>
      </div>

      <!-- 4. Third-Party Services -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-9 h-9 rounded-lg bg-white/5 flex items-center justify-center flex-shrink-0">
            <svg class="w-4.5 h-4.5 text-brand-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
            </svg>
          </div>
          <h2 class="font-display text-2xl uppercase">4. Third-Party Services</h2>
        </div>
        <div class="text-sm text-brand-gray-400 leading-relaxed space-y-4">
          <p>We use the following third-party services:</p>
          <div class="grid sm:grid-cols-2 gap-3">
            <div class="flex items-center gap-3 rounded-lg bg-white/[0.02] border border-white/5 px-4 py-3">
              <div class="w-2 h-2 rounded-full bg-green-400 flex-shrink-0"></div>
              <div>
                <p class="text-xs text-white font-medium">Shopify</p>
                <p class="text-[11px] text-brand-gray-500">E-commerce & payments</p>
              </div>
            </div>
            <div class="flex items-center gap-3 rounded-lg bg-white/[0.02] border border-white/5 px-4 py-3">
              <div class="w-2 h-2 rounded-full bg-yellow-400 flex-shrink-0"></div>
              <div>
                <p class="text-xs text-white font-medium">Google Analytics</p>
                <p class="text-[11px] text-brand-gray-500">Traffic analysis & insights</p>
              </div>
            </div>
            <div class="flex items-center gap-3 rounded-lg bg-white/[0.02] border border-white/5 px-4 py-3">
              <div class="w-2 h-2 rounded-full bg-purple-400 flex-shrink-0"></div>
              <div>
                <p class="text-xs text-white font-medium">Klaviyo</p>
                <p class="text-[11px] text-brand-gray-500">Email marketing</p>
              </div>
            </div>
            <div class="flex items-center gap-3 rounded-lg bg-white/[0.02] border border-white/5 px-4 py-3">
              <div class="w-2 h-2 rounded-full bg-blue-400 flex-shrink-0"></div>
              <div>
                <p class="text-xs text-white font-medium">SendGrid</p>
                <p class="text-[11px] text-brand-gray-500">Transactional email delivery</p>
              </div>
            </div>
          </div>
          <p>Each of these services has its own privacy policy. We encourage you to review their respective policies.</p>
        </div>
      </div>

      <!-- 5. Cookies -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-9 h-9 rounded-lg bg-white/5 flex items-center justify-center flex-shrink-0">
            <svg class="w-4.5 h-4.5 text-brand-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
            </svg>
          </div>
          <h2 class="font-display text-2xl uppercase">5. Cookies & Tracking</h2>
        </div>
        <div class="text-sm text-brand-gray-400 leading-relaxed space-y-4">
          <p>We use cookies and similar technologies to enhance your browsing experience, analyze site traffic, and understand user preferences. You can manage cookie preferences through your browser settings.</p>
          <p>Essential cookies are required for basic site functionality. Analytics and marketing cookies are used only with your consent where required by law.</p>
        </div>
      </div>

      <!-- 6. Data Security -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-9 h-9 rounded-lg bg-white/5 flex items-center justify-center flex-shrink-0">
            <svg class="w-4.5 h-4.5 text-brand-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
          </div>
          <h2 class="font-display text-2xl uppercase">6. Data Security</h2>
        </div>
        <div class="text-sm text-brand-gray-400 leading-relaxed space-y-4">
          <p>We implement industry-standard security measures to protect your data, including encryption in transit (TLS) and at rest, secure authentication, and regular security audits.</p>
          <p>While we take reasonable precautions, no method of electronic storage or transmission is 100% secure. We cannot guarantee absolute security of your data.</p>
        </div>
      </div>

      <!-- 7. Your Rights — Highlighted Cards -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-9 h-9 rounded-lg bg-blue-500/10 flex items-center justify-center flex-shrink-0">
            <svg class="w-4.5 h-4.5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
            </svg>
          </div>
          <h2 class="font-display text-2xl uppercase">7. Your Rights</h2>
        </div>
        <p class="text-sm text-brand-gray-400 mb-6">You're always in the driver's seat. Here's what you can do:</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <div class="rounded-xl bg-blue-500/5 border border-blue-500/10 p-5">
            <h3 class="text-white text-sm font-medium mb-1">Access</h3>
            <p class="text-xs text-brand-gray-400 leading-relaxed">Request a copy of all personal data we hold about you.</p>
          </div>
          <div class="rounded-xl bg-blue-500/5 border border-blue-500/10 p-5">
            <h3 class="text-white text-sm font-medium mb-1">Correct</h3>
            <p class="text-xs text-brand-gray-400 leading-relaxed">Fix inaccurate or incomplete data in your account.</p>
          </div>
          <div class="rounded-xl bg-blue-500/5 border border-blue-500/10 p-5">
            <h3 class="text-white text-sm font-medium mb-1">Delete</h3>
            <p class="text-xs text-brand-gray-400 leading-relaxed">Erase your personal data and account — one tap in the app.</p>
          </div>
          <div class="rounded-xl bg-blue-500/5 border border-blue-500/10 p-5">
            <h3 class="text-white text-sm font-medium mb-1">Control Access</h3>
            <p class="text-xs text-brand-gray-400 leading-relaxed">Grant or revoke data sharing with a single toggle.</p>
          </div>
          <div class="rounded-xl bg-blue-500/5 border border-blue-500/10 p-5">
            <h3 class="text-white text-sm font-medium mb-1">Opt Out</h3>
            <p class="text-xs text-brand-gray-400 leading-relaxed">Unsubscribe from marketing communications at any time.</p>
          </div>
          <div class="rounded-xl bg-blue-500/5 border border-blue-500/10 p-5">
            <h3 class="text-white text-sm font-medium mb-1">Withdraw Consent</h3>
            <p class="text-xs text-brand-gray-400 leading-relaxed">Revoke consent for data processing where applicable.</p>
          </div>
        </div>
        <p class="text-sm text-brand-gray-400 mt-5">To exercise any of these rights, contact us at <a href="mailto:support@seemyhealth.ai" class="text-white hover:underline">support@seemyhealth.ai</a>. We'll respond within 30 days.</p>
      </div>

      <!-- 8. Data Retention -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-9 h-9 rounded-lg bg-white/5 flex items-center justify-center flex-shrink-0">
            <svg class="w-4.5 h-4.5 text-brand-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h2 class="font-display text-2xl uppercase">8. Data Retention</h2>
        </div>
        <div class="text-sm text-brand-gray-400 leading-relaxed space-y-4">
