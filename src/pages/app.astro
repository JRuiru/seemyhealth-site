---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import AppStoreButtons from '../components/AppStoreButtons.astro';
import StoreName from '../components/StoreName.astro';
import HealthPlatformBadges from '../components/HealthPlatformBadges.astro';
import Testimonials from '../components/Testimonials.astro';

export const prerender = true;

const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "C-MyHealth",
  alternateName: ["SeeMyHealth", "See My Health", "SeeMyHealth App"],
  operatingSystem: "iOS, Android",
  applicationCategory: "HealthApplication",
  description: "C-MyHealth (by SeeMyHealth) unifies all your health devices into one dashboard. Track heart rate, sleep, body composition, blood pressure, hydration, blood markers, mood, journalling, and more.",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  author: {
    "@type": "Organization",
    name: "SeeMyHealth",
    url: "https://www.seemyhealth.ai",
  },
};

const CF_IMG = "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg";

// Why: each app on its own hears one word of what the body is saying. They arrive as three
// notifications, then fold into one from us.
const scattered = [
  { app: "Sleep", color: "#6366F1", icon: "M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z", line: "Your sleep app has no idea you skipped lunch." },
  { app: "Nutrition", color: "#22C55E", icon: "M3 3v7a3 3 0 006 0V3M6 3v18M17 3c-2 0-3 2-3 5s1 4 3 4v9", line: "Your nutrition app is still using last month's weight." },
  { app: "Steps", color: "#F59E0B", icon: "M13 2L3 14h9l-1 8 10-12h-9l1-8z", line: "And your step counter missed the week you've had." },
];

// What the app is, in three ideas, before what it does. `position` keeps a face in the crop where
// the photo is cut wider than it was shot (16:10 on a phone).
const pillars = [
  { title: "One home", text: "Today, at a glance. What you ate, how you slept, how much water you've had (be honest) and how you're feeling.", image: `${CF_IMG}/logging-food/public`, alt: "Woman checking the app on her phone at home", position: "object-top" },
  { title: "Your goals", text: "Your goals, not ours. Set what matters to you and watch the days tick it off. No guilt trips included.", image: `${CF_IMG}/app-goals-achieved/public`, alt: "A day's goals all met in the app", position: "object-top" },
  { title: "The long view", premium: true, text: "One bad day is just a bad day. Weeks and months of history show you what's actually going on.", image: `${CF_IMG}/scale-trend-tracking/public`, alt: "Weight and body composition trends over months" },
];

// The three ways to use it, each a section further down
const waysIn = [
  { label: "Just the app", short: "Just the app", href: "#inside" },
  { label: "With our devices", short: "Our devices", href: "#with-devices" },
  { label: "With your tracker", short: "Your tracker", href: "#your-watch" },
];

// What the app does on its own, in four themes; a tab shows one at a time. Logging is free; an
// item marked premium is one of the app's four PremiumFeatures (trends, meal planning, fasting,
// family data), so this list follows Features/Subscription in the iOS app. Each tab wears the app's
// own tab icon for that area: the Rive files in public/media/app-icons are copied unchanged from the
// iOS app's Resources/Icons.
type ThemeItem = { label: string; phone?: string | null; premium?: boolean };
type Theme = {
  key: string; icon: string; label: string; title: string; bold: string;
  text: string; short?: string; items: ThemeItem[]; image: string; alt: string;
};
const themes: Theme[] = [
  {
    key: "eat",
    icon: "nutrition",
    label: "Eat",
    title: "Eat.",
    bold: "Then tell us about it.",
    text: "Search it or scan it, and it's logged. Add your allergies and we'll flag any food or recipe that contains one, before it's on your plate. Browse recipes you'll actually cook, plan the week, and yes, water counts too.",
    // On a phone the words sit on the photo, so a long paragraph gets a short one there
    short: "Search it or scan it, and it's logged, with a flag on anything that contains one of your allergens. Water counts too.",
    // `phone` is the chip's label on a phone, where the chips sit under the photo and keep short; an item with
    // `phone: null` is left off there
    items: [
      { label: "Meal logging by search or barcode", phone: "Search & scan" },
      { label: "Allergen flags on foods and recipes", phone: "Allergen flags" },
      { label: "Water goals and reminders", phone: "Water goals" },
      { label: "Recipes to browse", phone: null },
      { label: "Meal plans and full recipes", phone: "Meal plans", premium: true },
      { label: "Fasting schedules", phone: "Fasting", premium: true },
    ],
    image: `${CF_IMG}/app-meal-logging/public`,
    alt: "Logging a meal in the SeeMyHealth app",
  },
  {
    key: "feel",
    icon: "my-health",
    label: "Feel",
    title: "Feel.",
    bold: "Then write it down.",
    text: "Quick mood check-ins and a journal that never judges your handwriting. Give it a few weeks and your good days start to show what they have in common.",
    items: [{ label: "Mood check-ins" }, { label: "Journalling" }, { label: "Habit streaks" }],
    image: `${CF_IMG}/app-mood-journal/public`,
    alt: "A mood check-in and journal entry in the app",
  },
  {
    key: "people",
    icon: "community",
    label: "Your people",
    title: "Your people.",
    bold: "All of them.",
    text: "Build your family circle, keep tabs on Mum (she'll pretend to mind), and drag your friends into a challenge or two.",
    items: [
      { label: "Your family circle", phone: "Family circle" },
      { label: "Groups and challenges with friends", phone: "Groups & challenges" },
      { label: "Your family's numbers, when they share", phone: "Family's numbers", premium: true },
    ],
    image: `${CF_IMG}/app-family-sharing/public`,
    alt: "Family members sharing their progress in the app",
  },
  {
    key: "care",
    icon: "providers",
    label: "Care",
    title: "Care.",
    bold: "When you want it.",
    text: "Book a provider, have a video visit in your pyjamas, and keep the follow-ups next to everything else.",
    items: [{ label: "Book a provider" }, { label: "Video visits" }, { label: "Follow-ups in the app" }],
    image: `${CF_IMG}/app-video-consultation/public`,
    alt: "A video visit with a care provider in the app",
  },
];

// Free and Premium, as the app draws the line: logging is free, reading back what it adds up to is
// Premium (Features/Subscription in the iOS app)
const tiers = [
  {
    name: "Free",
    price: "$0, always",
    items: [
      "Log meals, water, mood and your journal",
      "Food search and recipes to browse",
      "Today's sleep, steps and calories",
      "Every device's readings, and Apple Health or Health Connect",
      "Your family circle, groups and challenges",
    ],
  },
  {
    name: "Premium",
    price: "Everything free, plus",
    premium: true,
    items: [
      "Trends and history for every measure",
      "Meal plans and full recipes",
      "Fasting schedules",
      "Cycle tracking",
      "Your family's numbers, when they share",
    ],
  },
];

// A day with a few devices: what each one catches that a phone can't
const timeline = [
  {
    time: "6:30 AM",
    title: "Wake up",
    device: "Ring One",
    text: "Your night's already in: sleep stages and a recovery score, waiting with your coffee.",
    color: "#F97316",
    image: `${CF_IMG}/ring-sleep-insights-ad/public`,
  },
  {
    time: "7:00 AM",
    title: "Step on",
    device: "The Scale Pro",
    text: "Weight, muscle and fat, arm by arm, saved before you've found your socks.",
    color: "#3B82F6",
    image: `${CF_IMG}/scale-pro-using/public`,
  },
  {
    time: "7:20 AM",
    title: "Morning reading",
    device: "BP Monitor",
    text: "Wrap, press, done. It lines up next to last night's reading on its own.",
    color: "#EF4444",
    image: `${CF_IMG}/bp-morning-check/public`,
  },
  {
    time: "12:30 PM",
    title: "Halfway there",
    device: "Hydra One",
    text: "Half your water by lunch. The lid's glowing about it.",
    color: "#06B6D4",
    image: `${CF_IMG}/bottle-black-desk-work/public`,
  },
  {
    time: "6:00 PM",
    title: "At the gym",
    device: "The Scale Pro",
    text: "No scale at home? Use the gym's. Connect, step on, and the reading is yours alone.",
    color: "#3B82F6",
    image: `${CF_IMG}/scale-pro-white-gym/public`,
  },
  {
    time: "9:30 PM",
    title: "Day done",
    device: "App",
    text: "Water, steps and meals, all tucked in. You should be too.",
    color: "#737373",
    image: `${CF_IMG}/mood-tracking/public`,
  },
];

const faqs = [
  {
    q: "Why is the app called C-MyHealth instead of SeeMyHealth?",
    a: "Say it out loud. Same app, different name tag. SeeMyHealth makes it, and the App Store and Google Play list it as C-MyHealth, so that's the one to look for.",
  },
  {
    q: "What's free, and what's Premium?",
    a: "Everything you log is free, and stays free: meals, water, mood, your journal, today's sleep, steps and calories, every device's readings, groups and challenges. Premium is for the long view: trends and history, meal plans and full recipes, fasting, cycle tracking and your family's numbers. Your first month of Premium is on us, no strings.",
  },
  {
    q: "Is the app useful without a device?",
    a: "Yes, it's built to work on its own. Log meals by search or barcode, with a flag on anything that contains one of your allergens. Drink your water, check in on your mood, keep a journal, rope your family and friends into a challenge, and book care when you need it. Your phone already counts your steps, and your fitness tracker can chip in too. Devices are the bonus round: they add what a phone can't measure, like body composition, blood pressure and sleep stages.",
  },
  {
    q: "What happens if I add a device later?",
    a: "It slots straight in. Pair it and its readings land right next to everything you've already logged. No new account, no starting over, no awkward introductions.",
  },
  {
    q: "Do I need to own a device to use one?",
    a: "Nope. The Scale, The Scale Pro, BP Monitor and Hema One aren't tied to one account. At home, at the gym or at a friend's place: open the app, connect, and the reading lands in your profile, not theirs. Borrowing has never been so guilt-free.",
  },
  {
    q: "Will it work with my fitness tracker?",
    a: "Yes, and we've made our peace with it. The app reads from Apple Health on iPhone and Health Connect on Android, so your fitness tracker, your old scale and your running app can all show up. One tap on, one tap off. No hard feelings. Mostly.",
  },
  {
    q: "What happens to my data?",
    a: "No ads, and we don't sell it. Not now, not ever, not even for a really good offer. It's encrypted in transit (TLS 1.3) and at rest (AES-256), you pick who sees what, and you can delete the lot whenever you like.",
  },
];
---

<Layout title="C-MyHealth App | SeeMyHealth" description="Download C-MyHealth, the SeeMyHealth app for iOS and Android. Journalling, mood tracking, meal logging, recipes, and guided programs, no device required. Add devices for 24/7 vitals, sleep staging, and cross-device insights." ogImage="https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg/og-app/public" canonicalPath="/app" jsonLd={appSchema}>
  <Navbar />

  <!-- Hero -->
  <section class="relative min-h-screen overflow-hidden">
    <!-- Full-bleed background image -->
    <div class="absolute inset-0">
      <img
        src={`${CF_IMG}/app-hero-triple-phones/public`}
        alt="SeeMyHealth app, meals, health hub, and sleep tracking screens"
        class="w-full h-full object-cover object-center"
      />
      <!-- Gradient overlay — darkens bottom and edges for text legibility -->
      <div class="absolute inset-0 bg-gradient-to-t from-brand-black via-brand-black/60 to-brand-black/30"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-brand-black/50 via-transparent to-transparent"></div>
    </div>

    <!-- Text content — centered at bottom over image -->
    <div class="relative min-h-screen flex items-end pb-20 pt-24">
      <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
        <div class="backdrop-blur-xl bg-white/[0.04] border border-white/[0.08] rounded-2xl sm:rounded-3xl px-5 py-6 sm:px-12 sm:py-14 shadow-2xl shadow-black/20 animate-[glassFadeIn_0.6s_ease-out_forwards]">
          <div class="opacity-0 animate-[contentFadeIn_0.5s_ease-out_0.4s_forwards]">
            <p class="text-[10px] sm:text-[11px] uppercase tracking-[4px] text-white/50 mb-3 sm:mb-5">The SeeMyHealth App</p>
            <h1 class="font-display text-3xl sm:text-5xl lg:text-6xl xl:text-7xl font-300 uppercase leading-[0.95] mb-3 sm:mb-6">
              Works from <span class="font-500 italic">day one.</span>{' '}<br class="hidden sm:block" />
              Smarter with devices.
            </h1>
            <p class="text-sm sm:text-lg text-white/60 leading-relaxed mb-5 sm:mb-8 max-w-2xl mx-auto">
              Start with journalling, mood, meals, and guided programs. No hardware needed. Add devices when you're ready.
            </p>
            <div>
              <AppStoreButtons class="justify-center" />
              <StoreName bold class="justify-center mt-5" />
              <p class="text-[12px] text-white/30 mt-2">Free to download. Premium free for a month.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why: every other app hears one word of what the body says -->
  <section class="py-24 sm:py-36 bg-brand-black border-t border-white/5">
    <div class="max-w-3xl mx-auto px-6 lg:px-8 text-center">
      <div class="notifs relative mx-auto max-w-sm text-left mb-12 sm:mb-16" data-notifs aria-label="Three apps, each with one piece of the story">
        {scattered.map((n, i) => (
          <div class="notif notif-app" style={`--i: ${i}`}>
            <span class="w-9 h-9 rounded-[10px] shrink-0 flex items-center justify-center" style={`background: ${n.color}`}>
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={n.icon} /></svg>
            </span>
            <span class="min-w-0 flex-1">
              <span class="flex items-center justify-between text-[11px] uppercase tracking-[1px] text-white/50 mb-0.5"><span>{n.app}</span><span class="normal-case tracking-normal">now</span></span>
              <span class="block text-[14px] leading-snug text-white">{n.line}</span>
            </span>
          </div>
        ))}
        <!-- Ours arrives on top once the three have folded behind it -->
        <div class="notif notif-us">
          <img src={`${CF_IMG}/logo/public`} alt="" class="w-9 h-9 rounded-[10px] shrink-0" />
          <span class="min-w-0 flex-1">
            <span class="flex items-center justify-between text-[11px] uppercase tracking-[1px] text-white/50 mb-0.5"><span>SeeMyHealth</span><span class="normal-case tracking-normal">now</span></span>
            <span class="block text-[14px] leading-snug text-white">Psst. We heard all three. Want the whole sentence?</span>
          </span>
        </div>
      </div>
      <div data-scroll-reveal>
        <h2 class="font-display text-4xl sm:text-6xl font-300 uppercase leading-[0.95] mb-6 text-balance">
          Each one hears a word.<br /> <span class="font-500">Nobody hears the sentence.</span>
        </h2>
        <p class="text-brand-gray-400 sm:text-lg leading-relaxed text-pretty">
          Your body keeps dropping hints, and they only make sense together. SeeMyHealth puts them side by side, so that 4pm coffee finally gets caught next to the bad night. No diagnosis, no lecture. Just a clearer view of you (and maybe fewer 4pm coffees).
        </p>
      </div>
    </div>
  </section>

  <!-- What the app is, before what it does -->
  <section class="py-20 sm:py-28 bg-brand-dark border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-14 sm:mb-16" data-scroll-reveal>
        <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">The app</p>
        <h2 class="font-display text-4xl sm:text-6xl font-300 uppercase leading-[0.95] mb-6 text-balance">
          One app. <span class="font-500">All of you.</span>
        </h2>
        <p class="text-brand-gray-400 sm:text-lg leading-relaxed text-pretty">
          Sleep, meals, mood, water, weight. Right now they're scattered across a dozen apps and one very old notes file. SeeMyHealth puts them on one screen, so you can finally see how it all fits.
        </p>
      </div>
      <div class="grid sm:grid-cols-3 gap-4 sm:gap-6" data-scroll-stagger>
        {pillars.map((pillar, i) => (
          <div class="rounded-2xl border border-white/5 bg-white/[0.02] overflow-hidden">
            <div class="relative aspect-[16/10] sm:aspect-[4/3] bg-brand-gray-900">
              <img src={pillar.image} alt={pillar.alt} class:list={["absolute inset-0 w-full h-full object-cover", pillar.position]} loading="lazy" />
              <span class="absolute top-4 left-4 text-[11px] uppercase tracking-[3px] text-white/80 bg-black/40 backdrop-blur-md px-2.5 py-1 rounded-full">0{i + 1}</span>
              {pillar.premium && <span class="absolute top-4 right-4 text-[10px] uppercase tracking-[1.5px] text-amber-200 bg-black/50 backdrop-blur-md border border-amber-300/30 px-2.5 py-1 rounded-full">Premium</span>}
              <!-- The title sits on the photo in glass, so the card is only as tall as its photo and a line or two -->
              <h3 class="absolute left-3 bottom-3 px-4 py-2 rounded-xl bg-black/35 backdrop-blur-xl border border-white/15 font-display text-xl sm:text-2xl font-400 uppercase leading-tight">{pillar.title}</h3>
            </div>
            <div class="px-5 py-4 sm:px-6 sm:py-5">
              <p class="text-sm text-brand-gray-400 leading-relaxed text-pretty">{pillar.text}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="mt-14 sm:mt-16 text-center" data-scroll-reveal>
        <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-5">Pick your way in</p>
        <!-- Three equal blocks in a row, the same blocks as the themes' column -->
        <div class="grid grid-cols-3 gap-2 sm:gap-3 max-w-xl mx-auto">
          {waysIn.map((way) => (
            <a href={way.href} class="flex flex-col items-center justify-center gap-2 sm:gap-2.5 px-2 py-4 sm:py-6 rounded-xl sm:rounded-2xl border border-white/15 bg-white/[0.03] text-[11px] sm:text-[12px] leading-tight uppercase tracking-[1.2px] sm:tracking-[1.5px] font-medium text-white text-center hover:border-white/40 hover:bg-white/[0.06] transition-colors">
              <span class="min-h-[2.5em] sm:min-h-0 flex items-center">{way.short}</span>
              <span class="text-white/50 text-sm sm:text-base leading-none" aria-hidden="true">&darr;</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- What's inside: the app on its own, one theme at a time -->
  <section id="inside" class="scroll-mt-28 sm:scroll-mt-32 py-20 sm:py-28 bg-brand-black border-t border-white/5" data-themes data-way>
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="mb-10 sm:mb-12 max-w-2xl" data-scroll-reveal>
        <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">Just the app</p>
        <h2 class="font-display text-4xl sm:text-5xl font-300 uppercase leading-[0.95] text-balance">
          Start with just the app. <span class="font-500">No shopping required.</span>
        </h2>
      </div>

      <!-- Never drawn like the pill bar of the three ways in: the themes are a column of blocks down
           the left, the one showing in white -->
      <div class="flex gap-3 md:gap-8">
      <div class="flex flex-col gap-1.5 md:gap-2 w-[72px] md:w-24 shrink-0" role="tablist" aria-label="What's in the app">
        {themes.map((t, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${t.key}`}
            aria-controls={`panel-${t.key}`}
            aria-selected={i === 0 ? "true" : "false"}
            data-theme-tab={t.key}
            class="group relative overflow-hidden flex flex-col items-center justify-center gap-1.5 md:gap-2 h-[74px] md:h-24 px-1 rounded-xl md:rounded-2xl border border-white/10 bg-white/[0.04] text-[9px] md:text-[10px] uppercase tracking-[1px] md:tracking-[1.2px] font-medium leading-tight text-center text-white/60 hover:border-white/25 aria-selected:bg-white aria-selected:border-white aria-selected:text-brand-black transition-colors"
          >
            <span class="w-7 h-7 opacity-80 group-aria-selected:opacity-100 transition-opacity" aria-hidden="true">
              <canvas class="w-7 h-7" width="56" height="56" data-tab-icon={t.icon} hidden></canvas>
            </span>
            {t.label}
            <span class="absolute inset-x-0 bottom-0 h-[3px] bg-current opacity-40 origin-left scale-x-0" data-tab-progress aria-hidden="true"></span>
          </button>
        ))}
      </div>

      <!-- The panels share one grid cell, so the section keeps the tallest one's height and nothing
           below it jumps when a theme changes -->
      <div class="grid flex-1 min-w-0">
      {themes.map((t, i) => (
        <div
          id={`panel-${t.key}`}
          role="tabpanel"
          aria-labelledby={`tab-${t.key}`}
          data-theme-panel={t.key}
          inert={i !== 0}
          class:list={["[grid-area:1/1] grid md:grid-cols-2 gap-4 md:gap-12 items-start md:items-center transition-opacity duration-500 inert:opacity-0 inert:pointer-events-none"]}
        >
          <!-- On a phone the words sit on the photo in a glass panel and the list becomes chips, so a
               theme fits about one screen; from a tablet up the words sit beside the photo -->
          <div class="relative aspect-[4/5] min-h-[314px] md:min-h-0 max-w-full rounded-3xl overflow-hidden bg-brand-gray-900 border border-white/5">
            <img src={t.image} alt={t.alt} class="absolute inset-0 w-full h-full object-cover" loading={i === 0 ? "eager" : "lazy"} />
            <div class="md:hidden absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black/70 to-transparent" aria-hidden="true"></div>
            <div class="md:hidden absolute inset-x-2 bottom-2 p-3.5 rounded-2xl bg-black/35 backdrop-blur-xl border border-white/15">
              <h3 class="font-display text-xl font-300 uppercase leading-[0.95] mb-1.5 text-balance">
                {t.title} <span class="font-500">{t.bold}</span>
              </h3>
              <p class="text-[13px] text-white/75 leading-snug text-pretty">{t.short ?? t.text}</p>
            </div>
          </div>
          <div class="min-w-0">
            <div class="hidden md:block">
              <h3 class="font-display text-4xl font-300 uppercase leading-[0.95] mb-4 text-balance">
                {t.title} <span class="font-500">{t.bold}</span>
              </h3>
              <p class="text-brand-gray-400 leading-relaxed mb-6 text-pretty">{t.text}</p>
            </div>
            <ul class="flex flex-wrap gap-1.5 md:flex-col md:flex-nowrap md:gap-3">
              {t.items.map((item) => (
                <li class:list={[
                  item.phone === null && "hidden md:flex",
                  "flex items-center gap-1.5 md:gap-3 text-[12px] md:text-sm text-brand-gray-300 rounded-full border px-2.5 py-1 md:p-0 md:border-0 md:rounded-none",
                  item.premium ? "border-amber-300/30" : "border-white/10",
                ]}>
                  <span class="hidden md:block w-1.5 h-1.5 rounded-full bg-white/60 shrink-0"></span>
                  {item.phone ? <><span class="md:hidden">{item.phone}</span><span class="hidden md:inline">{item.label}</span></> : item.label}
                  {/* On a phone a Premium chip says so with its gold edge and a star, so the chips stay short */}
