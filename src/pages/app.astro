<script>
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

  // The Rive runtime, fetched the first time a section that animates with it comes near, with its
  // wasm served from this site. Every caller shares the one load.
  let riveLoad: Promise<typeof import('@rive-app/canvas-lite')> | undefined;
  const loadRive = () => riveLoad ??= Promise.all([
    import('@rive-app/canvas-lite'),
    import('@rive-app/canvas-lite/rive.wasm?url'),
  ]).then(([runtime, { default: wasmUrl }]) => {
    runtime.RuntimeLoader.setWasmUrl(wasmUrl);
    return runtime;
  });

  // Billing toggle: both plans are priced per month or per year, and the figures roll to the new
  // period rather than jumping
  const PRICE_ROLL_MS = 600;
  const money = (v: number, cents: boolean) => `$${cents ? v.toFixed(2) : Math.round(v)}`;
  const roll = (el: HTMLElement, from: number, to: number) => {
    const cents = !Number.isInteger(to);
    if (reducedMotion) { el.textContent = money(to, cents); return; }
    const start = performance.now();
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / PRICE_ROLL_MS);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = money(from + (to - from) * eased, cents);
      if (t < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };
  const toggle = document.getElementById('billing-toggle');
  const knob = document.getElementById('billing-knob');
  const labelMonthly = document.getElementById('label-monthly');
  const labelAnnual = document.getElementById('label-annual');
  const cardMonthly = document.getElementById('card-monthly');
  const cardAnnual = document.getElementById('card-annual');
  let isAnnual = false;

  toggle?.addEventListener('click', () => {
    isAnnual = !isAnnual;
    knob?.classList.toggle('translate-x-6', isAnnual);
    toggle.classList.toggle('bg-green-500', isAnnual);
    toggle.classList.toggle('bg-white/10', !isAnnual);
    labelMonthly?.classList.toggle('text-white', !isAnnual);
    labelAnnual?.classList.toggle('text-white', isAnnual);
    toggle.setAttribute('aria-pressed', String(isAnnual));
    document.querySelectorAll<HTMLElement>('[data-price]').forEach((el) => {
      const month = Number(el.dataset.month), year = Number(el.dataset.year);
      roll(el, isAnnual ? month : year, isAnnual ? year : month);
    });
    document.querySelectorAll<HTMLElement>('[data-per]').forEach((el) => { el.textContent = isAnnual ? '/year' : '/month'; });
    document.querySelectorAll<HTMLElement>('[data-note]').forEach((el) => {
      el.textContent = (isAnnual ? el.dataset.yearNote : el.dataset.monthNote) ?? '';
    });

    if (isAnnual) {
      cardAnnual?.classList.add('border-green-500/30', 'scale-[1.02]');
      cardAnnual?.classList.remove('border-white/10');
      cardMonthly?.classList.add('opacity-70');
    } else {
      cardAnnual?.classList.remove('border-green-500/30', 'scale-[1.02]');
      cardAnnual?.classList.add('border-white/10');
      cardMonthly?.classList.remove('opacity-70');
    }
  });

  // Our devices: each card's "Saved to the app" ticks in as the card comes into view, one after
  // another when several arrive together. The chips stay put without script or with reduced motion.
  const SAVED_STAGGER_MS = 180;
  const chips = Array.from(document.querySelectorAll<HTMLElement>('[data-saved-chip]'));
  if (!reducedMotion && chips.length) {
    chips.forEach((c) => { c.dataset.pending = ''; });
    const saved = new IntersectionObserver((entries) => {
      entries.filter((e) => e.isIntersecting).forEach((e, i) => {
        const chip = e.target as HTMLElement;
        saved.unobserve(chip);
        setTimeout(() => { delete chip.dataset.pending; }, i * SAVED_STAGGER_MS);
      });
    }, { threshold: 1 });
    chips.forEach((c) => saved.observe(c));
  }

  // Why: three notifications arrive one by one, fold behind each other, and ours lands on top.
  // It plays again whenever the stack comes back into view, from either direction; with reduced
  // motion it starts folded and stays that way.
  const notifs = document.querySelector<HTMLElement>('[data-notifs]');
  if (notifs) {
    const NOTIF_GAP_MS = 700;      // between one app's notification and the next
    const HOLD_MS = 1600;          // all three on screen, long enough to read
    const OURS_AFTER_FOLD_MS = 450;
    const apps = Array.from(notifs.querySelectorAll<HTMLElement>('.notif-app'));
    let timers: number[] = [];
    let played = false;
    const later = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    const play = () => {
      played = true;
      delete notifs.dataset.state;
      apps.forEach((n, i) => later(i * NOTIF_GAP_MS, () => n.classList.add('is-in')));
      const fold = apps.length * NOTIF_GAP_MS + HOLD_MS;
      later(fold, () => { notifs.dataset.state = 'folded'; });
      later(fold + OURS_AFTER_FOLD_MS, () => { notifs.dataset.state = 'ours'; });
    };
    // Off screen, the stack empties at its folded height, the height it already has once played,
    // so emptying it never moves the page; it opens back out to the list on screen, as it plays.
    const reset = () => {
      timers.forEach(clearTimeout);
      timers = [];
      played = false;
      apps.forEach((n) => n.classList.remove('is-in'));
      notifs.dataset.state = 'reset';
    };
    if (reducedMotion) {
      notifs.querySelectorAll('.notif-app').forEach((n) => n.classList.add('is-in'));
      notifs.dataset.state = 'ours';
    } else {
      new IntersectionObserver((entries) => {
        const e = entries[entries.length - 1];
        if (!e.isIntersecting) { if (played) reset(); }
        else if (e.intersectionRatio >= 0.6 && !played) play();
      }, { threshold: [0, 0.6] }).observe(notifs);
    }
  }

  // What's inside: one theme at a time. While the section is on screen the themes take turns,
  // each tab filling a line as it waits; the first tap hands control to the reader for good.
  const themeTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-theme-tab]'));
  const themePanels = Array.from(document.querySelectorAll<HTMLElement>('[data-theme-panel]'));
  const THEME_SECONDS = 5;
  let themeTimer = 0;
  // The tab icons: the app's own, black on the white block of the theme showing and white on the
  // rest; the one that comes up
  // plays its moment, as it does when that tab is picked in the app. They load
  // only when the section is near, never with Data Saver, and hold still with reduced motion.
  type TabIcon = { tab: HTMLButtonElement; show: (selected: boolean) => void };
  const tabIcons: TabIcon[] = [];
  const iconCanvases = Array.from(document.querySelectorAll<HTMLCanvasElement>('[data-tab-icon]'));
  const themesNear = document.querySelector('[data-themes]');
  if (themesNear && iconCanvases.length && !saveData) {
    const loadIcons = new IntersectionObserver(async (entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      loadIcons.disconnect();
      const { Rive } = await loadRive();
      iconCanvases.forEach((canvas) => {
        const tab = canvas.closest<HTMLButtonElement>('[data-theme-tab]');
        if (!tab) return;
        const icon = new Rive({
          canvas,
          src: `/media/app-icons/${canvas.dataset.tabIcon}.riv`,
          stateMachine: 'State Machine 1',
          autoplay: true,
          autoBind: true,
          onLoad: () => {
            icon.resizeDrawingSurfaceToCanvas();
            let selected = false;
            const ink = icon.viewModelInstance?.boolean('isLightMode');
            const inkFor = (now: boolean) => { if (ink) ink.value = now; };
            const show = (now: boolean) => {
              inkFor(now);
              if (now && !selected && !reducedMotion) icon.viewModelInstance?.trigger('play')?.trigger();
              selected = now;
            };
            show(tab.getAttribute('aria-selected') === 'true');
            tabIcons.push({ tab, show });
            canvas.hidden = false;
          },
        });
      });
    }, { rootMargin: '400px 0px' });
    loadIcons.observe(themesNear);
  }
  let themesAuto = !reducedMotion;
  const showTheme = (tab: HTMLButtonElement) => {
    const key = tab.dataset.themeTab;
    themeTabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
    themePanels.forEach((p) => { p.inert = p.dataset.themePanel !== key; });
    tabIcons.forEach((icon) => icon.show(icon.tab === tab));
    // On a phone the tabs scroll sideways; keep the one showing in sight, without moving the page
    tab.parentElement?.scrollTo({ left: tab.offsetLeft - 24, behavior: 'smooth' });
  };
  const resetProgress = () => themeTabs.forEach((t) => {
    const bar = t.querySelector<HTMLElement>('[data-tab-progress]');
    if (bar) { bar.style.transition = 'none'; bar.style.transform = 'scaleX(0)'; }
  });
  const runProgress = (tab: HTMLButtonElement) => {
    const bar = tab.querySelector<HTMLElement>('[data-tab-progress]');
    if (!bar) return;
    void bar.offsetWidth;   // start from empty
    bar.style.transition = `transform ${THEME_SECONDS}s linear`;
    bar.style.transform = 'scaleX(1)';
  };
  const stopThemes = () => { clearTimeout(themeTimer); resetProgress(); };
  const nextTheme = () => {
    const current = themeTabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
    const tab = themeTabs[(current + 1) % themeTabs.length];
    showTheme(tab);
    startThemes();
  };
  const startThemes = () => {
    stopThemes();
    if (!themesAuto) return;
    const current = themeTabs.find((t) => t.getAttribute('aria-selected') === 'true');
    if (current) runProgress(current);
    themeTimer = window.setTimeout(nextTheme, THEME_SECONDS * 1000);
  };
  themeTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      themesAuto = false;
      stopThemes();
      showTheme(tab);
    });
  });
  const themesSection = document.querySelector('[data-themes]');
  if (themesSection) {
    new IntersectionObserver((entries) => {
      if (entries[entries.length - 1].isIntersecting) startThemes();
      else stopThemes();
    }, { threshold: 0.35 }).observe(themesSection);
  }

  // The ways bar: shown while one of the three ways is under the reading line, that one lit up
  const waysBar = document.querySelector<HTMLElement>('[data-ways-bar]');
  const wayLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-way-link]'));
  const waySections = Array.from(document.querySelectorAll<HTMLElement>('[data-way]'));
  if (waysBar && waySections.length) {
    const inView = new Set<string>();
    const reading = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) inView.add(e.target.id); else inView.delete(e.target.id); });
      const current = waySections.find((sec) => inView.has(sec.id))?.id;
      waysBar.classList.toggle('opacity-0', !current);
      waysBar.classList.toggle('-translate-y-2', !current);
      wayLinks.forEach((a) => a.setAttribute('aria-current', String(a.dataset.wayLink === current)));
    }, { rootMargin: '-40% 0px -55% 0px' });
    waySections.forEach((sec) => reading.observe(sec));
  }

  // The phone bar: after the hero, until the closing buttons are in view
  const getBar = document.querySelector<HTMLElement>('[data-get-bar]');
  const heroSection = document.querySelector('section');   // the hero is the page's first section
  const ctaEnd = document.querySelector('[data-cta-end]');
  if (getBar && heroSection && ctaEnd) {
    let pastHero = false;
    let atEnd = false;
    const update = () => getBar.classList.toggle('translate-y-full', !pastHero || atEnd);
    new IntersectionObserver(([e]) => { pastHero = !e.isIntersecting; update(); }).observe(heroSection);
    new IntersectionObserver(([e]) => { atEnd = e.isIntersecting || e.boundingClientRect.top < 0; update(); }).observe(ctaEnd);
  }

  // Still here? Need a hand? The thumb. Its runtime and file load only when this section is near, never
  // with reduced motion or Data Saver. It visits each time the section comes back into view, until
  // somebody taps the section.
  const ctaSection = document.querySelector<HTMLElement>('[data-cta-end]');
  const thumbCanvas = document.querySelector<HTMLCanvasElement>('[data-cta-thumb]');
  const [ctaButton, otherButton] = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-cta-buttons] a'));
  if (ctaSection && thumbCanvas && ctaButton && otherButton && !reducedMotion && !saveData) {
    const ART_W = 640, ART_H = 440;
    const TAP_X = 150, TAP_Y = 200;   // the fingertip's tap point on the artboard
    // How far the hand reaches right of the fingertip, at the tap and while pointing (artboard units,
    // rive/cta-thumb/README.md), and how far the file can point (beyond, the fingertip leaves it)
    const REACH_AT_TAP = 120, REACH_POINTING = 158;
    const MAX_POINT_X = 335, MAX_POINT_Y = 135;
    const PLAY_SECONDS = 3.8;         // the thumb's whole visit, then it hides until the next one
    let tapped = false;
    // Lines the artboard's tap point up with the centre of the first button (iOS) and tells the file
    // where the second (Android) is, to point at first. Measured afresh before every visit and when
    // the section changes size: wherever the buttons have moved to since the file loaded, from a
    // phone stacking them to fonts and images arriving late. On a narrow screen the thumb shrinks
    // until the hand fits on screen at both buttons.
    const place = (thumb?: { viewModelInstance?: { number: (n: string) => { value: number } | null } | null }) => {
      const s = ctaSection.getBoundingClientRect();
      const b = ctaButton.getBoundingClientRect();
      const o = otherButton.getBoundingClientRect();
      const cx = b.left + b.width / 2, cy = b.top + b.height / 2;
      const ox = o.left + o.width / 2, oy = o.top + o.height / 2;
      const room = innerWidth - 12;
      // Never bigger than a real thumb would look beside the buttons: full size from about 560px wide
      let k = Math.min(1, innerWidth / 560, (room - cx) / REACH_AT_TAP, (room - ox) / REACH_POINTING);
      // Never so small that the other button is out of the file's reach
      k = Math.max(k, Math.abs(ox - cx) / MAX_POINT_X, Math.abs(oy - cy) / MAX_POINT_Y, 0.4);
      thumbCanvas.style.width = `${ART_W * k}px`;
      thumbCanvas.style.height = `${ART_H * k}px`;
      thumbCanvas.style.left = `${cx - s.left - TAP_X * k}px`;
      thumbCanvas.style.top = `${cy - s.top - TAP_Y * k}px`;
      const vm = thumb?.viewModelInstance;
      const px = vm?.number('pointX'), py = vm?.number('pointY');
      if (px) px.value = (ox - cx) / k;
      if (py) py.value = (oy - cy) / k;
    };
    const press = () => {
      ctaButton.style.transition = 'transform 120ms ease-out';
      ctaButton.style.transform = 'scale(0.94)';
      setTimeout(() => { ctaButton.style.transform = ''; }, 160);
    };
    // Somebody who taps the section needs no more demonstrations. A click, never a pointerdown: on a
    // phone the finger that scrolls the page into this section lands on it, and the thumb never came.
    ctaSection.addEventListener('click', () => { tapped = true; }, { once: true });
    const loader = new IntersectionObserver(async (entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      loader.disconnect();
      const { Rive, Layout, Fit } = await loadRive();
      const thumb = new Rive({
        canvas: thumbCanvas,
        src: '/media/cta-thumb.riv',
        artboard: 'CtaThumb',
        stateMachine: 'CtaThumb',
        autoplay: true,
        // The file's view model: `play`, `skip` and where to point (`pointX`, `pointY`) go in,
        // `tapped` comes back at the press
        autoBind: true,
        layout: new Layout({ fit: Fit.Contain }),
        onLoad: () => {
          const replace = () => { place(thumb); thumb.resizeDrawingSurfaceToCanvas(); };
          replace();
          new ResizeObserver(replace).observe(ctaSection);
          thumb.viewModelInstance?.trigger('tapped')?.on(press);
          // A visit starts once the section is mostly on screen, so the joke lands where it can be
          // seen, and the next one waits for the section to leave the screen and come back. Between
          // visits the canvas is hidden and the file paused.
          let visiting = false;
          let away = true;
          const visit = () => {
            visiting = true;
            away = false;
            replace();
            thumbCanvas.hidden = false;
            thumb.play();
            thumb.viewModelInstance?.trigger('play')?.trigger();
            setTimeout(() => {
              visiting = false;
              thumbCanvas.hidden = true;
              thumb.pause();
            }, PLAY_SECONDS * 1000);
          };
          new IntersectionObserver((seen) => {
            const e = seen[seen.length - 1];
            if (!e.isIntersecting) away = true;
            else if (e.intersectionRatio >= 0.7 && away && !visiting && !tapped) visit();
          }, { threshold: [0, 0.7] }).observe(ctaSection);
        },
      });
      ctaSection.addEventListener('click', () => {
        thumb.viewModelInstance?.trigger('skip')?.trigger();
      }, { once: true });
      addEventListener('resize', () => { place(thumb); thumb.resizeDrawingSurfaceToCanvas(); });
    }, { rootMargin: '400px 0px' });
    loader.observe(ctaSection);
  }

  // Keep it. Seriously: the watch toss. The runtime and file load only when the card is near, never
  // with reduced motion or Data Saver, and it plays each time the card comes back into view. The page
  // says the lines: one as the hand winds up, the punchline from when the file fires `joke`.
  const toss = document.querySelector<HTMLElement>('[data-toss]');
  const tossCanvas = document.querySelector<HTMLCanvasElement>('[data-toss-canvas]');
  const tossStill = document.querySelector<HTMLElement>('[data-toss-still]');
  const tossBubble = document.querySelector<HTMLElement>('[data-toss-bubble]');
  if (toss && tossCanvas && tossStill && tossBubble && !reducedMotion && !saveData) {
    const TOSS_SECONDS = 5.6;         // the whole scene, ending on its last frame
    const SETUP_LINE = "We've already been through this… 😠";
    // After the joke the face keeps up with the scene: watching it come back, the catch, the payoff
    const PUNCHLINES: [number, string][] = [[0, 'JK 👀'], [1.4, 'JK 😉'], [3.0, 'JK 😈']];
    const say = (line: string) => {
      tossBubble.classList.add('opacity-0', 'translate-y-2', 'scale-95');
      requestAnimationFrame(() => {
        tossBubble.textContent = line;
        requestAnimationFrame(() => tossBubble.classList.remove('opacity-0', 'translate-y-2', 'scale-95'));
      });
    };
    const loadToss = new IntersectionObserver(async (entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      loadToss.disconnect();
      const { Rive, Layout, Fit } = await loadRive();
      const scene = new Rive({
        canvas: tossCanvas,
        src: '/media/watch-toss.riv',
        artboard: 'WatchToss',
        stateMachine: 'WatchToss',
        autoplay: true,
        autoBind: true,
        layout: new Layout({ fit: Fit.Contain }),
        onLoad: () => {
          scene.resizeDrawingSurfaceToCanvas();
          scene.viewModelInstance?.trigger('joke')?.on(() => {
            PUNCHLINES.forEach(([after, line]) => setTimeout(() => say(line), after * 1000));
          });
          // Shown at once, waiting in its first pose: a canvas kept hidden until the visit keeps the
          // clock running unseen, and the scene starts a second or more in
          tossCanvas.hidden = false;
          tossStill.hidden = true;
          let visiting = false;
          let away = true;
          const visit = () => {
            visiting = true;
            away = false;
            scene.play();
            scene.viewModelInstance?.trigger('play')?.trigger();
            say(SETUP_LINE);
            setTimeout(() => {
              visiting = false;
              scene.pause();
            }, TOSS_SECONDS * 1000);
          };
          // A visit starts once the card is mostly on screen; the next waits for it to leave and return
          new IntersectionObserver((seen) => {
            const e = seen[seen.length - 1];
            if (!e.isIntersecting) away = true;
            else if (e.intersectionRatio >= 0.6 && away && !visiting) visit();
          }, { threshold: [0, 0.6] }).observe(toss);
        },
      });
      addEventListener('resize', () => scene.resizeDrawingSurfaceToCanvas());
    }, { rootMargin: '400px 0px' });
    loadToss.observe(toss);
  }

  // FAQ accordion
  document.querySelectorAll('.faq-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const content = btn.nextElementSibling as HTMLElement;
      const chevron = btn.querySelector('.faq-chevron');
      const isOpen = !content.classList.contains('hidden');

      // Close all
      document.querySelectorAll('.faq-content').forEach((c) => c.classList.add('hidden'));
      document.querySelectorAll('.faq-chevron').forEach((c) => c.classList.remove('rotate-180'));

      // Toggle clicked
      if (!isOpen) {
        content.classList.remove('hidden');
        chevron?.classList.add('rotate-180');
      }
    });
  });
</script>

<style>
  /* The ways bar slides up into the top bar's place while the top bar is out of the way */
  :root[data-nav-hidden] [data-ways-bar] { top: 12px; }
  /* "Saved to the app": the chip pops, then its tick draws */
  .saved-chip {
    transition: opacity 0.3s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .saved-chip path {
    stroke-dasharray: 1;
    transition: stroke-dashoffset 0.35s ease 0.25s;
  }
  .saved-chip[data-pending] { opacity: 0; transform: scale(0.7); }
  .saved-chip[data-pending] path { stroke-dashoffset: 1; }
  @keyframes glassFadeIn {
    from { opacity: 0; transform: translateY(20px) scale(0.98); backdrop-filter: blur(0); }
    to   { opacity: 1; transform: translateY(0) scale(1); backdrop-filter: blur(24px); }
  }
  @keyframes contentFadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Why: notifications. Listed, each sits a row lower; folded, the three tuck behind the top one,
     smaller and dimmer the older they are; then ours takes the top. */
  .notifs {
    --h: 76px;
    --gap: 10px;
    height: calc(3 * var(--h) + 2 * var(--gap));
    transition: height 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .notifs[data-state='folded'],
  .notifs[data-state='ours'],
  .notifs[data-state='reset'] { height: calc(var(--h) + 24px); }
  .notif {
    position: absolute;
    inset-inline: 0;
    height: var(--h);
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 14px;
    border-radius: 20px;
    background: rgb(36, 36, 38);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.45s ease;
  }
  .notif-app {
    top: calc(var(--i) * (var(--h) + var(--gap)));
    opacity: 0;
    transform: translateY(-14px) scale(0.96);
    z-index: calc(3 - var(--i));
  }
  .notif-app.is-in { opacity: 1; transform: none; }
  .notifs[data-state='folded'] .notif-app,
  .notifs[data-state='ours'] .notif-app {
    transform: translateY(calc(-1 * var(--i) * (var(--h) + var(--gap)) + (var(--i) + 1) * 8px)) scale(calc(1 - (var(--i) + 1) * 0.05));
    opacity: calc(0.75 - var(--i) * 0.2);
  }
  /* Folded behind ours, a card shows only its edge, never its words through the one in front */
  .notif-app > * { transition: opacity 0.3s ease; }
  .notifs[data-state='folded'] .notif-app > *,
  .notifs[data-state='ours'] .notif-app > * { opacity: 0; }
  .notif-us {
    top: 0;
    z-index: 5;
    opacity: 0;
    transform: translateY(-14px) scale(0.96);
    background: rgb(46, 46, 48);
  }
  .notifs[data-state='ours'] .notif-us { opacity: 1; transform: none; }
</style>
