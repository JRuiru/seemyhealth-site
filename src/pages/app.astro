---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import AppStoreButtons from '../components/AppStoreButtons.astro';

export const prerender = true;

const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "SeeMyHealth",
  operatingSystem: "iOS, Android",
  applicationCategory: "HealthApplication",
  description: "The SeeMyHealth app unifies all your health devices into one dashboard. Track heart rate, sleep, body composition, blood pressure, hydration, blood markers, mood, journalling, and more.",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};

const CF_IMG = "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg";

const standAloneFeatures = [
  {
    title: "Journal, mood & habits",
    description: "Daily mood check-ins, free-form journalling with prompts, and habit streaks. Build self-awareness without needing a single device.",
    icon: "M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z",
  },
  {
    title: "Meals, nutrition & fasting",
    description: "Log meals with photos or barcode scan. Build nutrition plans, set fasting schedules, and get smart reminders, all without a device.",
    icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
  },
  {
    title: "Hydration tracking",
    description: "Log water intake manually, set daily goals, and get reminders to stay on track. Hydra One automates it, but the app works on its own.",
    icon: "M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zM12.75 9a.75.75 0 00-1.5 0v2.25H9a.75.75 0 000 1.5h2.25V15a.75.75 0 001.5 0v-2.25H15a.75.75 0 000-1.5h-2.25V9z",
  },
  {
    title: "Family data sharing",
    description: "Share health dashboards with family members: parents, partners, kids. Everyone stays informed with role-based access and privacy controls.",
    icon: "M18 18.72a9.094 9.094 0 003.741-5.728M12 2.25c-4.97 0-9 4.03-9 9s4.03 9 9 9m0-18a8.96 8.96 0 015.672 2.018M12 2.25v0M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0",
  },
  {
    title: "Care provider access",
    description: "Video consultations, follow-ups, and second opinions without leaving the app.",
    icon: "M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5",
  },
  {
    title: "Community & challenges",
    description: "Sleep, nutrition, hydration, steps, and more. Compete, share, stay accountable.",
    icon: "M18 18.72a9.094 9.094 0 003.741-5.728M3.741 13.008A9 9 0 0112 3a9 9 0 018.259 10.008M12 12l-3 3m0 0l3 3m-3-3h12",
  },
];

const timeline = [
  {
    time: "6:30 AM",
    title: "Wake up",
    device: "Ring One",
    insight: "Sleep score 82. Recovery: ready to train.",
    color: "#F97316",
    image: `${CF_IMG}/ring-sleeping/public`,
  },
  {
    time: "6:45 AM",
    title: "Morning journal",
    device: "App",
    insight: "Mood check-in, gratitude entry, set today's intention.",
    color: "#737373",
    image: `${CF_IMG}/lifestyle-sun-portrait/public`,
  },
  {
    time: "7:00 AM",
    title: "Step on the scale",
    device: "The Scale Pro",
    insight: "Muscle mass +0.3kg. Visceral fat down.",
    color: "#3B82F6",
    image: `${CF_IMG}/scale-pro-using/public`,
  },
  {
    time: "7:20 AM",
    title: "Morning BP check",
    device: "BP Monitor",
    insight: "118/76. 30-day trend steady. Shared with your doctor.",
    color: "#EF4444",
    image: `${CF_IMG}/bp-morning-check/public`,
  },
  {
    time: "9:00 AM",
    title: "Scan, log, go",
    device: "App",
    insight: "Rushing to work. Scanned a protein bar, 230 cal, 20g protein. Logged before the first bite.",
    color: "#737373",
    image: `${CF_IMG}/logging-food/public`,
  },
  {
    time: "12:30 PM",
    title: "Hydration check",
    device: "Hydra One",
    insight: "1.2L of 2.5L. Pick it up before 3 PM.",
    color: "#06B6D4",
    image: `${CF_IMG}/bottle-black-desk-work/public`,
  },
  {
    time: "1:00 PM",
    title: "Nutritionist video call",
    device: "App",
    insight: "Lunch break consult. Shared meal logs and blood markers, got a revised plan in 15 min.",
    color: "#737373",
    image: `${CF_IMG}/app-dashboard-hand/public`,
  },
  {
    time: "3:00 PM",
    title: "Workout recorded",
    device: "Ring One",
    insight: "45 min strength session. Heart rate zones, calories, and recovery impact, all logged automatically.",
    color: "#F97316",
    image: `${CF_IMG}/lifestyle-athlete/public`,
  },
  {
    time: "4:30 PM",
    title: "Challenge accepted",
    device: "App",
    insight: "Friend invited you to a 7-day most-active challenge. You're in. Leaderboard is live.",
    color: "#737373",
    image: `${CF_IMG}/challenge-accepted/public`,
  },
  {
    time: "5:30 PM",
    title: "Check on mum's blood work",
    device: "Hema One",
    insight: "Family share alert: mum's iron dropped again. Flagged it, and she's booking a follow-up.",
    color: "#A855F7",
    image: `${CF_IMG}/hema-one-hero/public`,
  },
  {
    time: "9:15 PM",
    title: "Evening mood check-in",
    device: "App",
    insight: "How are you feeling? Quick tap. The app tracks patterns between mood, sleep, and nutrition over time.",
    color: "#737373",
    image: `${CF_IMG}/ring-sleeping/public`,
  },
  {
    time: "9:30 PM",
    title: "Goals achieved",
    device: "App",
    insight: "Hydration hit. Steps crushed. Meals on target. Sleep score pending. Goodnight.",
    color: "#737373",
    image: `${CF_IMG}/app-dashboard-hand/public`,
  },
];

const comparisonRows = [
  { feature: "Mood tracking & journalling", appOnly: true, withDevices: true },
  { feature: "Meal logging & recipes", appOnly: true, withDevices: true },
  { feature: "Nutrition & fasting plans", appOnly: true, withDevices: true },
  { feature: "Hydration tracking (manual)", appOnly: true, withDevices: true },
  { feature: "Habit streaks", appOnly: true, withDevices: true },
  { feature: "Family data sharing", appOnly: true, withDevices: true },
  { feature: "Care provider access", appOnly: true, withDevices: true },
  { feature: "Community & challenges", appOnly: true, withDevices: true },
  { feature: "24/7 heart rate & SpO2", appOnly: false, withDevices: true },
  { feature: "Sleep staging & recovery score", appOnly: false, withDevices: true },
  { feature: "Body composition analysis", appOnly: false, withDevices: true },
  { feature: "Blood pressure tracking", appOnly: false, withDevices: true },
  { feature: "Auto hydration tracking (Hydra One)", appOnly: false, withDevices: true },
  { feature: "Blood marker insights", appOnly: false, withDevices: true },
  { feature: "Cross-device health correlations", appOnly: false, withDevices: true },
  { feature: "Secure doctor sharing (with live data)", appOnly: false, withDevices: true },
];

const faqs = [
  {
    q: "Is the app really useful without buying a device?",
    a: "Yes. Mood tracking, journalling, meal logging, recipes, habit streaks, guided programs, and community challenges all work independently. The app is a complete wellness platform on its own. Devices make it smarter, but they're not required.",
  },
  {
    q: "What happens if I add a device later?",
    a: "It just works. Pair a device and its data automatically flows into your existing dashboard. Your history is preserved, and the app immediately starts finding correlations between your manual entries and device data.",
  },
  {
    q: "Do I need Plus to use my SeeMyHealth devices?",
    a: "No, you can pair and use devices without a Plus subscription. Plus unlocks the full app experience: cross-device insights, advanced sleep intelligence, guided programs, meal tracking, and unlimited history.",
  },
  {
    q: "Do I need to own a device to use one?",
    a: "No. The Scale, The Scale Pro, BP Monitor, and Hema One aren't locked to any account. Walk up to any one at home, a gym, or a friend's place. Open the app, connect, and your reading saves to your profile. We engineered these devices to be shared.",
  },
  {
    q: "Can I use the app with non-SeeMyHealth devices?",
    a: "The app integrates with Apple Health and Google Fit, so data from compatible third-party devices can appear in your dashboard. SeeMyHealth devices offer the deepest integration and richest data.",
  },
  {
    q: "What's the privacy story?",
    a: "We don't sell your data. We don't run ads. Your health data is encrypted end-to-end (TLS 1.3 in transit, AES-256 at rest). You control who sees your data, and you can request full deletion at any time.",
  },
  {
    q: "What's the difference between this and my doctor's portal?",
    a: "Your doctor's portal shows clinical snapshots. The app shows the full picture between visits. You can share your SeeMyHealth data with your doctor directly from the app with toggle-based access control.",
  },
];

const allFeatures = [
  "All device integrations",
  "Unified health dashboard",
  "Cross-device insights",
  "Sleep intelligence",
  "Meal logging & recipes",
  "Mood tracking & journalling",
  "Secure doctor sharing",
  "Unlimited data history",
];
---

<Layout title="The App | SeeMyHealth" description="Works the day you download it. Smarter when your devices arrive. Journalling, mood tracking, meal logging, recipes, and guided programs, no device required. Add devices for 24/7 vitals, sleep staging, and cross-device insights." canonicalPath="/app" jsonLd={appSchema}>
  <Navbar />

  <!-- Hero -->
  <section class="relative min-h-screen overflow-hidden">
    <!-- Full-bleed background image -->
    <div class="absolute inset-0">
      <img
        src={`${CF_IMG}/app-hero-triple-phones/public`}
        alt="SeeMyHealth app, meals, health hub, and sleep tracking screens"
        class="w-full h-full object-cover object-center"
      />
      <!-- Gradient overlay — darkens bottom and edges for text legibility -->
      <div class="absolute inset-0 bg-gradient-to-t from-brand-black via-brand-black/60 to-brand-black/30"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-brand-black/50 via-transparent to-transparent"></div>
    </div>

    <!-- Text content — centered at bottom over image -->
    <div class="relative min-h-screen flex items-end pb-20 pt-24">
      <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
        <div class="backdrop-blur-xl bg-white/[0.04] border border-white/[0.08] rounded-2xl sm:rounded-3xl px-5 py-6 sm:px-12 sm:py-14 shadow-2xl shadow-black/20 animate-[glassFadeIn_0.6s_ease-out_forwards]">
          <div class="opacity-0 animate-[contentFadeIn_0.5s_ease-out_0.4s_forwards]">
            <p class="text-[10px] sm:text-[11px] uppercase tracking-[4px] text-white/50 mb-3 sm:mb-5">The SeeMyHealth App</p>
            <h1 class="font-display text-3xl sm:text-5xl lg:text-6xl xl:text-7xl font-300 uppercase leading-[0.95] mb-3 sm:mb-6">
              Works from <span class="font-500 italic">day one.</span><br class="hidden sm:block" />
              Smarter with devices.
            </h1>
            <p class="text-sm sm:text-lg text-white/60 leading-relaxed mb-5 sm:mb-8 max-w-2xl mx-auto">
              Start with journalling, mood, meals, and guided programs. No hardware needed. Add devices when you're ready.
            </p>
            <div>
              <AppStoreButtons />
              <p class="text-[12px] text-white/30 mt-4">1-month free trial. Cancel anytime.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- See what you get -->
  <section class="py-20 sm:py-28 bg-brand-black border-t border-white/5">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl sm:text-5xl font-300 uppercase leading-[0.95] mb-4">
        See what you get, <span class="font-500">in either mode.</span>
      </h2>
      <p class="text-brand-gray-400 leading-relaxed max-w-xl mx-auto mb-8">
        The app works beautifully on its own. Devices unlock the full picture.
      </p>
      <div class="flex justify-center gap-4">
        <a href="#app-only" class="px-6 py-2.5 text-[12px] uppercase tracking-[1.5px] font-medium text-brand-black bg-white rounded-full hover:bg-brand-gray-200 transition-colors">
          App only
        </a>
        <a href="#with-devices" class="px-6 py-2.5 text-[12px] uppercase tracking-[1.5px] font-medium text-white border border-white/20 rounded-full hover:border-white/40 transition-colors">
          App + Devices
        </a>
      </div>
    </div>
  </section>

  <!-- The wellness app, on its own -->
  <section id="app-only" class="py-20 sm:py-28 bg-brand-black border-t border-white/5">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="mb-12" data-scroll-reveal>
        <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">No Devices Required</p>
        <h2 class="font-display text-4xl sm:text-5xl font-300 uppercase leading-[0.95]">
          The wellness app, <span class="font-500">on its own.</span>
        </h2>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex gap-5 overflow-x-auto snap-x snap-mandatory scroll-smooth py-4 -mr-6 lg:-mr-8 pr-6 lg:pr-8 no-scrollbar" data-scroll-stagger>
      {standAloneFeatures.map((f) => (
        <div class="group relative shrink-0 w-[320px] sm:w-[380px] snap-start rounded-2xl overflow-hidden cursor-pointer">
          {/* Background image placeholder */}
          <div class="aspect-[3/4] bg-brand-gray-800 relative">
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent z-10"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <svg class="w-12 h-12 text-brand-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="0.75">
                <path stroke-linecap="round" stroke-linejoin="round" d={f.icon} />
              </svg>
            </div>
          </div>
          {/* Category pill */}
          <div class="absolute top-4 left-4 z-20">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/15 backdrop-blur-md text-[11px] text-white tracking-wide">
              {f.title}
            </span>
          </div>
          {/* Bottom text overlay */}
          <div class="absolute bottom-0 left-0 right-0 p-6 z-20">
            <p class="font-display text-2xl sm:text-3xl font-300 uppercase leading-[1.1] text-white">
              {f.description.split('.')[0]}.
            </p>
          </div>
        </div>
      ))}
      </div>
    </div>
  </section>

  <!-- Shared by design -->
  <section class="py-16 sm:py-20 bg-brand-black border-t border-white/5">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <div class="rounded-2xl border border-white/5 bg-brand-gray-900 p-8 sm:p-12 lg:flex lg:items-center lg:gap-12" data-scroll-reveal>
        <div class="lg:flex-1 mb-8 lg:mb-0">
          <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">Shared by design</p>
          <h3 class="font-display text-3xl sm:text-4xl font-300 uppercase leading-[0.95] mb-4">
            You don't need to own a device <span class="font-500">to use one.</span>
          </h3>
          <p class="text-brand-gray-400 leading-relaxed">
            We engineered The Scale, The Scale Pro, BP Monitor, and Hema One to work with any account. Walk up to one at home, a gym, or a friend's place. Open the app, connect, and your reading saves to your profile. No setup, no re-pairing, no account switching. One device, shared by a whole family or an entire floor.
          </p>
        </div>
        <div class="lg:w-[280px] shrink-0">
          <div class="grid grid-cols-2 gap-3">
            <div class="rounded-xl bg-brand-black border border-white/5 p-4 text-center">
              <p class="text-2xl font-display font-500 mb-1">∞</p>
              <p class="text-[10px] uppercase tracking-wider text-brand-gray-600">Users per device</p>
            </div>
            <div class="rounded-xl bg-brand-black border border-white/5 p-4 text-center">
              <p class="text-2xl font-display font-500 mb-1">0</p>
              <p class="text-[10px] uppercase tracking-wider text-brand-gray-600">Setup needed</p>
            </div>
            <div class="rounded-xl bg-brand-black border border-white/5 p-4 text-center">
              <p class="text-2xl font-display font-500 mb-1">4</p>
              <p class="text-[10px] uppercase tracking-wider text-brand-gray-600">Shared devices</p>
            </div>
            <div class="rounded-xl bg-brand-black border border-white/5 p-4 text-center">
              <p class="text-2xl font-display font-500 mb-1">🔒</p>
              <p class="text-[10px] uppercase tracking-wider text-brand-gray-600">Private to you</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- A day with the ecosystem -->
  <section id="with-devices" class="py-20 sm:py-28 bg-brand-dark border-t border-white/5 overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="mb-14 max-w-2xl" data-scroll-reveal>
        <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">With Devices</p>
        <h2 class="font-display text-4xl sm:text-5xl font-300 uppercase leading-[0.95] mb-4">
          Unlock the <span class="font-500">full picture.</span>
        </h2>
        <p class="text-brand-gray-400 leading-relaxed">
          Every device adds a layer of intelligence. Here's what a day looks like when everything's connected.
        </p>
      </div>
    </div>

    <div class="relative">
      {/* Horizontal timeline line */}
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="relative">
          <div class="absolute left-0 right-0 top-[7px] h-px bg-white/10 z-10"></div>

          <div class="flex gap-5 overflow-x-auto snap-x snap-mandatory scroll-smooth pt-10 pb-4 -mr-6 lg:-mr-8 pr-6 lg:pr-8 no-scrollbar">
            {timeline.map((entry) => (
              <div class="relative shrink-0 w-[280px] sm:w-[320px] snap-start group">
                {/* Dot on the line */}
                <div class="absolute -top-10 left-8 z-20">
                  <div class="w-[14px] h-[14px] rounded-full border-2" style={`background: ${entry.color}; border-color: ${entry.color};`}>
                    <div class="absolute inset-0 rounded-full animate-ping opacity-20" style={`background: ${entry.color};`}></div>
                  </div>
                </div>
                {/* Connector stem */}
                <div class="absolute -top-[23px] left-[21px] w-px h-[23px] bg-white/10"></div>

                {/* Card */}
                <div class="relative rounded-2xl overflow-hidden h-full">
                  {/* Background image */}
                  <div class="aspect-[3/4]">
                    <img src={entry.image} alt={entry.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/20"></div>
                  </div>

                  {/* Time + device pill */}
                  <div class="absolute top-4 left-4 right-4 flex items-center justify-between z-10">
                    <span class="text-[11px] uppercase tracking-[2px] text-white/70 font-medium">{entry.time}</span>
                    <span class="text-[10px] uppercase tracking-[1.5px] px-2.5 py-1 rounded-full backdrop-blur-md" style={`background: ${entry.color}22; color: ${entry.color}; border: 1px solid ${entry.color}44;`}>
                      {entry.device}
                    </span>
                  </div>

                  {/* Bottom text */}
                  <div class="absolute bottom-0 left-0 right-0 p-5 z-10">
                    <h3 class="font-display text-xl uppercase font-300 text-white mb-1.5">{entry.title}</h3>
                    <p class="text-[13px] text-white/60 leading-relaxed">{entry.insight}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="mt-10 text-center" data-scroll-reveal>
        <p class="text-sm text-brand-gray-500 leading-relaxed max-w-lg mx-auto">
          No app-switching. No manual exports. Every device feeds the same dashboard, and the app finds patterns you'd never spot alone.
        </p>
      </div>
    </div>
  </section>

  <!-- Feature comparison table -->
  <section class="py-20 sm:py-28 bg-brand-black border-t border-white/5">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-12" data-scroll-reveal>
        <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">One App, Two Modes</p>
        <h2 class="font-display text-4xl sm:text-5xl font-300 uppercase leading-[0.95] mb-4">
          Start anywhere. <span class="font-500">Grow when you're ready.</span>
        </h2>
        <p class="text-brand-gray-400 leading-relaxed max-w-xl mx-auto">
          The app stands on its own, and gets smarter the more devices you add. Same subscription, more intelligence.
        </p>
      </div>

      <div class="rounded-2xl border border-white/10 overflow-hidden" data-scroll-reveal>
        <table class="w-full">
          <!-- Header -->
          <thead>
            <tr class="bg-brand-gray-900">
              <th class="text-left px-4 sm:px-6 py-4 text-[10px] uppercase tracking-[2px] text-brand-gray-500 font-normal"></th>
              <th class="px-2 sm:px-6 py-4 text-[10px] uppercase tracking-[2px] text-brand-gray-500 font-normal text-center whitespace-nowrap">App Only</th>
              <th class="px-2 sm:px-6 py-4 text-[10px] uppercase tracking-[2px] text-brand-gray-500 font-normal text-center whitespace-nowrap">App + Devices</th>
            </tr>
          </thead>
          <tbody>
            {comparisonRows.map((row, i) => (
              <tr class={i % 2 === 0 ? "bg-brand-black" : "bg-white/[0.01]"}>
                <td class="px-4 sm:px-6 py-3 text-sm text-brand-gray-400 border-t border-white/5">{row.feature}</td>
                <td class="px-2 sm:px-6 py-3 text-center border-t border-white/5">
                  {row.appOnly ? (
                    <svg class="w-4 h-4 text-green-500 inline-block" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  ) : (
                    <span class="text-brand-gray-700">-</span>
                  )}
                </td>
                <td class="px-2 sm:px-6 py-3 text-center border-t border-white/5">
                  <svg class="w-4 h-4 text-green-500 inline-block" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
