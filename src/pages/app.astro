---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import AppStoreButtons from '../components/AppStoreButtons.astro';
import HealthPlatformBadges from '../components/HealthPlatformBadges.astro';
import Testimonials from '../components/Testimonials.astro';

export const prerender = true;

const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "C-MyHealth",
  alternateName: ["SeeMyHealth", "See My Health", "SeeMyHealth App"],
  operatingSystem: "iOS, Android",
  applicationCategory: "HealthApplication",
  description: "C-MyHealth (by SeeMyHealth) unifies all your health devices into one dashboard. Track heart rate, sleep, body composition, blood pressure, hydration, blood markers, mood, journalling, and more.",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  author: {
    "@type": "Organization",
    name: "SeeMyHealth",
    url: "https://www.seemyhealth.ai",
  },
};

const CF_IMG = "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg";

// Why: each app on its own hears one word of what the body is saying
const scattered = [
  "Your sleep app has no idea you skipped lunch.",
  "Your nutrition app is still using last month's weight.",
  "And your step counter missed the week you've had.",
];

// What the app is, in three ideas, before what it does
const pillars = [
  { title: "One home", text: "Today at a glance: what you've eaten, how you slept, how much you've drunk and how you're feeling." },
  { title: "Your goals", text: "Set the goals you care about, and watch each day add up against them." },
  { title: "The long view", text: "Weeks and months of history, so a bad day stays a bad day and a trend gets a chance to show itself." },
];

// The three ways to use it, each a section further down
const waysIn = [
  { label: "Just the app", href: "#inside" },
  { label: "With our devices", href: "#with-devices" },
  { label: "With your watch", href: "#your-watch" },
];

// What the app does on its own, in four themes; a tab shows one at a time
const themes = [
  {
    key: "eat",
    label: "Eat",
    title: "Eat.",
    bold: "Without the guesswork.",
    text: "Search or scan what you eat, find recipes you'll actually cook, plan the week, and set a fasting window if that's your thing. Water counts too.",
    items: ["Meal logging by search or barcode", "Recipes and weekly meal plans", "Fasting schedules", "Water goals and reminders"],
    image: `${CF_IMG}/app-meal-logging/public`,
    alt: "Logging a meal in the SeeMyHealth app",
  },
  {
    key: "feel",
    label: "Feel",
    title: "Feel.",
    bold: "Then write it down.",
    text: "Quick mood check-ins and a journal that's there when you want it. Give it a few weeks and your good days start to show what they have in common.",
    items: ["Mood check-ins", "Journalling", "Habit streaks"],
    image: `${CF_IMG}/app-mood-journal/public`,
    alt: "A mood check-in and journal entry in the app",
  },
  {
    key: "people",
    label: "Your people",
    title: "Your people.",
    bold: "All of them.",
    text: "Share what you choose with family, keep tabs on Mum, and drag your friends into a challenge or two.",
    items: ["Family sharing, on your terms", "Groups and community", "Challenges with friends"],
    image: `${CF_IMG}/app-family-sharing/public`,
    alt: "Family members sharing their progress in the app",
  },
  {
    key: "care",
    label: "Care",
    title: "Care.",
    bold: "When you want it.",
    text: "Book a provider, have a video visit, and keep the follow-ups in the same place as everything else.",
    items: ["Book a provider", "Video visits", "Follow-ups in the app"],
    image: `${CF_IMG}/app-video-consultation/public`,
    alt: "A video visit with a care provider in the app",
  },
];

// A day with a few devices: what each one catches that a phone can't
const timeline = [
  {
    time: "6:30 AM",
    title: "Wake up",
    device: "Ring One",
    text: "Your night's already in: sleep stages and a recovery score, waiting with your coffee.",
    color: "#F97316",
    image: `${CF_IMG}/ring-sleep-insights-ad/public`,
  },
  {
    time: "7:00 AM",
    title: "Step on",
    device: "The Scale Pro",
    text: "Weight, muscle and fat, arm by arm, saved before you've found your socks.",
    color: "#3B82F6",
    image: `${CF_IMG}/scale-pro-using/public`,
  },
  {
    time: "7:20 AM",
    title: "Morning reading",
    device: "BP Monitor",
    text: "Wrap, press, done. It lines up next to last night's reading on its own.",
    color: "#EF4444",
    image: `${CF_IMG}/bp-morning-check/public`,
  },
  {
    time: "12:30 PM",
    title: "Halfway there",
    device: "Hydra One",
    text: "Half your water by lunch. The ring on the lid says so, no phone needed.",
    color: "#06B6D4",
    image: `${CF_IMG}/bottle-black-desk-work/public`,
  },
  {
    time: "6:00 PM",
    title: "At the gym",
    device: "The Scale Pro",
    text: "No scale at home? Use the gym's. Connect, step on, and the reading is yours alone.",
    color: "#3B82F6",
    image: `${CF_IMG}/scale-pro-white-gym/public`,
  },
  {
    time: "9:30 PM",
    title: "Day done",
    device: "App",
    text: "Water, steps and meals, all in one place. Goodnight.",
    color: "#737373",
    image: `${CF_IMG}/app-goals-achieved/public`,
  },
];

const faqs = [
  {
    q: "Why is the app called C-MyHealth instead of SeeMyHealth?",
    a: "C-MyHealth is the SeeMyHealth app, published under a shorter, App Store-friendly name. Search for either \"C-MyHealth\" or \"SeeMyHealth\" on the App Store or Google Play and you'll find the same app, built and run by SeeMyHealth.",
  },
  {
    q: "Is the app useful without a device?",
    a: "Yes. Meals, recipes, fasting, water, mood, journalling, family sharing and challenges all work on their own. Devices add what a phone can't measure, like body composition, blood pressure and sleep stages.",
  },
  {
    q: "What happens if I add a device later?",
    a: "It slots straight in. Pair it and its readings join your existing history in the same app.",
  },
  {
    q: "Do I need to own a device to use one?",
    a: "No. The Scale, The Scale Pro, BP Monitor and Hema One aren't tied to one account. At home, at the gym or at a friend's, open the app, connect, and the reading saves to your own profile.",
  },
  {
    q: "Will it work with my watch?",
    a: "Yes. The app reads from Apple Health on iPhone and Health Connect on Android, so your watch, your old scale and your running app can all show up. One tap on, one tap off.",
  },
  {
    q: "What happens to my data?",
    a: "No ads, and we don't sell it. We won't, ever. It's encrypted in transit (TLS 1.3) and at rest (AES-256), you pick who sees what, and you can delete the lot whenever you like.",
  },
];

const allFeatures = [
  "Every device, one dashboard",
  "Apple Health & Health Connect",
  "Meal logging & recipes",
  "Mood & journalling",
  "Sleep and recovery",
  "Family sharing",
  "Challenges & community",
  "Unlimited history",
];

---

<Layout title="C-MyHealth App | SeeMyHealth" description="Download C-MyHealth, the SeeMyHealth app for iOS and Android. Journalling, mood tracking, meal logging, recipes, and guided programs, no device required. Add devices for 24/7 vitals, sleep staging, and cross-device insights." ogImage="https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg/og-app/public" canonicalPath="/app" jsonLd={appSchema}>
  <Navbar />

  <!-- Hero -->
  <section class="relative min-h-screen overflow-hidden">
    <!-- Full-bleed background image -->
    <div class="absolute inset-0">
      <img
        src={`${CF_IMG}/app-hero-triple-phones/public`}
        alt="SeeMyHealth app, meals, health hub, and sleep tracking screens"
        class="w-full h-full object-cover object-center"
      />
      <!-- Gradient overlay — darkens bottom and edges for text legibility -->
      <div class="absolute inset-0 bg-gradient-to-t from-brand-black via-brand-black/60 to-brand-black/30"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-brand-black/50 via-transparent to-transparent"></div>
    </div>

    <!-- Text content — centered at bottom over image -->
    <div class="relative min-h-screen flex items-end pb-20 pt-24">
      <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
        <div class="backdrop-blur-xl bg-white/[0.04] border border-white/[0.08] rounded-2xl sm:rounded-3xl px-5 py-6 sm:px-12 sm:py-14 shadow-2xl shadow-black/20 animate-[glassFadeIn_0.6s_ease-out_forwards]">
          <div class="opacity-0 animate-[contentFadeIn_0.5s_ease-out_0.4s_forwards]">
            <p class="text-[10px] sm:text-[11px] uppercase tracking-[4px] text-white/50 mb-3 sm:mb-5">The SeeMyHealth App</p>
            <h1 class="font-display text-3xl sm:text-5xl lg:text-6xl xl:text-7xl font-300 uppercase leading-[0.95] mb-3 sm:mb-6">
              Works from <span class="font-500 italic">day one.</span>{' '}<br class="hidden sm:block" />
              Smarter with devices.
            </h1>
            <p class="text-sm sm:text-lg text-white/60 leading-relaxed mb-5 sm:mb-8 max-w-2xl mx-auto">
              Start with journalling, mood, meals, and guided programs. No hardware needed. Add devices when you're ready.
            </p>
            <div>
              <AppStoreButtons />
              <p class="text-[12px] text-white/30 mt-4">1-month free trial. Cancel anytime.</p>
              <p class="text-[11px] text-white/25 mt-1.5">Listed on the App Store &amp; Google Play as C-MyHealth.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why: every other app hears one word of what the body says -->
  <section class="py-24 sm:py-36 bg-brand-black border-t border-white/5">
    <div class="max-w-3xl mx-auto px-6 lg:px-8 text-center">
      <div class="flex flex-col gap-3 sm:gap-4 mb-12 sm:mb-16" data-scroll-stagger>
        {scattered.map((line) => (
          <p class="text-lg sm:text-2xl text-brand-gray-400 italic text-balance">{line}</p>
        ))}
      </div>
      <div data-scroll-reveal>
        <h2 class="font-display text-4xl sm:text-6xl font-300 uppercase leading-[0.95] mb-6 text-balance">
          Each one hears a word.<br /> <span class="font-500">Nobody hears the sentence.</span>
        </h2>
        <p class="text-brand-gray-400 sm:text-lg leading-relaxed text-pretty">
          Your body keeps dropping hints, and they only make sense together. SeeMyHealth puts them side by side, so the late coffee shows up next to the bad night, and your good days start to show what they share. No diagnosis, no lecture. Just a clearer view of you.
        </p>
      </div>
    </div>
  </section>

  <!-- What the app is, before what it does -->
  <section class="py-20 sm:py-28 bg-brand-dark border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-14 sm:mb-16" data-scroll-reveal>
        <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">The app</p>
        <h2 class="font-display text-4xl sm:text-6xl font-300 uppercase leading-[0.95] mb-6 text-balance">
          One app. <span class="font-500">All of you.</span>
        </h2>
        <p class="text-brand-gray-400 sm:text-lg leading-relaxed text-pretty">
          Sleep, meals, mood, water, weight and the rest usually live in a dozen places. SeeMyHealth puts them on one screen, day by day, so you can see how it all fits together.
        </p>
      </div>
      <div class="grid sm:grid-cols-3 gap-4 sm:gap-6" data-scroll-stagger>
        {pillars.map((pillar, i) => (
          <div class="rounded-2xl border border-white/5 bg-white/[0.02] p-6 sm:p-8">
            <p class="text-[11px] uppercase tracking-[3px] text-brand-gray-600 mb-6">0{i + 1}</p>
            <h3 class="font-display text-2xl sm:text-3xl font-400 uppercase leading-tight mb-3">{pillar.title}</h3>
            <p class="text-sm text-brand-gray-400 leading-relaxed text-pretty">{pillar.text}</p>
          </div>
        ))}
      </div>
      <div class="mt-14 sm:mt-16 text-center" data-scroll-reveal>
        <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-5">Three ways in</p>
        <div class="flex flex-wrap justify-center gap-3">
          {waysIn.map((way) => (
            <a href={way.href} class="px-6 py-3 text-[12px] uppercase tracking-[1.5px] font-medium text-white border border-white/20 rounded-full hover:border-white/40 transition-colors">
              {way.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- What's inside: the app on its own, one theme at a time -->
  <section id="inside" class="py-20 sm:py-28 bg-brand-black border-t border-white/5" data-themes>
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="mb-10 sm:mb-12 max-w-2xl" data-scroll-reveal>
        <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">Just the app</p>
        <h2 class="font-display text-4xl sm:text-5xl font-300 uppercase leading-[0.95] text-balance">
          Start with the app. <span class="font-500">Nothing else needed.</span>
        </h2>
      </div>

      <div class="flex gap-2 overflow-x-auto no-scrollbar -mx-6 px-6 lg:mx-0 lg:px-0 mb-8" role="tablist" aria-label="What's in the app">
        {themes.map((t, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${t.key}`}
            aria-controls={`panel-${t.key}`}
            aria-selected={i === 0 ? "true" : "false"}
            data-theme-tab={t.key}
            class="shrink-0 px-5 py-2.5 text-[12px] uppercase tracking-[1.5px] font-medium rounded-full border transition-colors aria-selected:bg-white aria-selected:text-brand-black aria-selected:border-white text-white border-white/20 hover:border-white/40"
          >
            {t.label}
          </button>
        ))}
      </div>

      {themes.map((t, i) => (
        <div
          id={`panel-${t.key}`}
          role="tabpanel"
          aria-labelledby={`tab-${t.key}`}
          data-theme-panel={t.key}
          hidden={i !== 0}
          class="grid md:grid-cols-2 gap-8 md:gap-12 items-center"
        >
          <div class="relative aspect-[4/5] max-w-full rounded-3xl overflow-hidden bg-brand-gray-900 border border-white/5">
            <img src={t.image} alt={t.alt} class="absolute inset-0 w-full h-full object-cover" loading={i === 0 ? "eager" : "lazy"} />
          </div>
          <div class="min-w-0">
            <h3 class="font-display text-3xl sm:text-4xl font-300 uppercase leading-[0.95] mb-4 text-balance">
              {t.title} <span class="font-500">{t.bold}</span>
            </h3>
            <p class="text-brand-gray-400 leading-relaxed mb-6 text-pretty">{t.text}</p>
            <ul class="flex flex-col gap-3">
              {t.items.map((item) => (
                <li class="flex items-center gap-3 text-sm text-brand-gray-300">
                  <span class="w-1.5 h-1.5 rounded-full bg-white/60 shrink-0"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Our devices: a day, each moment something a phone can't catch, sent straight to the app -->
  <section id="with-devices" class="py-20 sm:py-28 bg-brand-dark border-t border-white/5 overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="mb-14 max-w-2xl" data-scroll-reveal>
        <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">SeeMyHealth devices</p>
        <h2 class="font-display text-4xl sm:text-5xl font-300 uppercase leading-[0.95] mb-4">
          Our devices. <span class="font-500">Built to talk to it.</span>
        </h2>
        <p class="text-brand-gray-400 leading-relaxed text-pretty">
          Each one picks up something a phone can't and sends it straight to the app. No exporting, no typing numbers in. Here's a day with a few of them.
        </p>
      </div>
    </div>

    <div class="relative">
      {/* Horizontal timeline line */}
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="relative">
          <div class="absolute left-0 right-0 top-[7px] h-px bg-white/10 z-10"></div>

          <div class="flex gap-5 overflow-x-auto scroll-smooth pt-10 pb-4 -mx-6 px-6 lg:-mx-8 lg:px-8 no-scrollbar">
            {timeline.map((entry) => (
              <div class="relative shrink-0 w-[280px] sm:w-[320px] group">
                {/* Dot on the line */}
                <div class="absolute -top-10 left-8 z-20">
                  <div class="w-[14px] h-[14px] rounded-full border-2" style={`background: ${entry.color}; border-color: ${entry.color};`}>
                    <div class="absolute inset-0 rounded-full animate-ping opacity-20" style={`background: ${entry.color};`}></div>
                  </div>
                </div>
                {/* Connector stem */}
                <div class="absolute -top-[23px] left-[21px] w-px h-[23px] bg-white/10"></div>

                {/* Card */}
                <div class="relative rounded-2xl overflow-hidden h-full">
                  <div class="aspect-[3/4]">
                    <img src={entry.image} alt={entry.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/20"></div>
                  </div>

                  {/* Time + device pill */}
                  <div class="absolute top-4 left-4 right-4 flex items-center justify-between z-10">
                    <span class="text-[11px] uppercase tracking-[2px] text-white/70 font-medium">{entry.time}</span>
                    <span class="text-[10px] uppercase tracking-[1.5px] px-2.5 py-1 rounded-full backdrop-blur-md" style={`background: ${entry.color}22; color: ${entry.color}; border: 1px solid ${entry.color}44;`}>
                      {entry.device}
                    </span>
                  </div>

                  {/* Bottom text */}
                  <div class="absolute bottom-0 left-0 right-0 p-5 z-10">
                    <h3 class="font-display text-xl uppercase font-300 text-white mb-1.5">{entry.title}</h3>
                    <p class="text-[13px] text-white/60 leading-relaxed">{entry.text}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 text-center" data-scroll-reveal>
        <p class="text-sm text-brand-gray-500 leading-relaxed max-w-md text-pretty">
          Every device lands in the same app, and the shared ones aren't tied to any one person.
        </p>
        <a href="/shop" class="shrink-0 inline-flex items-center px-6 py-3 text-[13px] uppercase tracking-[1.5px] font-medium text-white border border-white/20 rounded-full hover:border-white/40 transition-colors">
          See the devices &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Keep what you've got: after our own devices, a watch's data comes in through the phone's health store -->
  <section id="your-watch" class="py-20 sm:py-28 bg-brand-black border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6 lg:px-8 grid md:grid-cols-2 gap-8 md:gap-12 items-center">
      <div class="relative aspect-[4/3] max-w-full rounded-3xl overflow-hidden bg-brand-gray-900 border border-white/5 md:order-2" data-scroll-reveal>
        <img src={`${CF_IMG}/challenge-accepted/public`} alt="Man grinning at his phone after a workout" class="absolute inset-0 w-full h-full object-cover object-left" loading="lazy" />
      </div>
      <div class="min-w-0" data-scroll-reveal>
        <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">Already have a watch?</p>
        <h2 class="font-display text-4xl sm:text-5xl font-300 uppercase leading-[0.95] mb-4">
          Keep it. <span class="font-500">Seriously.</span>
        </h2>
        <p class="text-brand-gray-400 leading-relaxed mb-8 text-pretty">
          Switch on Apple Health or Health Connect and your watch's steps, heart rate and sleep land in SeeMyHealth too, next to everything else. One tap on, one tap off.
        </p>
        <HealthPlatformBadges />
      </div>
    </div>
  </section>

  <!-- Real people, real lives -->
  <Testimonials />
  <!-- Pricing -->
  <section class="py-24 sm:py-32 bg-brand-black border-t border-white/5">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-16" data-scroll-reveal>
        <h2 class="font-display text-4xl sm:text-5xl font-300 uppercase leading-[0.95] mb-4">
          One plan. <span class="font-500">Every feature.</span>
        </h2>
        <p class="text-brand-gray-400 leading-relaxed max-w-xl mx-auto">
          No paywalls, no hidden tiers, no ads. One subscription unlocks everything, whether you use the app alone or with every device.
        </p>
      </div>

      <!-- Pricing toggle + cards -->
      <div class="flex items-center justify-center gap-3 mb-8" data-scroll-reveal>
        <span class="text-sm text-brand-gray-400" id="label-monthly">Monthly</span>
        <button
          id="billing-toggle"
          class="relative w-12 h-6 rounded-full bg-white/10 transition-colors"
          aria-label="Toggle billing period"
        >
          <span id="billing-knob" class="absolute top-0.5 left-0.5 w-5 h-5 rounded-full bg-white transition-transform" />
        </button>
        <span class="text-sm text-brand-gray-400" id="label-annual">Annual</span>
        <span class="text-[10px] uppercase tracking-[1.5px] font-medium text-green-400 bg-green-400/10 px-2 py-0.5 rounded-full">Save 27%</span>
      </div>

      <div class="grid sm:grid-cols-2 gap-6 max-w-3xl mx-auto mb-10" data-scroll-reveal>
        <div id="card-monthly" class="rounded-2xl border border-white/10 bg-brand-gray-900 p-8 text-center transition-all duration-300">
          <p class="text-[11px] uppercase tracking-[3px] text-brand-gray-500 mb-4">Monthly</p>
          <div class="flex items-baseline justify-center gap-1 mb-2">
            <span class="font-display text-5xl font-300">$8</span>
            <span class="text-brand-gray-500 text-lg">/month</span>
          </div>
          <p class="text-brand-gray-500 text-sm mb-6">$96/year if billed monthly</p>
          <p class="text-[11px] text-brand-gray-600">Subscribe in-app via App Store or Google Play</p>
        </div>

        <div id="card-annual" class="rounded-2xl border border-white/10 bg-brand-gray-900 p-8 text-center relative transition-all duration-300">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2">
            <span class="text-[10px] uppercase tracking-[1.5px] font-medium text-brand-black bg-green-400 px-3 py-1 rounded-full">Best Value</span>
          </div>
          <p class="text-[11px] uppercase tracking-[3px] text-brand-gray-500 mb-4">Annual</p>
          <div class="flex items-baseline justify-center gap-1 mb-2">
            <span class="font-display text-5xl font-300">$70</span>
            <span class="text-brand-gray-500 text-lg">/year</span>
          </div>
          <p class="text-brand-gray-500 text-sm mb-6">Just $5.83/month, save $26</p>
          <p class="text-[11px] text-brand-gray-600">Subscribe in-app via App Store or Google Play</p>
        </div>
      </div>

      <!-- Confidence message -->
      <div class="rounded-xl border border-white/5 bg-white/[0.02] p-6 max-w-2xl mx-auto mb-10" data-scroll-reveal>
        <p class="text-center text-sm text-brand-gray-400 leading-relaxed">
          Try all of it free for a month. <span class="text-white font-medium">No limits, no commitment.</span>{' '}
          If it's not for you, cancel before the trial ends and you won't pay a thing.
        </p>
      </div>

      <!-- Features list -->
      <div class="rounded-2xl border border-white/10 bg-brand-gray-900 p-8 sm:p-10 max-w-3xl mx-auto" data-scroll-reveal>
        <p class="text-[11px] uppercase tracking-[3px] text-brand-gray-500 mb-6 text-center">Everything included in every plan</p>
        <div class="grid sm:grid-cols-2 gap-4 text-left max-w-lg mx-auto">
          {allFeatures.map((item) => (
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-sm text-brand-gray-400">{item}</span>
            </div>
