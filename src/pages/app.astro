    </div>
  </section>

  <Footer />
</Layout>

<script>
  // Billing toggle
  const toggle = document.getElementById('billing-toggle');
  const knob = document.getElementById('billing-knob');
  const labelMonthly = document.getElementById('label-monthly');
  const labelAnnual = document.getElementById('label-annual');
  const cardMonthly = document.getElementById('card-monthly');
  const cardAnnual = document.getElementById('card-annual');
  let isAnnual = false;

  toggle?.addEventListener('click', () => {
    isAnnual = !isAnnual;
    knob?.classList.toggle('translate-x-6', isAnnual);
    toggle.classList.toggle('bg-green-500', isAnnual);
    toggle.classList.toggle('bg-white/10', !isAnnual);
    labelMonthly?.classList.toggle('text-white', !isAnnual);
    labelAnnual?.classList.toggle('text-white', isAnnual);

    if (isAnnual) {
      cardAnnual?.classList.add('border-green-500/30', 'scale-[1.02]');
      cardAnnual?.classList.remove('border-white/10');
      cardMonthly?.classList.add('opacity-70');
    } else {
      cardAnnual?.classList.remove('border-green-500/30', 'scale-[1.02]');
      cardAnnual?.classList.add('border-white/10');
      cardMonthly?.classList.remove('opacity-70');
    }
  });

  // What's inside: one theme at a time
  const themeTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-theme-tab]'));
  const themePanels = Array.from(document.querySelectorAll<HTMLElement>('[data-theme-panel]'));
  themeTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const key = tab.dataset.themeTab;
      themeTabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      themePanels.forEach((p) => { p.hidden = p.dataset.themePanel !== key; });
    });
  });

  // FAQ accordion
  document.querySelectorAll('.faq-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const content = btn.nextElementSibling as HTMLElement;
      const chevron = btn.querySelector('.faq-chevron');
      const isOpen = !content.classList.contains('hidden');

      // Close all
      document.querySelectorAll('.faq-content').forEach((c) => c.classList.add('hidden'));
      document.querySelectorAll('.faq-chevron').forEach((c) => c.classList.remove('rotate-180'));

      // Toggle clicked
      if (!isOpen) {
        content.classList.remove('hidden');
        chevron?.classList.add('rotate-180');
      }
    });
  });
</script>

<style>
  @keyframes glassFadeIn {
    from { opacity: 0; transform: translateY(20px) scale(0.98); backdrop-filter: blur(0); }
    to   { opacity: 1; transform: translateY(0) scale(1); backdrop-filter: blur(24px); }
  }
  @keyframes contentFadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>
