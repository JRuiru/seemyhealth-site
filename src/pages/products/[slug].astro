---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ProductHero from '../../components/ProductHero.astro';
import ProductIntro from '../../components/ProductIntro.astro';
import ProductFeatures from '../../components/ProductFeatures.astro';
import ProductHowItWorks from '../../components/ProductHowItWorks.astro';
import ProductLifestyle from '../../components/ProductLifestyle.astro';
import ProductBenefits from '../../components/ProductBenefits.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import ProductSpecs from '../../components/ProductSpecs.astro';
import ProductVideo from '../../components/ProductVideo.astro';
import ProductCTA from '../../components/ProductCTA.astro';
import CrossSell from '../../components/CrossSell.astro';
import Footer from '../../components/Footer.astro';
import { products, productSlugs } from '../../data/products';
import { productContent } from '../../data/product-content';

export const prerender = true;

export function getStaticPaths() {
  return productSlugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const product = products[slug as string];
const content = productContent[slug as string];

const heroLifestyle = product.lifestyleImages.slice(0, 4);
const remainingLifestyle = product.lifestyleImages.slice(4);

const priceMatch = product.price.match(/\$([\d.]+)/);
const numericPrice = priceMatch ? priceMatch[1] : "0";

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  description: product.description,
  image: product.image,
  brand: {
    "@type": "Brand",
    name: "SeeMyHealth",
  },
  offers: {
    "@type": "Offer",
    url: `https://www.seemyhealth.ai/products/${slug}`,
    priceCurrency: "USD",
    price: numericPrice,
    availability: "https://schema.org/InStock",
    seller: {
      "@type": "Organization",
      name: "SeeMyHealth",
    },
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.seemyhealth.ai/" },
    { "@type": "ListItem", position: 2, name: "Products", item: "https://www.seemyhealth.ai/shop" },
    { "@type": "ListItem", position: 3, name: product.name, item: `https://www.seemyhealth.ai/products/${slug}` },
  ],
};
---

<Layout
  title={product.seoTitle || `${product.name} | SeeMyHealth`}
  description={product.description}
  ogImage={product.ogImage || product.image}
  ogType="product"
  canonicalPath={`/products/${slug}`}
  jsonLd={[productSchema, breadcrumbSchema]}
>
  <Navbar variant="product" productName={product.name} productColor={product.color} />

  <!-- GA4: view_item for product detail page -->
  <script define:vars={{ slug, productName: product.name, price: numericPrice }}>
    window.addEventListener('load', function() {
      if (window.gtag) {
        window.gtag('event', 'view_item', {
          currency: 'USD',
          value: parseFloat(price),
          items: [{ item_id: slug, item_name: productName, price: parseFloat(price), currency: 'USD' }],
        });
      }
    });
  </script>

  <!-- Hero -->
  <ProductHero
    slug={slug as string}
    name={product.name}
    tagline={product.tagline}
    headline={product.headline}
    description={product.description}
    image={product.image}
    streamId={product.streamId}
    price={product.price}
  />

  <!-- Text Intro -->
  {content && (
    <ProductIntro tagline={product.tagline} color={product.color}>
      <Fragment set:html={`${content.introLine1}<br /><span class="font-500">${content.introLine2}</span>`} />
    </ProductIntro>
  )}

  <!-- Key Value Highlights -->
  <ProductFeatures features={product.features} color={product.color} />

  <!-- How It Works -->
  {content && (
    <ProductHowItWorks color={product.color} steps={content.howItWorks} />
  )}

  <!-- Lifestyle Images -->
  <ProductLifestyle images={heroLifestyle} />

  <!-- What It Does for You -->
  {content && (
    <ProductBenefits headline={content.benefits.headline} color={product.color} benefits={content.benefits.items} backgroundImage={product.benefitsImage} />
  )}

  <!-- Gallery -->
  <ProductGallery images={remainingLifestyle} />

  <!-- Technical Specs -->
  <ProductSpecs slug={slug as string} name={product.name} price={product.price} specs={product.specs} backgroundImage={product.specImage} />

  <!-- Video -->
  <ProductVideo name={product.name} image={product.videoThumbnail || product.image} />

  <!-- Final CTA -->
  <ProductCTA slug={slug as string} name={product.name} price={product.price} color={product.color} />

  <!-- Cross-sell -->
  <CrossSell currentSlug={slug as string} />

  <Footer />
</Layout>
