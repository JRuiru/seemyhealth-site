---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;

const faqSections = [
  {
    title: "Getting Started",
    questions: [
      {
        q: "How do I download the SeeMyHealth app?",
        a: "The SeeMyHealth app is available on the App Store (iOS) and Google Play (Android). Search for \"SeeMyHealth\" and download it to start your free 1-month trial."
      },
      {
        q: "How do I create an account?",
        a: "Open the SeeMyHealth app and tap \"Create Account.\" Enter your email, set a password, and complete your health profile. You can also sign up at seemyhealth.ai."
      },
      {
        q: "How do I pair my device?",
        a: "Open the app, go to Settings > Devices > Add Device. Make sure Bluetooth is enabled on your phone. Follow the on-screen instructions for your specific device. The app will automatically detect nearby SeeMyHealth devices."
      },
      {
        q: "Do I need a subscription to use my device?",
        a: "The SeeMyHealth app requires a subscription, but it's a fraction of the cost of comparable health platforms. Every feature is included — we don't hide premium features like food tracking behind paywalls, we don't sell your data, and we don't run ads. The app stays fully focused on helping you understand your health. We offer a generous 1-month free trial, and you're free to cancel anytime."
      },
      {
        q: "What can I do in the app without a device?",
        a: "A lot. The SeeMyHealth app includes device-agnostic features like journalling, mood tracking, meal logging, recipes, and wellness content — all available with your subscription, no device required."
      }
    ]
  },
  {
    title: "Ring One",
    questions: [
      {
        q: "What does Ring One track?",
        a: "Ring One tracks heart rate, blood oxygen (SpO2), sleep stages, body temperature variation, activity, and stress levels — all from your finger, 24/7."
      },
      {
        q: "How do I find my ring size?",
        a: "We include a free sizing kit with every order. You can also request one separately at shop.seemyhealth.ai. We recommend wearing the sizing ring for at least 24 hours before deciding, as finger size changes throughout the day."
      },
      {
        q: "How long does the battery last?",
        a: "Ring One lasts up to 7 days on a single charge, depending on usage. Charging takes approximately 60 minutes."
      },
      {
        q: "Is Ring One water-resistant?",
        a: "Yes. Ring One is water-resistant up to 100 meters (10 ATM). You can wear it while swimming, showering, and washing hands."
      }
    ]
  },
  {
    title: "Smart Scale",
    questions: [
      {
        q: "What metrics does the Smart Scale measure?",
        a: "The Smart Scale measures weight, BMI, body fat percentage, muscle mass, bone density, water percentage, metabolic age, visceral fat, and protein levels using bioelectrical impedance analysis."
      },
      {
        q: "Can multiple people use the same scale?",
        a: "Yes. The Smart Scale supports up to 8 user profiles. It automatically recognizes each user and syncs data to their individual SeeMyHealth account."
      },
      {
        q: "Does the scale need Wi-Fi?",
        a: "The scale connects via Bluetooth to the SeeMyHealth app. Wi-Fi is optional but enables automatic background syncing without needing to open the app."
      }
    ]
  },
  {
    title: "BP Monitor",
    questions: [
      {
        q: "How accurate is the BP Monitor?",
        a: "The SeeMyHealth BP Monitor is clinically validated and meets international accuracy standards. For the most accurate readings, sit comfortably with your arm at heart level and remain still during measurement."
      },
      {
        q: "How do I take a reading?",
        a: "Wrap the cuff snugly around your upper arm, sit relaxed for 1 minute, then press the start button on the device or tap \"Measure\" in the app. Results appear in about 30 seconds."
      },
      {
        q: "Can I share readings with my doctor?",
        a: "Yes. In the SeeMyHealth app, go to Settings > Sharing and toggle access for your healthcare provider. They'll be authenticated and can view your BP history directly — no PDFs, no emails. You control access with a single switch and can revoke it at any time."
      }
    ]
  },
  {
    title: "Hydra One",
    questions: [
      {
        q: "What does Hydra One track?",
        a: "Hydra One is a smart water bottle that tracks your water intake, reminds you to drink, and syncs hydration data with the SeeMyHealth app for a complete picture of your daily health."
      },
      {
        q: "How does it measure water intake?",
        a: "Hydra One uses a precision sensor in the base to measure how much water you drink throughout the day. Every sip is automatically logged."
      },
      {
        q: "Is Hydra One dishwasher safe?",
        a: "The bottle body is hand-wash only to protect the sensor unit in the base. The cap can be placed in the dishwasher. The sensor base is sealed and splash-proof."
      },
      {
        q: "How long does the battery last?",
        a: "Hydra One's battery lasts up to 30 days on a single charge. It charges via USB-C."
      }
    ]
  },
  {
    title: "Hema One",
    questions: [
      {
        q: "What does Hema One analyze?",
        a: "Hema One is a compact blood analyzer that measures key biomarkers including glucose, cholesterol (total, HDL, LDL), triglycerides, and hemoglobin from a small finger-prick sample."
      },
      {
        q: "Is Hema One a medical device?",
        a: "Hema One is designed for personal health monitoring. While it uses clinical-grade sensor technology, it is not a substitute for professional lab testing. Always consult your doctor for medical decisions."
      },
      {
        q: "How often should I test?",
        a: "For general wellness monitoring, weekly or bi-weekly testing provides good trend data. Your healthcare provider can recommend a testing schedule based on your specific health needs."
      },
      {
        q: "What test strips does it use?",
        a: "Hema One uses proprietary multi-panel test strips available at shop.seemyhealth.ai. Each strip provides a full biomarker panel from a single sample."
      }
    ]
  },
  {
    title: "App & Data",
    questions: [
      {
        q: "How do I share my health data?",
        a: "We use an integrated sharing system — no file exports needed. Anyone who needs access to your data (like a doctor or family member) must be properly authenticated. In the app, just toggle a switch to grant or revoke access. This keeps your data extremely safe — it never leaves our encrypted system."
      },
      {
        q: "Does the app work with Apple Health or Google Fit?",
        a: "Yes. SeeMyHealth integrates with Apple Health (iOS) and Google Fit (Android). You can sync data bidirectionally in Settings > Integrations."
      },
      {
        q: "How is my health data secured?",
        a: "All health data is encrypted in transit (TLS 1.3) and at rest (AES-256). We never sell your data. You can request deletion of your data at any time by sending a deletion request through the app."
      }
    ]
  },
  {
    title: "Shipping & Returns",
    questions: [
      {
        q: "Where do you ship?",
        a: "We currently ship to the United States, Canada, United Kingdom, and the European Union. More regions coming soon."
      },
      {
        q: "How long does shipping take?",
        a: "Standard shipping takes 5–7 business days within the US. Express shipping (2–3 business days) is available at checkout. International orders typically take 7–14 business days."
      },
      {
        q: "What is your return policy?",
        a: "We offer a 30-day return policy for unused, unopened products in original packaging. Contact support@seemyhealth.ai with your order number to initiate a return. Refunds are processed within 10 business days."
      },
      {
        q: "Can I cancel my order?",
        a: "Orders can be cancelled within 2 hours of placement. After that, the order may have already entered fulfillment. Contact support@seemyhealth.ai as soon as possible."
      }
    ]
  },
  {
    title: "Warranty",
    questions: [
      {
        q: "What warranty do SeeMyHealth devices come with?",
        a: "All SeeMyHealth devices come with a 2-year limited warranty covering manufacturing defects. The warranty does not cover damage from misuse, accidents, or unauthorized modifications."
      },
      {
        q: "How do I file a warranty claim?",
        a: "Contact support@seemyhealth.ai with your order number, device serial number, and a description of the issue. Our team will guide you through the warranty process."
      },
      {
        q: "Do you offer extended warranty?",
        a: "Yes. An extended warranty (up to 3 years total) can be purchased at checkout or within 30 days of your original purchase at shop.seemyhealth.ai."
      }
    ]
  }
];
---

<Layout title="Support & FAQ — SeeMyHealth">
  <Navbar />

  <!-- Hero -->
  <section class="pt-32 pb-16 bg-brand-black">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4" data-scroll-reveal>Help Center</p>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-300 uppercase leading-[0.95] mb-6" data-scroll-reveal>
        Support & <span class="font-500">FAQ</span>
      </h1>
      <p class="text-lg text-brand-gray-400 leading-relaxed max-w-lg">
        Find answers to common questions about your SeeMyHealth devices and services.
      </p>
    </div>
  </section>

  <!-- FAQ Sections -->
  <section class="py-16 sm:py-24 bg-brand-black border-t border-white/5">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 space-y-16">

      {faqSections.map((section, sectionIndex) => (
        <div>
          <h2 class="font-display text-2xl uppercase mb-6" data-scroll-reveal>{section.title}</h2>
          <div class="border-t border-white/10">
            {section.questions.map((item, i) => (
              <div class="border-b border-white/5">
                <button
                  class="faq-toggle w-full flex items-center justify-between py-5 text-left group"
                  data-faq={`${sectionIndex}-${i}`}
                >
                  <span class="text-sm text-white pr-8 group-hover:text-brand-gray-300 transition-colors">{item.q}</span>
                  <svg
                    class="faq-icon w-5 h-5 text-brand-gray-600 shrink-0 transition-transform duration-300"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v12M6 12h12" />
                  </svg>
                </button>
                <div class="faq-answer hidden pb-5" data-faq-answer={`${sectionIndex}-${i}`}>
                  <p class="text-sm text-brand-gray-500 leading-relaxed pl-0">{item.a}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}

    </div>
  </section>

  <!-- Contact Section -->
  <section class="py-24 sm:py-32 bg-brand-dark border-t border-white/5">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4" data-scroll-reveal>Still Need Help?</p>
      <h2 class="font-display text-3xl sm:text-4xl font-300 uppercase leading-[0.95] mb-6" data-scroll-reveal>
        Get in <span class="font-500">Touch</span>
      </h2>
      <p class="text-brand-gray-500 mb-10 max-w-md mx-auto text-sm leading-relaxed">
        Our support team is here to help. Reach out and we'll get back to you within 24 hours.
      </p>
      <a
        href="mailto:support@seemyhealth.ai"
        class="inline-flex items-center px-10 py-4 text-[13px] uppercase tracking-[1.5px] font-medium text-brand-black bg-white rounded-full hover:bg-brand-gray-200 transition-colors"
      >
        Email Support
      </a>
      <p class="text-brand-gray-600 text-sm mt-6">
        <a href="mailto:support@seemyhealth.ai" class="hover:text-white transition-colors">support@seemyhealth.ai</a>
      </p>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggles = document.querySelectorAll('.faq-toggle');

    toggles.forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const id = toggle.getAttribute('data-faq');
        const answer = document.querySelector(`[data-faq-answer="${id}"]`);
        const icon = toggle.querySelector('.faq-icon');

        if (!answer || !icon) return;

        const isOpen = !answer.classList.contains('hidden');

        if (isOpen) {
          answer.classList.add('hidden');
          icon.style.transform = 'rotate(0deg)';
        } else {
          answer.classList.remove('hidden');
          icon.style.transform = 'rotate(45deg)';
        }
      });
    });
  });
</script>
