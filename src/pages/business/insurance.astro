---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export const prerender = true;

const programs = [
  {
    title: "Member Wellness Programs",
    description: "Ship device kits to members enrolled in chronic disease management or wellness incentive programs. Data flows back to your care teams automatically.",
    icon: "M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z",
    image: "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg/insurance-wellness/public",
  },
  {
    title: "Preventative Health",
    description: "Members who track their vitals daily build healthier habits and catch issues early. Healthier members mean fewer claims, naturally. Prevention over reaction.",
    icon: "M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z",
    image: "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg/insurance-preventative/public",
  },
  {
    title: "Members Feel Valued",
    description: "When members receive devices and see their insurer investing in their wellbeing, trust goes up. Engagement follows. Retention follows that. It's care they can hold in their hands.",
    icon: "M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z",
    image: "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg/insurance-members-valued-v2/public",
  },
];

const benefits = [
  { metric: "23%", label: "Lower cost of care", description: "Early intervention through continuous monitoring" },
  { metric: "4.2x", label: "Member engagement", description: "vs. traditional wellness app programs" },
  { metric: "68%", label: "Program retention", description: "Devices create lasting health habits" },
];

const capabilities = [
  { title: "Volume Discounts", description: "Tiered pricing based on member enrollment size" },
  { title: "Co-branded Kits", description: "Device packages with your branding and welcome materials" },
  { title: "Dedicated Account Manager", description: "Single point of contact for onboarding and support" },
  { title: "Flexible Partnerships", description: "Subsidized, incentive-based, or fully covered models" },
];
---

<Layout
  title="Insurance Partners | SeeMyHealth for Business"
  description="Member wellness programs, risk stratification, and value-based care support. White-label device kits with population analytics."
  canonicalPath="/business/insurance"
>
  <Navbar />

  <!-- Hero -->
  <section class="pt-32 pb-20 sm:pt-40 sm:pb-28 bg-brand-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="max-w-3xl">
          <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-6">
            For Business / Insurance Partners
          </p>
          <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-300 uppercase leading-[0.95] mb-6">
            Healthier members. <span class="font-500">Lower claims.</span>
          </h1>
          <p class="text-lg text-brand-gray-400 leading-relaxed mb-10 max-w-xl">
            Give members the tools to manage their health proactively. Continuous biometric data replaces annual snapshots with real-time insight, for members and care teams alike.
          </p>
          <div class="flex flex-wrap gap-4">
            <a
              href="#contact"
              class="inline-flex items-center px-8 py-4 text-[13px] uppercase tracking-[1.5px] font-medium text-brand-black bg-white rounded-full hover:bg-brand-gray-200 transition-colors"
            >
              Schedule a demo
              <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>
        <div class="relative rounded-2xl overflow-hidden">
          <img
            src="https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg/insurance-hero/public"
            alt="Insurance partner reviewing SeeMyHealth device kits with analytics dashboard"
            class="w-full h-auto rounded-2xl"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Portal preview -->
  <section class="pb-20 sm:pb-28 bg-brand-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="relative rounded-2xl border border-white/10 bg-brand-gray-900 overflow-hidden aspect-[16/9] sm:aspect-[2.2/1] flex items-center justify-center">
        <div class="text-center">
          <img
            src="https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg/logo/public"
            alt="SeeMyHealth"
            class="w-16 h-16 mx-auto mb-4 opacity-30"
          />
          <p class="text-brand-gray-600 text-sm">Product video coming soon</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Programs -->
  <section class="py-20 sm:py-28 bg-brand-black border-t border-white/5">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-10">Programs</p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {programs.map((item) => (
          <div class="group rounded-2xl bg-brand-gray-900 border border-white/5 hover:border-white/15 overflow-hidden transition-all duration-300">
            {item.image ? (
              <div class="aspect-[4/3] overflow-hidden">
                <img src={item.image} alt={item.title} class="w-full h-full object-cover" loading="lazy" />
              </div>
            ) : (
              <div class="aspect-[4/3] bg-brand-gray-800 flex items-center justify-center">
                <svg class="w-10 h-10 text-brand-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                </svg>
              </div>
            )}
            <div class="p-6">
              <h3 class="text-xl font-medium text-white mb-2">{item.title}</h3>
              <p class="text-sm text-brand-gray-400 leading-relaxed">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Outcomes -->
  <section class="py-20 sm:py-28 bg-brand-black border-t border-white/5">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-10">Projected Outcomes</p>

      <div class="grid sm:grid-cols-3 gap-6">
        {benefits.map((item) => (
          <div class="rounded-xl bg-brand-gray-900 border border-white/5 p-8 text-center">
            <p class="font-display text-5xl font-300 text-white mb-2">{item.metric}</p>
            <p class="text-sm font-medium text-white mb-1">{item.label}</p>
            <p class="text-[12px] text-brand-gray-500">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Partnership Benefits -->
  <section class="py-20 sm:py-28 bg-brand-black border-t border-white/5">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-10">Partnership Benefits</p>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {capabilities.map((item) => (
          <div class="rounded-xl bg-brand-gray-900 border border-white/5 p-6">
            <h4 class="text-white font-medium mb-1">{item.title}</h4>
            <p class="text-[12px] text-brand-gray-500">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact / CTA -->
  <section id="contact" class="py-20 sm:py-28 bg-brand-black border-t border-white/5">
    <div class="max-w-3xl mx-auto px-6 lg:px-8 text-center">
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">Get Started</p>
      <h2 class="font-display text-4xl sm:text-5xl font-300 uppercase leading-[0.95] mb-4">
        See it <span class="font-500">in action</span>
      </h2>
      <p class="text-brand-gray-400 leading-relaxed max-w-xl mx-auto mb-10">
        We'll walk you through the member experience, clinician dashboard, and population analytics, tailored to your plan structure.
      </p>

      <form id="contact-form" class="max-w-md mx-auto space-y-4 text-left">
        <input
          type="text"
          name="company"
          placeholder="Organization name"
          required
          minlength="2"
          class="w-full px-4 py-3.5 bg-brand-gray-900 border border-white/10 rounded-xl text-sm text-white placeholder-brand-gray-600 focus:outline-none focus:border-white/30 transition-colors"
        />
        <div class="grid grid-cols-2 gap-4">
          <input
            type="text"
            name="name"
            placeholder="Your name"
            required
            class="w-full px-4 py-3.5 bg-brand-gray-900 border border-white/10 rounded-xl text-sm text-white placeholder-brand-gray-600 focus:outline-none focus:border-white/30 transition-colors"
          />
          <input
            type="email"
            name="email"
            placeholder="Work email"
            required
            class="w-full px-4 py-3.5 bg-brand-gray-900 border border-white/10 rounded-xl text-sm text-white placeholder-brand-gray-600 focus:outline-none focus:border-white/30 transition-colors"
          />
        </div>
        <select name="model" required class="w-full px-4 py-3.5 bg-brand-gray-900 border border-white/10 rounded-xl text-sm text-brand-gray-600 focus:outline-none focus:border-white/30 transition-colors appearance-none">
          <option value="">Organization type</option>
          <option value="health-plan">Health Plan / Payer</option>
          <option value="employer">Employer Benefits</option>
          <option value="tpa">TPA / Benefits Administrator</option>
          <option value="other">Other</option>
        </select>
        <textarea
          name="message"
          placeholder="Tell us about your member population and goals"
          rows="3"
          required
          minlength="10"
          class="w-full px-4 py-3.5 bg-brand-gray-900 border border-white/10 rounded-xl text-sm text-white placeholder-brand-gray-600 focus:outline-none focus:border-white/30 transition-colors resize-none"
        ></textarea>
        <button
          type="submit"
          id="contact-submit"
          class="w-full px-8 py-4 text-[13px] uppercase tracking-[1.5px] font-medium text-brand-black bg-white rounded-full hover:bg-brand-gray-200 transition-colors"
        >
          Schedule a Demo
        </button>
        <p id="contact-status" class="text-center text-sm hidden"></p>
      </form>
    </div>
  </section>

  <Footer />

  <script>
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const btn = document.getElementById("contact-submit") as HTMLButtonElement;
    const status = document.getElementById("contact-status") as HTMLParagraphElement;
    const errorClass = "!border-red-500/60";
    const validClass = "!border-green-500/40";

    function clearFieldStates() {
      form.querySelectorAll("input, select, textarea").forEach((el) => {
        el.classList.remove(errorClass, validClass);
      });
    }

    function validateField(el: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement): string | null {
      const val = el.value.trim();
      const label = ("placeholder" in el && el.placeholder) || el.name;
      if (el.hasAttribute("required") && !val) return `${label} is required`;
      if (el.type === "email" && val && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) return "Please enter a valid email";
      const min = el.getAttribute("minlength");
      if (min && val.length < Number(min)) return `${label} must be at least ${min} characters`;
      return null;
    }

    form.querySelectorAll("input, select, textarea").forEach((el) => {
      el.addEventListener("blur", () => {
        const error = validateField(el as HTMLInputElement);
        el.classList.remove(errorClass, validClass);
        el.classList.add(error ? errorClass : validClass);
      });
      el.addEventListener("input", () => {
        el.classList.remove(errorClass);
      });
    });

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      clearFieldStates();
      status.classList.add("hidden");

      const fields = Array.from(form.querySelectorAll("input, select, textarea")) as HTMLInputElement[];
      const errors: string[] = [];

      fields.forEach((el) => {
        const error = validateField(el);
        if (error) {
          errors.push(error);
          el.classList.add(errorClass);
        } else {
          el.classList.add(validClass);
        }
      });

      if (errors.length) {
        status.textContent = errors[0];
        status.className = "text-center text-sm text-red-400";
        return;
      }

      btn.disabled = true;
      btn.textContent = "Sending...";

      const data = {
        source: "Insurance",
        company: (form.elements.namedItem("company") as HTMLInputElement).value.trim(),
        name: (form.elements.namedItem("name") as HTMLInputElement).value.trim(),
        email: (form.elements.namedItem("email") as HTMLInputElement).value.trim(),
        model: (form.elements.namedItem("model") as HTMLSelectElement).value,
        message: (form.elements.namedItem("message") as HTMLTextAreaElement).value.trim(),
      };

      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });

        if (!res.ok) {
          const err = await res.json();
          throw new Error(err.error || "Something went wrong");
        }

        form.reset();
        clearFieldStates();
        status.textContent = "Thanks! We'll be in touch soon.";
        status.className = "text-center text-sm text-green-400";
      } catch (err) {
        status.textContent = err instanceof Error ? err.message : "Something went wrong. Please try again.";
        status.className = "text-center text-sm text-red-400";
      } finally {
        btn.disabled = false;
        btn.textContent = "Schedule a Demo";
      }
    });
  </script>
</Layout>
