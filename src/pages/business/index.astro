---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export const prerender = true;

const partnerModels = [
  {
    title: "Bulk Orders",
    description: "Volume discounts on SeeMyHealth devices. Tiered pricing based on order size, MSRP support, and dedicated account management.",
    icon: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4",
    image: "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg/distribution-bulk/public",
  },
  {
    title: "Distribution Partners",
    description: "Bring SeeMyHealth to new markets. We provide inventory, marketing support, and regional pricing. You own the local relationship.",
    icon: "M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418",
    image: "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg/distribution-partners/public",
  },
  {
    title: "Hardware-as-a-Service",
    description: "Per-member-per-month billing. We handle logistics, replacement, and support. Ideal for gyms, clinics, and wellness programmes.",
    icon: "M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008z",
    image: "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg/distribution-haas/public",
  },
];

const portalFeatures = [
  { title: "Inventory", description: "Real-time stock + ETA" },
  { title: "Marketing assets", description: "Product photography, copy" },
  { title: "Orders", description: "Bulk + drop-ship modes" },
  { title: "Dashboards", description: "Sell-through, returns, RMA" },
];

const logistics = [
  { title: "East Africa", description: "Nairobi warehouse" },
  { title: "Middle East", description: "Qatar warehouse" },
  { title: "Americas", description: "US warehouse" },
  { title: "Asia-Pacific", description: "Shenzhen warehouse" },
];

---

<Layout
  title="For Business | SeeMyHealth"
  description="Partner with SeeMyHealth. Bulk order discounts, distribution partnerships, and hardware-as-a-service options for health & wellness businesses."
  canonicalPath="/business"
>
  <Navbar />

  <!-- Hero -->
  <section class="pt-32 pb-20 sm:pt-40 sm:pb-28 bg-brand-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="max-w-3xl">
          <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-6">
            For Business / Distribution
          </p>
          <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-300 uppercase leading-[0.95] mb-6">
            Carry the platform. <span class="font-500">Keep the relationship.</span>
          </h1>
          <p class="text-lg text-brand-gray-400 leading-relaxed mb-10 max-w-xl">
            Bulk order discounts, distribution partnerships in new markets, and hardware-as-a-service options for businesses.
          </p>
          <div class="flex flex-wrap gap-4">
            <a
              href="#contact"
              class="inline-flex items-center px-8 py-4 text-[13px] uppercase tracking-[1.5px] font-medium text-brand-black bg-white rounded-full hover:bg-brand-gray-200 transition-colors"
            >
              Talk to sales
              <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>
        <div class="relative rounded-2xl overflow-hidden">
          <img
            src="https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg/distribution-hero/public"
            alt="Distribution partner holding SeeMyHealth product boxes in warehouse"
            class="w-full h-auto rounded-2xl"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Portal preview -->
  <section class="pb-20 sm:pb-28 bg-brand-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="relative rounded-2xl border border-white/10 bg-brand-gray-900 overflow-hidden aspect-[16/9] sm:aspect-[2.2/1] flex items-center justify-center">
        <div class="text-center">
          <img
            src="https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg/logo/public"
            alt="SeeMyHealth"
            class="w-16 h-16 mx-auto mb-4 opacity-30"
          />
          <p class="text-brand-gray-600 text-sm">Product video coming soon</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Partner Models -->
  <section class="py-20 sm:py-28 bg-brand-black border-t border-white/5">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-10">Partner Models</p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {partnerModels.map((model) => (
          <div class="group rounded-2xl bg-brand-gray-900 border border-white/5 hover:border-white/15 overflow-hidden transition-all duration-300">
            {model.image ? (
              <div class="aspect-[4/3] overflow-hidden">
                <img src={model.image} alt={model.title} class="w-full h-full object-cover" loading="lazy" />
              </div>
            ) : (
              <div class="aspect-[4/3] bg-brand-gray-800 flex items-center justify-center">
                <svg class="w-10 h-10 text-brand-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                  <path stroke-linecap="round" stroke-linejoin="round" d={model.icon} />
                </svg>
              </div>
            )}
            <div class="p-6">
              <h3 class="text-xl font-medium text-white mb-2">{model.title}</h3>
              <p class="text-sm text-brand-gray-400 leading-relaxed">{model.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Partner Portal -->
  <section class="py-20 sm:py-28 bg-brand-black border-t border-white/5">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-10">Partner Portal</p>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {portalFeatures.map((feature) => (
          <div class="rounded-xl bg-brand-gray-900 border border-white/5 p-6">
            <h4 class="text-white font-medium mb-1">{feature.title}</h4>
            <p class="text-[12px] text-brand-gray-500">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Logistics -->
  <section class="py-20 sm:py-28 bg-brand-black border-t border-white/5">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-10">Logistics</p>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {logistics.map((item) => (
          <div class="rounded-xl bg-brand-gray-900 border border-white/5 p-6">
            <h4 class="text-xl font-medium text-white mb-1">{item.title}</h4>
            <p class="text-[12px] text-brand-gray-500">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact / CTA -->
  <section id="contact" class="py-20 sm:py-28 bg-brand-black border-t border-white/5">
    <div class="max-w-3xl mx-auto px-6 lg:px-8 text-center">
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">Get Started</p>
      <h2 class="font-display text-4xl sm:text-5xl font-300 uppercase leading-[0.95] mb-4">
        Let's build <span class="font-500">together</span>
      </h2>
      <p class="text-brand-gray-400 leading-relaxed max-w-xl mx-auto mb-10">
        Whether you're a gym chain, wellness brand, or healthcare provider, we'll find the right model for your business.
      </p>

      <form id="contact-form" class="max-w-md mx-auto space-y-4 text-left">
        <div>
          <input
            type="text"
            name="company"
            placeholder="Company name"
            required
            minlength="2"
            class="w-full px-4 py-3.5 bg-brand-gray-900 border border-white/10 rounded-xl text-sm text-white placeholder-brand-gray-600 focus:outline-none focus:border-white/30 transition-colors"
          />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <input
            type="text"
            name="name"
            placeholder="Your name"
            required
            class="w-full px-4 py-3.5 bg-brand-gray-900 border border-white/10 rounded-xl text-sm text-white placeholder-brand-gray-600 focus:outline-none focus:border-white/30 transition-colors"
          />
          <input
            type="email"
            name="email"
            placeholder="Work email"
            required
            class="w-full px-4 py-3.5 bg-brand-gray-900 border border-white/10 rounded-xl text-sm text-white placeholder-brand-gray-600 focus:outline-none focus:border-white/30 transition-colors"
          />
        </div>
        <div>
          <select name="model" required class="w-full px-4 py-3.5 bg-brand-gray-900 border border-white/10 rounded-xl text-sm text-brand-gray-600 focus:outline-none focus:border-white/30 transition-colors appearance-none">
            <option value="">Partnership model</option>
            <option value="bulk">Bulk Orders</option>
            <option value="distribution">Distribution Partner</option>
            <option value="haas">Hardware-as-a-Service</option>
            <option value="other">Other / Not sure</option>
          </select>
        </div>
        <div>
          <textarea
            name="message"
            placeholder="Tell us about your business"
            rows="3"
            required
            minlength="10"
            class="w-full px-4 py-3.5 bg-brand-gray-900 border border-white/10 rounded-xl text-sm text-white placeholder-brand-gray-600 focus:outline-none focus:border-white/30 transition-colors resize-none"
          ></textarea>
        </div>
        <button
          type="submit"
          id="contact-submit"
          class="w-full px-8 py-4 text-[13px] uppercase tracking-[1.5px] font-medium text-brand-black bg-white rounded-full hover:bg-brand-gray-200 transition-colors"
        >
          Talk to Sales
        </button>
        <p id="contact-status" class="text-center text-sm hidden"></p>
      </form>
    </div>
  </section>

  <Footer />

  <script>
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const btn = document.getElementById("contact-submit") as HTMLButtonElement;
    const status = document.getElementById("contact-status") as HTMLParagraphElement;
    const errorClass = "!border-red-500/60";
    const validClass = "!border-green-500/40";

    function clearFieldStates() {
      form.querySelectorAll("input, select, textarea").forEach((el) => {
        el.classList.remove(errorClass, validClass);
      });
    }

    function validateField(el: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement): string | null {
      const val = el.value.trim();
      const label = ("placeholder" in el && el.placeholder) || el.name;
      if (el.hasAttribute("required") && !val) return `${label} is required`;
      if (el.type === "email" && val && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) return "Please enter a valid email";
      const min = el.getAttribute("minlength");
      if (min && val.length < Number(min)) return `${label} must be at least ${min} characters`;
      return null;
    }

    // Live validation on blur
    form.querySelectorAll("input, select, textarea").forEach((el) => {
      el.addEventListener("blur", () => {
        const error = validateField(el as HTMLInputElement);
        el.classList.remove(errorClass, validClass);
        el.classList.add(error ? errorClass : validClass);
      });
      el.addEventListener("input", () => {
        el.classList.remove(errorClass);
      });
    });

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      clearFieldStates();
      status.classList.add("hidden");

      const fields = Array.from(form.querySelectorAll("input, select, textarea")) as HTMLInputElement[];
      const errors: string[] = [];

      fields.forEach((el) => {
        const error = validateField(el);
        if (error) {
          errors.push(error);
          el.classList.add(errorClass);
        } else {
          el.classList.add(validClass);
        }
      });

      if (errors.length) {
        status.textContent = errors[0];
        status.className = "text-center text-sm text-red-400";
        return;
      }

      btn.disabled = true;
      btn.textContent = "Sending...";

      const data = {
        source: "Distribution",
        company: (form.elements.namedItem("company") as HTMLInputElement).value.trim(),
        name: (form.elements.namedItem("name") as HTMLInputElement).value.trim(),
        email: (form.elements.namedItem("email") as HTMLInputElement).value.trim(),
        model: (form.elements.namedItem("model") as HTMLSelectElement).value,
        message: (form.elements.namedItem("message") as HTMLTextAreaElement).value.trim(),
      };

      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });

        if (!res.ok) {
          const err = await res.json();
          throw new Error(err.error || "Something went wrong");
        }

        form.reset();
        clearFieldStates();
        status.textContent = "Thanks! We'll be in touch soon.";
        status.className = "text-center text-sm text-green-400";
      } catch (err) {
        status.textContent = err instanceof Error ? err.message : "Something went wrong. Please try again.";
        status.className = "text-center text-sm text-red-400";
      } finally {
        btn.disabled = false;
        btn.textContent = "Talk to Sales";
      }
    });
  </script>
</Layout>
