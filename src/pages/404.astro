---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;

const CF_IMG = "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg";

const funMessages = [
  { headline: "Even your Ring One can't find this page.", subtext: "And it tracks everything." },
  { headline: "This page took a sick day.", subtext: "Unlike our devices, which never do." },
  { headline: "404: Vitals not detected.", subtext: "This page has flatlined. But your health journey doesn't have to." },
  { headline: "Hydra One says: drink water and try again.", subtext: "Hydration fixes most things. Maybe not this, though." },
  { headline: "Our Scale checked. This page weighs nothing.", subtext: "Because it doesn't exist." },
  { headline: "BP reading: page not found.", subtext: "Your blood pressure is fine. This URL, not so much." },
];

const suggestions = [
  { name: "Ring One", slug: "ring-one", image: `${CF_IMG}/ring-hero-hands/public`, color: "#F97316" },
  { name: "The Scale", slug: "scale", image: `${CF_IMG}/scale-white-bathroom/public`, color: "#3B82F6" },
  { name: "BP Monitor", slug: "bp-monitor", image: `${CF_IMG}/bp-white-desk-display/public`, color: "#EF4444" },
  { name: "Hydra One", slug: "hydra-one", image: `${CF_IMG}/bottle-white-kitchen/public`, color: "#06B6D4" },
];
---

<Layout title="Page Not Found | SeeMyHealth" description="The page you're looking for doesn't exist." noindex={true}>
  <Navbar />

  <section class="min-h-[80vh] flex flex-col items-center justify-center bg-brand-black relative overflow-hidden">
    <!-- Background device collage -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <img
        src={`${CF_IMG}/ring-hero-hands/public`}
        alt=""
        class="absolute -top-10 -right-20 w-64 h-64 object-cover rounded-3xl opacity-[0.06] rotate-12 blur-[1px]"
      />
      <img
        src={`${CF_IMG}/bottle-white-kitchen/public`}
        alt=""
        class="absolute -bottom-10 -left-10 w-56 h-56 object-cover rounded-3xl opacity-[0.06] -rotate-6 blur-[1px]"
      />
      <img
        src={`${CF_IMG}/scale-white-bathroom/public`}
        alt=""
        class="absolute top-1/4 -left-20 w-48 h-48 object-cover rounded-3xl opacity-[0.04] rotate-3 blur-[1px] hidden sm:block"
      />
      <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full bg-white/[0.015] blur-[100px]"></div>
    </div>

    <div class="max-w-2xl mx-auto px-6 text-center relative z-10 py-16 sm:py-20">
      <!-- Heartbeat line + 404 -->
      <div class="relative mb-8">
        <!-- ECG line -->
        <svg class="w-full max-w-md mx-auto h-16 mb-2 opacity-20" viewBox="0 0 400 60" fill="none" preserveAspectRatio="xMidYMid meet">
          <path
            d="M0 30 L80 30 L100 30 L120 10 L140 50 L160 5 L180 55 L200 30 L220 30 L400 30"
            stroke="url(#ecg-gradient)"
            stroke-width="2"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="ecg-draw"
          />
          <defs>
            <linearGradient id="ecg-gradient" x1="0" y1="0" x2="400" y2="0">
              <stop offset="0%" stop-color="#ffffff" stop-opacity="0" />
              <stop offset="30%" stop-color="#EF4444" stop-opacity="0.8" />
              <stop offset="50%" stop-color="#EF4444" stop-opacity="1" />
              <stop offset="70%" stop-color="#EF4444" stop-opacity="0.8" />
              <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
            </linearGradient>
          </defs>
        </svg>

        <p class="font-display text-[100px] sm:text-[140px] font-300 leading-none text-transparent bg-clip-text bg-gradient-to-b from-white/25 to-white/5 select-none">
          404
        </p>
      </div>

      <!-- Fun rotating message -->
      <div id="fun-message" class="mb-10">
        <h1 class="font-display text-xl sm:text-2xl font-300 uppercase tracking-wide mb-2 text-white leading-snug fun-headline">
        </h1>
        <p class="text-sm text-brand-gray-400 fun-subtext"></p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14">
        <a
          href="/"
          class="inline-flex items-center px-8 py-3.5 text-[12px] uppercase tracking-[1.5px] font-medium text-brand-black bg-white rounded-full hover:bg-brand-gray-200 transition-colors"
        >
          Take Me Home
        </a>
        <a
          href="/shop"
          class="inline-flex items-center gap-2 px-8 py-3.5 text-[12px] uppercase tracking-[1.5px] font-medium text-white border border-white/20 rounded-full hover:border-white/40 transition-colors"
        >
          Shop Devices
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
          </svg>
        </a>
      </div>

      <!-- Device suggestions -->
      <div>
        <p class="text-[10px] uppercase tracking-[3px] text-brand-gray-600 mb-5">While you're here</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          {suggestions.map((device) => (
            <a
              href={`/products/${device.slug}`}
              class="group rounded-xl bg-brand-gray-900 border border-white/5 hover:border-white/15 overflow-hidden transition-all"
            >
              <div class="aspect-square overflow-hidden">
                <img
                  src={device.image}
                  alt={device.name}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-80 group-hover:opacity-100"
                />
              </div>
              <div class="p-3 flex items-center gap-2">
                <div class="w-1.5 h-1.5 rounded-full flex-shrink-0" style={`background-color: ${device.color}`}></div>
                <p class="text-[11px] text-brand-gray-400 group-hover:text-white transition-colors truncate">{device.name}</p>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Helpful links -->
      <div class="mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        <a href="/support" class="text-[11px] uppercase tracking-[1.5px] text-brand-gray-600 hover:text-white transition-colors">Support</a>
        <a href="/app" class="text-[11px] uppercase tracking-[1.5px] text-brand-gray-600 hover:text-white transition-colors">The App</a>
        <a href="/about" class="text-[11px] uppercase tracking-[1.5px] text-brand-gray-600 hover:text-white transition-colors">About Us</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .ecg-draw {
    stroke-dasharray: 800;
    stroke-dashoffset: 800;
    animation: ecg-trace 2.5s ease-in-out forwards, ecg-pulse 4s ease-in-out 2.5s infinite;
  }

  @keyframes ecg-trace {
    to { stroke-dashoffset: 0; }
  }

  @keyframes ecg-pulse {
    0%, 100% { opacity: 0.2; }
    50% { opacity: 0.4; }
  }
</style>

<script define:vars={{ funMessages }}>
  const idx = Math.floor(Math.random() * funMessages.length);
  const msg = funMessages[idx];
  document.querySelector('.fun-headline').textContent = msg.headline;
  document.querySelector('.fun-subtext').textContent = msg.subtext;
</script>
