---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;
---

<Layout title="Page Not Found — SeeMyHealth" description="The page you're looking for doesn't exist." noindex={true}>
  <Navbar />

  <section class="min-h-[80vh] flex items-center justify-center bg-brand-black">
    <div class="max-w-lg mx-auto px-6 text-center">
      <p class="font-display text-[120px] sm:text-[160px] font-300 leading-none text-brand-gray-900 mb-2">404</p>
      <h1 class="font-display text-2xl sm:text-3xl font-400 uppercase tracking-wide mb-4">Page Not Found</h1>
      <p class="text-sm text-brand-gray-500 leading-relaxed mb-10">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center px-8 py-3.5 text-[12px] uppercase tracking-[1.5px] font-medium text-brand-black bg-white rounded-full hover:bg-brand-gray-200 transition-colors"
        >
          Back to Home
        </a>
        <a
          href="/shop"
          class="inline-flex items-center px-8 py-3.5 text-[12px] uppercase tracking-[1.5px] font-medium text-white border border-white/20 rounded-full hover:border-white/40 transition-colors"
        >
          Shop Devices
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
