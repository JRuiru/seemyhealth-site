---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export const prerender = true;

// Where the hosted checkout (Flutterwave) sends the browser after a payment attempt. With the
// app installed the redirect is intercepted as a universal link and never reaches the browser;
// anyone landing HERE paid from the in-app browser sheet or a device without the app. The charge
// itself is confirmed by webhook — the app polls payment status — so this page only closes the
// loop: read Flutterwave's ?status= and point the person back at the app.
---

<Layout
  title="Payment | SeeMyHealth"
  description="Return to the SeeMyHealth app to see your appointment."
  canonicalPath="/payments/return"
  noindex
>
  <Navbar />

  <section class="min-h-[80vh] flex flex-col items-center justify-center bg-brand-black relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full bg-white/[0.015] blur-[100px]"></div>
    </div>

    <div class="max-w-2xl mx-auto px-6 text-center relative z-10 py-16 sm:py-20">
      <div class="relative mb-10">
        <svg class="w-full max-w-md mx-auto h-16 mb-4 opacity-20" viewBox="0 0 400 60" fill="none" preserveAspectRatio="xMidYMid meet">
          <path
            d="M0 30 L80 30 L100 30 L120 10 L140 50 L160 5 L180 55 L200 30 L220 30 L400 30"
            stroke="url(#ecg-gradient-payment)"
            stroke-width="2"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <defs>
            <linearGradient id="ecg-gradient-payment" x1="0" y1="0" x2="400" y2="0">
              <stop offset="0%" stop-color="#ffffff" stop-opacity="0" />
              <stop offset="50%" stop-color="#22C55E" stop-opacity="1" />
              <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
            </linearGradient>
          </defs>
        </svg>

        <div
          id="status-icon"
          class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-white/5 border border-white/10 mb-6"
        >
          <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
        </div>

        <h1
          id="status-headline"
          class="font-display text-2xl sm:text-3xl font-300 uppercase tracking-wide text-white leading-snug mb-3"
        >
          Payment Received
        </h1>
        <p id="status-subtext" class="text-sm text-brand-gray-400 max-w-md mx-auto leading-relaxed">
          You're all set. Your appointment updates in the SeeMyHealth app as soon as the payment
          is confirmed — usually within a few seconds.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="seemyhealth://providers/appointments"
          class="inline-flex items-center px-8 py-3.5 text-[12px] uppercase tracking-[1.5px] font-medium text-brand-black bg-white rounded-full hover:bg-brand-gray-200 transition-colors"
        >
          Back to My Appointments
        </a>
        <a
          href="/"
          class="inline-flex items-center px-8 py-3.5 text-[12px] uppercase tracking-[1.5px] font-medium text-white border border-white/20 rounded-full hover:border-white/40 transition-colors"
        >
          SeeMyHealth Home
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  // Flutterwave appends ?status=successful|cancelled|failed (plus tx_ref / transaction_id).
  // The words change; the truth doesn't — the app confirms the charge by webhook either way.
  const flwStatus = new URLSearchParams(window.location.search).get('status');
  if (flwStatus && flwStatus !== 'successful' && flwStatus !== 'completed') {
    const headline = document.getElementById('status-headline');
    const subtext = document.getElementById('status-subtext');
    if (headline) headline.textContent = 'Payment Not Completed';
    if (subtext)
      subtext.textContent =
        'No charge went through. You can retry the payment from your appointment in the SeeMyHealth app.';
  }
</script>
