---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import OrderHistory from '../../components/commerce/OrderHistory';

export const prerender = true;
---

<Layout
  title="Order History — SeeMyHealth"
  description="View your SeeMyHealth order history and track deliveries."
  canonicalPath="/account/orders"
  noindex
>
  <Navbar />

  <section class="pt-32 pb-20 sm:pt-40 sm:pb-28 bg-brand-black min-h-screen">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <OrderHistory client:load />
    </div>
  </section>

  <Footer />
</Layout>
