---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;
---

<Layout title="Warranty — SeeMyHealth" description="All SeeMyHealth devices come with a 1-year limited warranty covering manufacturing defects." canonicalPath="/warranty">
  <Navbar />

  <section class="pt-32 pb-16 sm:pt-40 sm:pb-20 bg-brand-black">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">Warranty</p>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-300 uppercase leading-[0.95] mb-6">
        Built to Last.<br /><span class="font-500">Backed by Us.</span>
      </h1>
      <p class="text-lg text-brand-gray-400 leading-relaxed">
        Every SeeMyHealth device comes with a 1-year limited warranty. We stand behind the quality of our products.
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-24 bg-brand-dark border-t border-white/5">
    <div class="max-w-3xl mx-auto px-6 lg:px-8 space-y-16">

      <!-- Coverage -->
      <div>
        <h2 class="font-display text-2xl sm:text-3xl font-400 uppercase mb-8">What's Covered</h2>
        <div class="space-y-6 text-brand-gray-400 leading-relaxed">
          <div class="border-b border-white/5 pb-6">
            <h3 class="text-white font-medium mb-2">Manufacturing Defects</h3>
            <p>All SeeMyHealth devices are covered for 1 year from the date of purchase against defects in materials and workmanship under normal use.</p>
          </div>
          <div class="border-b border-white/5 pb-6">
            <h3 class="text-white font-medium mb-2">Battery Performance</h3>
            <p>If your device battery retains less than 80% of its original capacity within the warranty period, we'll replace it free of charge.</p>
          </div>
          <div>
            <h3 class="text-white font-medium mb-2">Sensor Accuracy</h3>
            <p>If any sensor falls outside its published accuracy specification during the warranty period, we'll repair or replace the device.</p>
          </div>
        </div>
      </div>

      <!-- Not covered -->
      <div>
        <h2 class="font-display text-2xl sm:text-3xl font-400 uppercase mb-8">What's Not Covered</h2>
        <div class="space-y-6 text-brand-gray-400 leading-relaxed">
          <div class="border-b border-white/5 pb-6">
            <h3 class="text-white font-medium mb-2">Physical Damage</h3>
            <p>Damage from drops, impacts, crushing, or exposure to conditions beyond the device's rated specifications (e.g., exceeding IP68 depth rating).</p>
          </div>
          <div class="border-b border-white/5 pb-6">
            <h3 class="text-white font-medium mb-2">Unauthorized Modifications</h3>
            <p>Damage resulting from opening, modifying, or repairing the device by anyone other than SeeMyHealth or an authorized service provider.</p>
          </div>
          <div>
            <h3 class="text-white font-medium mb-2">Consumables</h3>
            <p>Hema One test cartridges, Scale batteries (AAA), and other consumable accessories are not covered under warranty.</p>
          </div>
        </div>
      </div>

      <!-- Per device -->
      <div>
        <h2 class="font-display text-2xl sm:text-3xl font-400 uppercase mb-8">Device-Specific Coverage</h2>
        <div class="border-t border-white/10">
          <div class="flex items-center justify-between py-5 border-b border-white/5">
            <span class="text-sm text-white">Ring One</span>
            <span class="text-sm text-brand-gray-400">1-year warranty &middot; IP68 rated</span>
          </div>
          <div class="flex items-center justify-between py-5 border-b border-white/5">
            <span class="text-sm text-white">The Scale / The Scale Pro</span>
            <span class="text-sm text-brand-gray-400">1-year warranty &middot; Batteries not included</span>
          </div>
          <div class="flex items-center justify-between py-5 border-b border-white/5">
            <span class="text-sm text-white">BP Monitor</span>
            <span class="text-sm text-brand-gray-400">1-year warranty &middot; FDA cleared</span>
          </div>
          <div class="flex items-center justify-between py-5 border-b border-white/5">
            <span class="text-sm text-white">Hydra One</span>
            <span class="text-sm text-brand-gray-400">1-year warranty &middot; BPA-free Tritan</span>
          </div>
          <div class="flex items-center justify-between py-5">
            <span class="text-sm text-white">Hema One</span>
            <span class="text-sm text-brand-gray-400">1-year warranty &middot; Cartridges excluded</span>
          </div>
        </div>
      </div>

      <!-- How to claim -->
      <div>
        <h2 class="font-display text-2xl sm:text-3xl font-400 uppercase mb-8">How to File a Claim</h2>
        <div class="space-y-6 text-brand-gray-400 leading-relaxed">
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="bg-brand-gray-900 rounded-xl p-6 border border-white/5">
              <p class="text-white font-medium mb-2">1. Contact Us</p>
              <p class="text-sm">Email <a href="mailto:support@seemyhealth.ai" class="text-white hover:underline">support@seemyhealth.ai</a> with your order number and a description of the issue.</p>
            </div>
            <div class="bg-brand-gray-900 rounded-xl p-6 border border-white/5">
              <p class="text-white font-medium mb-2">2. Ship It Back</p>
              <p class="text-sm">We'll send a prepaid label. Pack the device in its original packaging and drop it off.</p>
            </div>
            <div class="bg-brand-gray-900 rounded-xl p-6 border border-white/5">
              <p class="text-white font-medium mb-2">3. Replacement</p>
              <p class="text-sm">Once verified, we'll ship a replacement within 3–5 business days. Free of charge.</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <Footer />
</Layout>
