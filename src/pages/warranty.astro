---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;

const CF_IMG = "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg";

const devices = [
  { name: "Ring One", slug: "ring-one", image: `${CF_IMG}/ring-hero-hands/public`, color: "#F97316", warranty: "1 Year", note: "IP68 water resistant", icon: "💍" },
  { name: "The Scale", slug: "scale", image: `${CF_IMG}/scale-white-bathroom/public`, color: "#3B82F6", warranty: "1 Year", note: "Batteries not included", icon: "⚖️" },
  { name: "Scale Pro", slug: "scale-pro", image: `${CF_IMG}/scale-pro-black-bathroom/public`, color: "#3B82F6", warranty: "1 Year", note: "Batteries not included", icon: "⚖️" },
  { name: "BP Monitor", slug: "bp-monitor", image: `${CF_IMG}/bp-white-desk-display/public`, color: "#EF4444", warranty: "1 Year", note: "FDA cleared", icon: "❤️" },
  { name: "Hydra One", slug: "hydra-one", image: `${CF_IMG}/bottle-white-kitchen/public`, color: "#06B6D4", warranty: "1 Year", note: "BPA-free Tritan", icon: "💧" },
  { name: "Hema One", slug: "hema-one", image: `${CF_IMG}/hema-one-hero/public`, color: "#A855F7", warranty: "1 Year", note: "Test strips excluded", icon: "🩸" },
];
---

<Layout title="Warranty | SeeMyHealth" description="All SeeMyHealth devices come with a 1-year limited warranty covering manufacturing defects." canonicalPath="/warranty">
  <Navbar />

  <!-- Hero -->
  <section class="pt-32 pb-16 sm:pt-40 sm:pb-20 bg-brand-black relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-emerald-500/[0.03] blur-[120px]"></div>
    </div>
    <div class="max-w-3xl mx-auto px-6 lg:px-8 relative z-10">
      <p class="text-[11px] uppercase tracking-[4px] text-brand-gray-500 mb-4">Warranty</p>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-300 uppercase leading-[0.95] mb-6">
        Built to Last.<br /><span class="font-500">Backed by Us.</span>
      </h1>
      <p class="text-lg text-brand-gray-400 leading-relaxed max-w-xl">
        Every SeeMyHealth device comes with a 1-year limited warranty. If something's not right, we'll make it right — that's a promise.
      </p>
    </div>
  </section>

  <!-- Coverage Promise Cards -->
  <section class="py-16 sm:py-24 bg-brand-dark border-t border-white/5">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <p class="text-[10px] uppercase tracking-[3px] text-brand-gray-600 mb-3">What's Covered</p>
      <h2 class="font-display text-2xl sm:text-3xl font-400 uppercase mb-10">We've Got You Covered</h2>

      <div class="grid sm:grid-cols-3 gap-5">
        <!-- Manufacturing Defects -->
        <div class="bg-brand-gray-900 rounded-2xl p-6 border border-white/5 hover:border-emerald-500/20 transition-colors">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
          </div>
          <h3 class="text-white font-medium mb-2">Manufacturing Defects</h3>
          <p class="text-sm text-brand-gray-400 leading-relaxed">Every device is covered for 1 year from purchase against defects in materials and workmanship under normal use.</p>
        </div>

        <!-- Battery Performance -->
        <div class="bg-brand-gray-900 rounded-2xl p-6 border border-white/5 hover:border-emerald-500/20 transition-colors">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 10.5h.375c.621 0 1.125.504 1.125 1.125v2.25c0 .621-.504 1.125-1.125 1.125H21M3.75 18h15A2.25 2.25 0 0021 15.75v-6a2.25 2.25 0 00-2.25-2.25h-15A2.25 2.25 0 001.5 9.75v6A2.25 2.25 0 003.75 18z" />
            </svg>
          </div>
          <h3 class="text-white font-medium mb-2">Battery Performance</h3>
          <p class="text-sm text-brand-gray-400 leading-relaxed">If your battery drops below 80% of its original capacity within the warranty period, we'll replace it — no questions asked.</p>
        </div>

        <!-- Sensor Accuracy -->
        <div class="bg-brand-gray-900 rounded-2xl p-6 border border-white/5 hover:border-emerald-500/20 transition-colors">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5m.75-9l3-3 2.148 2.148A12.061 12.061 0 0116.5 7.605" />
            </svg>
          </div>
          <h3 class="text-white font-medium mb-2">Sensor Accuracy</h3>
          <p class="text-sm text-brand-gray-400 leading-relaxed">If any sensor drifts outside its published accuracy spec, we'll repair or replace your device free of charge.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What's Not Covered -->
  <section class="py-16 sm:py-24 bg-brand-black border-t border-white/5">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <p class="text-[10px] uppercase tracking-[3px] text-brand-gray-600 mb-3">Good to Know</p>
      <h2 class="font-display text-2xl sm:text-3xl font-400 uppercase mb-10">What's Not Covered</h2>

      <div class="grid sm:grid-cols-3 gap-5">
        <div class="rounded-2xl p-6 border border-white/5 bg-white/[0.02]">
          <div class="w-10 h-10 rounded-lg bg-red-500/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
          </div>
          <h3 class="text-white font-medium mb-2">Physical Damage</h3>
          <p class="text-sm text-brand-gray-400 leading-relaxed">Drops, impacts, crushing, or exposure beyond the device's rated specs (e.g., exceeding IP68 depth).</p>
        </div>

        <div class="rounded-2xl p-6 border border-white/5 bg-white/[0.02]">
          <div class="w-10 h-10 rounded-lg bg-red-500/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l-5.384-3.096M11.42 15.17l2.496-4.324m-2.496 4.324l-.996 1.727M5.653 4.024l2.578 1.489M17.834 4.024l-2.578 1.489m.578 9.693l2 3.461M5.653 4.024L4.5 2.25m13.334 1.774L19.136 2.25M11.42 15.17l-1.766 3.061m0 0l.858 1.486M9.654 18.231l-.858 1.486M3.47 12.07l.857 1.486m14.346-1.486l-.857 1.486" />
            </svg>
          </div>
          <h3 class="text-white font-medium mb-2">Unauthorized Mods</h3>
          <p class="text-sm text-brand-gray-400 leading-relaxed">Opening, modifying, or repairing the device outside of SeeMyHealth or an authorized service provider.</p>
        </div>

        <div class="rounded-2xl p-6 border border-white/5 bg-white/[0.02]">
          <div class="w-10 h-10 rounded-lg bg-red-500/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 00-3.7-3.7 48.678 48.678 0 00-7.324 0 4.006 4.006 0 00-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3l-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 003.7 3.7 48.656 48.656 0 007.324 0 4.006 4.006 0 003.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3l-3 3" />
            </svg>
          </div>
          <h3 class="text-white font-medium mb-2">Consumables</h3>
          <p class="text-sm text-brand-gray-400 leading-relaxed">Hema One test strips, Scale batteries (AAA), and other consumable accessories are wear items.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Device-Specific Coverage -->
  <section class="py-16 sm:py-24 bg-brand-dark border-t border-white/5">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <p class="text-[10px] uppercase tracking-[3px] text-brand-gray-600 mb-3">By Device</p>
      <h2 class="font-display text-2xl sm:text-3xl font-400 uppercase mb-10">Your Device, Your Coverage</h2>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {devices.map((device) => (
          <a href={`/products/${device.slug}`} class="group flex items-center gap-4 rounded-xl bg-brand-gray-900 border border-white/5 hover:border-white/15 p-4 transition-all">
            <div class="w-16 h-16 rounded-lg overflow-hidden flex-shrink-0 bg-brand-gray-800">
              <img src={device.image} alt={device.name} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 mb-1">
                <div class="w-2 h-2 rounded-full flex-shrink-0" style={`background-color: ${device.color}`}></div>
                <p class="text-sm text-white font-medium truncate">{device.name}</p>
              </div>
              <p class="text-xs text-brand-gray-500">{device.warranty} warranty</p>
              <p class="text-xs text-brand-gray-600">{device.note}</p>
            </div>
            <svg class="w-4 h-4 text-brand-gray-600 group-hover:text-white transition-colors flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- How to File a Claim — Visual Steps -->
  <section class="py-16 sm:py-24 bg-brand-black border-t border-white/5">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <p class="text-[10px] uppercase tracking-[3px] text-brand-gray-600 mb-3">Claim Process</p>
      <h2 class="font-display text-2xl sm:text-3xl font-400 uppercase mb-4">Something Wrong? We'll Fix It.</h2>
      <p class="text-brand-gray-400 mb-12 max-w-xl">Three simple steps and we'll have you back on track. Most claims are resolved within a week.</p>

      <!-- Timeline steps -->
      <div class="relative">
        <!-- Connecting line -->
        <div class="hidden sm:block absolute top-8 left-[calc(16.67%+1rem)] right-[calc(16.67%+1rem)] h-px bg-gradient-to-r from-emerald-500/40 via-emerald-500/20 to-emerald-500/40" aria-hidden="true"></div>

        <div class="grid sm:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center mx-auto mb-5 relative">
              <span class="text-emerald-400 font-display text-lg font-500">1</span>
            </div>
            <h3 class="text-white font-medium mb-2">Reach Out</h3>
            <p class="text-sm text-brand-gray-400 leading-relaxed">Email <a href="mailto:support@seemyhealth.ai" class="text-emerald-400 hover:text-emerald-300 transition-colors">support@seemyhealth.ai</a> with your order number and a quick description of the issue. We respond within 24 hours.</p>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center mx-auto mb-5 relative">
              <span class="text-emerald-400 font-display text-lg font-500">2</span>
            </div>
            <h3 class="text-white font-medium mb-2">Send It Back</h3>
            <p class="text-sm text-brand-gray-400 leading-relaxed">We'll email you a prepaid shipping label. Pack the device in its original box and drop it off — no cost to you.</p>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center mx-auto mb-5 relative">
              <span class="text-emerald-400 font-display text-lg font-500">3</span>
            </div>
            <h3 class="text-white font-medium mb-2">Get Your Replacement</h3>
            <p class="text-sm text-brand-gray-400 leading-relaxed">Once we verify the issue, a replacement ships within 3-5 business days. Free of charge, always.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Peace of Mind CTA -->
  <section class="py-16 sm:py-20 bg-brand-dark border-t border-white/5">
    <div class="max-w-3xl mx-auto px-6 lg:px-8 text-center">
      <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
        </svg>
      </div>
      <h2 class="font-display text-2xl sm:text-3xl font-400 uppercase mb-4">Your Health, Our Responsibility</h2>
      <p class="text-brand-gray-400 mb-8 max-w-lg mx-auto">Questions about your warranty? Our support team is here to help — and they're genuinely nice people.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/support"
          class="inline-flex items-center px-8 py-3.5 text-[12px] uppercase tracking-[1.5px] font-medium text-brand-black bg-white rounded-full hover:bg-brand-gray-200 transition-colors"
        >
          Contact Support
        </a>
        <a
          href="/shop"
          class="inline-flex items-center gap-2 px-8 py-3.5 text-[12px] uppercase tracking-[1.5px] font-medium text-white border border-white/20 rounded-full hover:border-white/40 transition-colors"
        >
          Shop Devices
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
