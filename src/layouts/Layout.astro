---
import '../styles/global.css'
import CartDrawer from '../components/commerce/CartDrawer';
import { IS_DEV_SITE, SITE_ORIGIN } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonicalPath?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  // The address carries a secret in its query (a connect link's token): analytics records the
  // page without it.
  secretQuery?: boolean;
}

const SITE = SITE_ORIGIN;
const CF_IMG = "https://imagedelivery.net/NnC2JvU8j4bgBbmedVhjJg";
const DEFAULT_OG = `${CF_IMG}/og-ecosystem/public`;

const {
  title,
  description = "One app. Six devices. Nothing hidden. Ring One, The Scale, The Scale Pro, BP Monitor, Hydra One, Hema One. See your health like never before.",
  ogImage = DEFAULT_OG,
  ogType = "website",
  canonicalPath,
  jsonLd,
  noindex = false,
  secretQuery = false,
} = Astro.props;

const canonicalUrl = canonicalPath ? `${SITE}${canonicalPath}` : `${SITE}${Astro.url.pathname}`;
const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {/* The dev line is never indexed (its robots.txt and X-Robots-Tag header say so too). */}
    {(noindex || IS_DEV_SITE) && <meta name="robots" content="noindex, nofollow" />}

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SeeMyHealth" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/images/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <meta name="theme-color" content="#0A0A0A" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Oswald:wght@200;300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- JSON-LD Structured Data -->
    {jsonLdArray.map((ld) => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}

    <title>{title}</title>
  </head>
  <body class="bg-brand-black text-white font-sans antialiased overflow-x-hidden">
    <slot />
    <CartDrawer client:load />
    <script>
      import { initAllAnimations } from '../scripts/animations';
      document.addEventListener('DOMContentLoaded', initAllAnimations);
    </script>
    <!-- Google Analytics 4 -->
    {/* Production only: the dev line sends nothing to the production GA4 property. */}
    {!IS_DEV_SITE && <Fragment>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FHZ5MMVC1X"></script>
    {secretQuery ? (
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-FHZ5MMVC1X', {
          page_location: location.origin + location.pathname,
          page_referrer: document.referrer ? new URL(document.referrer).origin + '/' : '',
        });
      </script>
    ) : (
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-FHZ5MMVC1X');
      </script>
    )}
    </Fragment>}
  </body>
</html>
