{
	"name": "seemyhealth-bff",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-09",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "www.seemyhealth.ai/api/*",
			"zone_name": "seemyhealth.ai"
		},
		{
			"pattern": "seemyhealth.ai/api/*",
			"zone_name": "seemyhealth.ai"
		}
	],
	// Secrets (set via `npx wrangler secret put <NAME>`):
	// - SHOPIFY_STORE_DOMAIN (shop.seemyhealth.ai)
	// - SHOPIFY_STOREFRONT_TOKEN (public storefront access token)
	// - SHOPIFY_ADMIN_TOKEN (private admin API token)
	// - WEBHOOK_SECRET (Shopify webhook HMAC secret)
	// - SHOP_CONNECT_WEBHOOK_TOKEN (shop account connect: the bearer token for the backend's
	//   POST /webhooks/shop/connect; the same value as the backend's SHOP_CONNECT_WEBHOOK_TOKEN.
	//   Unset, POST /api/shop/connect answers 503 and the page offers Try again.)
	"vars": {
		"ALLOWED_ORIGINS": "https://www.seemyhealth.ai,https://seemyhealth.ai,https://account.seemyhealth.ai",
		// The cmh-golang backend that POST /api/shop/connect calls (/webhooks/shop/connect).
		// Dev while only dev exists (the apps mint their connect links there), as the links Worker's
		// API_BASE; prod at launch.
		"BACKEND_API_BASE": "https://api.dev.seemyhealth.ai"
	}
}
