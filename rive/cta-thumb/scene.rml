            </Node>
            <Node rotation="4.7124" name="Ray 5 Pivot" id="0:109">
                <Shape x="10" name="Ray 5" id="0:34">
                    <PointsPath isClosed="false" name="Path" id="0:110">
                        <StraightVertex x="0" y="0" id="0:111"/>
                        <StraightVertex x="9" y="0" id="0:112"/>
                    </PointsPath>
                    <Stroke thickness="3" cap="round" join="round" name="Stroke" id="0:113">
                        <SolidColor colorValue="FFFFFFFF" name="Color" id="0:114"/>
                    </Stroke>
                </Shape>
            </Node>
            <Node rotation="5.7596" name="Ray 6 Pivot" id="0:115">
                <Shape x="10" name="Ray 6" id="0:35">
                    <PointsPath isClosed="false" name="Path" id="0:116">
                        <StraightVertex x="0" y="0" id="0:117"/>
                        <StraightVertex x="9" y="0" id="0:118"/>
                    </PointsPath>
                    <Stroke thickness="3" cap="round" join="round" name="Stroke" id="0:119">
                        <SolidColor colorValue="FFFFFFFF" name="Color" id="0:120"/>
                    </Stroke>
                </Shape>
            </Node>
        </Node>

        <!-- Internal: the timeline fires this at the tap; the listener below turns it into `tapped`. -->
        <Event name="tap" id="0:60"/>

        <StateMachine name="CtaThumb" id="0:7">
            <StateMachineListenerSingle targetId="0:2" listenerTypeValue="event" eventId="0:60" name="Tap to tapped" id="0:61">
                <ListenerViewModelChange id="0:121">
                    <BindablePropertyTrigger propertyValue="1" id="0:122">
                        <DataBindContext sourcePathIds="0:40-0:43" propertyKey="686" direction="true" id="0:123"/>
                    </BindablePropertyTrigger>
                </ListenerViewModelChange>
            </StateMachineListenerSingle>
            <StateMachineLayer name="Thumb" id="0:8">
                <AnyState x="160" y="-120" id="0:15">
                    <StateTransition stateToId="0:12" id="0:124">
                        <TransitionViewModelCondition id="0:125">
                            <TransitionPropertyViewModelComparator id="0:126">
                                <BindablePropertyTrigger id="0:127">
                                    <DataBindContext sourcePathIds="0:40-0:42" propertyKey="686" id="0:128"/>
                                </BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator id="0:129"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnyState>
                <ExitState x="640" y="-120" id="0:16"/>
                <EntryState x="0" y="0" id="0:17">
                    <StateTransition stateToId="0:12" id="0:130"/>
                </EntryState>
                <!-- Idle: nothing visible until `play`; the thumb comes back here after each visit, or a skip -->
                <AnimationState x="160" y="0" animationId="0:50" id="0:12">
                    <StateTransition stateToId="0:13" id="0:131">
                        <TransitionViewModelCondition id="0:132">
                            <TransitionPropertyViewModelComparator id="0:133">
                                <BindablePropertyTrigger id="0:134">
                                    <DataBindContext sourcePathIds="0:40-0:41" propertyKey="686" id="0:135"/>
                                </BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator id="0:136"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <!-- Tap: the whole moment, then back to idle for the next `play` -->
                <AnimationState x="320" y="0" animationId="0:51" id="0:13">
                    <StateTransition stateToId="0:12" enableExitTime="true"
                                     exitTimeIsPercetange="true" exitTime="100" id="0:137"/>
                </AnimationState>
            </StateMachineLayer>
        </StateMachine>

        <LinearAnimation fps="60" duration="1" name="Hidden" id="0:50">
