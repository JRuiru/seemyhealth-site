<Rive version="1" kind="fragment">
    <!--
      CtaThumb: a thumb that arrives, points at the other store button ("this one?"),
      thinks better of it, glides over and taps the button the page means.

      TAP POINT: artboard (x=150, y=200). The fingertip lands exactly there at 2.45 s
      (frame 147 at 60 fps), when the view model trigger `tapped` fires. The page
      lines this point up with the centre of the HTML store button.

      POINTING SPOT: (150 + pointX, 200 + pointY), from the view model. The page sets
      the offset of the other button's centre from the tap point, in artboard units.

      Rig: `Tap Point` (a Node at 150,200) holds `Point Target`, whose x/y are bound to
      pointX/pointY. `Rig` (also at 150,200) carries a TranslationConstraint to Point
      Target whose strength is keyed 1 while pointing and eased to 0 for the glide, so
      the Rig sits on the pointing spot, then on the tap point whatever the bound values.
      The Thumb's x/y keys are fingertip offsets from the Rig (its origin IS the
      fingertip, the top of the capsule). The artboard has no fill: everything outside
      the moment is transparent, and the thumb rests off the right edge (world x=680).

      View model CtaThumb (auto-bound default instance):
        play   (trigger, in)  starts the timeline from the idle pose
        skip   (trigger, in)  from any state, goes to the empty end pose
        tapped (trigger, out) fired by the timeline at 2.45 s
        pointX, pointY (numbers, in) the pointing spot's offset from the tap point
    -->
    <Artboard defaultStateMachineId="0:7" viewModelId="0:40" viewModelInstanceId="0:44"
              styleId="0:3" clip="true" width="640" height="440" name="CtaThumb" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:3"/>

        <!-- Rig: follows Point Target at strength 1 (pointing), sits at the tap point at 0. -->
        <Node x="150" y="200" name="Rig" id="0:303">
            <TranslationConstraint targetId="0:306" strength="0" name="Follow Point" id="0:304"/>
            <!-- Thumb: pivot at the fingertip. Local +y runs down the thumb towards the hand. -->
            <Node x="530" y="30" rotation="-0.4363" name="Thumb" id="0:10">
                <Shape x="0" y="9" name="Nail" id="0:62">
                    <Rectangle originX="0.5" originY="0" width="36" height="42"
                               cornerRadiusTL="16" name="Path" id="0:63"/>
                    <Fill name="Fill" id="0:64"><SolidColor colorValue="FFF5F5F4" name="Color" id="0:65"/></Fill>
                    <Stroke thickness="1.5" name="Edge" id="0:66"><SolidColor colorValue="FFD6D3D1" name="Color" id="0:67"/></Stroke>
                </Shape>
                <Shape x="0" y="0" name="Knuckle" id="0:68">
                    <PointsPath isClosed="false" name="Crease 1" id="0:69">
                        <StraightVertex x="-11" y="96" id="0:70"/>
                        <StraightVertex x="11" y="96" id="0:71"/>
                    </PointsPath>
                    <PointsPath isClosed="false" name="Crease 2" id="0:72">
                        <StraightVertex x="-7" y="104" id="0:73"/>
                        <StraightVertex x="7" y="104" id="0:74"/>
                    </PointsPath>
                    <Stroke thickness="2" cap="round" name="Stroke" id="0:75"><SolidColor colorValue="FFD6D3D1" name="Color" id="0:76"/></Stroke>
                </Shape>
                <Shape x="0" y="0" name="Body" id="0:77">
                    <Rectangle originX="0.5" originY="0" width="60" height="420"
                               cornerRadiusTL="30" name="Path" id="0:78"/>
                    <Fill name="Fill" id="0:79"><SolidColor colorValue="FFE7E5E4" name="Color" id="0:80"/></Fill>
                </Shape>
                <Shape x="8" y="10" name="Shadow" id="0:11">
                    <Rectangle originX="0.5" originY="0" width="60" height="420"
                               cornerRadiusTL="30" name="Path" id="0:81"/>
                    <Fill fillRule="clockwise" name="Fill" id="0:82">
                        <SolidColor colorValue="59000000" name="Color" id="0:83"/>
                        <Feather strength="6" name="Soft" id="0:84"/>
                    </Fill>
                </Shape>
            </Node>
        </Node>

        <!-- Pointing spot: the tap point plus the page's offset (pointX, pointY). -->
        <Node x="150" y="200" name="Tap Point" id="0:305">
            <Node x="0" y="105" name="Point Target" id="0:306">
                <DataBindContext sourcePathIds="0:40-0:309" propertyKey="13" id="0:307"/>
                <DataBindContext sourcePathIds="0:40-0:310" propertyKey="14" id="0:308"/>
            </Node>
        </Node>

        <!-- Burst: six rays radiating from the tap point, drawn under the thumb. -->
        <Node x="150" y="200" opacity="0" name="Burst" id="0:20">
            <Node rotation="0.5236" name="Ray 1 Pivot" id="0:85">
                <Shape x="10" name="Ray 1" id="0:30">
                    <PointsPath isClosed="false" name="Path" id="0:86">
                        <StraightVertex x="0" y="0" id="0:87"/>
                        <StraightVertex x="9" y="0" id="0:88"/>
                    </PointsPath>
                    <Stroke thickness="3" cap="round" join="round" name="Stroke" id="0:89">
