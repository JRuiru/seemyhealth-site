---
// A call: a video frame, the controls along the bottom, and a waiting light. The picture is a scene
// from the site, never anybody on the call.
import KindIntro from '../components/KindIntro.astro';
import OpenInApp from '../components/OpenInApp.astro';
import { CF_IMG, KIND_COPY } from '../../workers/links/src/catalogue';
const c = KIND_COPY.call;
const controls = [
  'M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z',
  'M15.75 10.5l4.72-4.72a.75.75 0 011.28.53v11.38a.75.75 0 01-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 002.25 7.5v9a2.25 2.25 0 002.25 2.25z',
];
---

<section class="pt-32 pb-20 sm:pt-40 sm:pb-28">
  <div class="max-w-4xl mx-auto px-6 lg:px-8">
    <div class="relative rounded-[28px] overflow-hidden aspect-video border border-white/10 shadow-2xl shadow-black/50 mb-12 link-rise">
      <img src={`${CF_IMG}/${c.photo}/public`} alt="A video consultation on a phone stand" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-black/30"></div>
      <span class="absolute top-4 left-4 flex items-center gap-2 px-3 py-1.5 rounded-full bg-black/50 backdrop-blur border border-white/10 text-[11px] uppercase tracking-[2px]">
        <span class="w-2 h-2 rounded-full bg-scale-blue animate-pulse"></span>Waiting to join
      </span>
      <div class="absolute bottom-4 inset-x-0 flex justify-center gap-3" aria-hidden="true">
        {controls.map((d) => (
          <span class="w-12 h-12 rounded-full bg-white/15 backdrop-blur-xl border border-white/15 flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={d} /></svg>
          </span>
        ))}
        <span class="w-12 h-12 rounded-full bg-bp-red flex items-center justify-center">
          <svg class="w-5 h-5 rotate-[135deg]" fill="currentColor" viewBox="0 0 24 24"><path d="M2 5.5C2 4.12 3.12 3 4.5 3h1.6c.6 0 1.12.4 1.27.98l.95 3.8a1.3 1.3 0 01-.37 1.25L6.6 10.4a12.04 12.04 0 007 7l1.37-1.35a1.3 1.3 0 011.25-.37l3.8.95c.58.15.98.67.98 1.27v1.6c0 1.38-1.12 2.5-2.5 2.5h-1C9.6 22 2 14.4 2 6.5v-1z"/></svg>
        </span>
      </div>
    </div>
    <KindIntro eyebrow={c.eyebrow} title={c.title} bold={c.bold} sentence={c.sentence} icon="providers" />
    <OpenInApp class="mt-10" />
  </div>
</section>
