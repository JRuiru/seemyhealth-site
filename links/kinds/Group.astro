---
// A group: the site's full-bleed hero (a photo under a dark gradient) with a glass card holding the
// words, and a members row drawn as empty seats: who is in a group is for its members to see.
import KindIntro from '../components/KindIntro.astro';
import OpenInApp from '../components/OpenInApp.astro';
import { CF_IMG, KIND_COPY } from '../../workers/links/src/catalogue';
const c = KIND_COPY.group;
---

<section class="relative min-h-[92vh] flex items-end pb-16 sm:pb-20 pt-28 overflow-hidden">
  <div class="absolute inset-0">
    <img src={`${CF_IMG}/${c.photo}/public`} alt="Two friends raising a glass together" class="w-full h-full object-cover" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-t from-brand-black via-brand-black/60 to-brand-black/10"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-brand-black/60 to-transparent"></div>
  </div>
  <div class="relative max-w-3xl mx-auto px-6 lg:px-8 w-full">
    <div class="backdrop-blur-xl bg-white/[0.04] border border-white/[0.08] rounded-3xl px-6 py-8 sm:px-12 sm:py-12 shadow-2xl shadow-black/20">
      <KindIntro eyebrow={c.eyebrow} title={c.title} bold={c.bold} sentence={c.sentence} icon="community" />
      <div class="flex items-center justify-center gap-3 mt-8 mb-8" aria-hidden="true">
        <div class="flex -space-x-3">
          {[0, 1, 2, 3, 4].map((i) => <span class="w-10 h-10 rounded-full border-2 border-brand-black bg-white/10 backdrop-blur" style={`opacity:${1 - i * 0.15}`}></span>)}
        </div>
        <span class="text-[11px] uppercase tracking-[2px] text-white/50">Members see who's here</span>
      </div>
      <OpenInApp />
    </div>
  </div>
</section>
