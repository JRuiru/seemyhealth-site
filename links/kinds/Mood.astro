---
// The mood check-in: five faces and none chosen. The choosing happens in the app, where only the
// person checking in sees it.
import KindIntro from '../components/KindIntro.astro';
import OpenInApp from '../components/OpenInApp.astro';
import { KIND_COPY } from '../../workers/links/src/catalogue';
const c = KIND_COPY.mood;
const faces = [
  { label: 'Rough', mouth: 'M8 16.5c1.2-1.4 2.5-2 4-2s2.8.6 4 2' },
  { label: 'Low', mouth: 'M8.5 15.5c1-.7 2.2-1 3.5-1s2.5.3 3.5 1' },
  { label: 'Okay', mouth: 'M8.5 15h7' },
  { label: 'Good', mouth: 'M8.5 14.5c1 .7 2.2 1 3.5 1s2.5-.3 3.5-1' },
  { label: 'Great', mouth: 'M8 14c1.2 1.4 2.5 2 4 2s2.8-.6 4-2' },
];
---

<section class="pt-32 pb-20 sm:pt-40 sm:pb-28 relative overflow-hidden">
  <div class="absolute top-20 left-1/2 -translate-x-1/2 w-[600px] h-[400px] rounded-full bg-hema-purple/[0.08] blur-[110px] pointer-events-none" aria-hidden="true"></div>
  <div class="relative max-w-3xl mx-auto px-6 lg:px-8">
    <KindIntro eyebrow={c.eyebrow} title={c.title} bold={c.bold} sentence={c.sentence} icon="my-health" />
    <div class="flex justify-center gap-3 sm:gap-5 my-12" aria-hidden="true">
      {faces.map((f, i) => (
        <div class="flex flex-col items-center gap-2 link-rise" style={`animation-delay:${0.2 + i * 0.08}s`}>
          <span class="w-14 h-14 sm:w-16 sm:h-16 rounded-full border border-white/15 bg-white/[0.04] flex items-center justify-center">
            <svg class="w-8 h-8 text-white/80" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><circle cx="9" cy="10" r="0.6" fill="currentColor" /><circle cx="15" cy="10" r="0.6" fill="currentColor" /><path stroke-linecap="round" d={f.mouth} /></svg>
          </span>
          <span class="text-[10px] uppercase tracking-[1.5px] text-white/45">{f.label}</span>
        </div>
      ))}
    </div>
    <OpenInApp />
  </div>
</section>
