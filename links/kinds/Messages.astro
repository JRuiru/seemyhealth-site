---
// Messages: a conversation with every word blurred and a lock over it. Private by design: nothing
// here could ever be a real message, because the page never reads one.
import KindIntro from '../components/KindIntro.astro';
import OpenInApp from '../components/OpenInApp.astro';
import { KIND_COPY } from '../../workers/links/src/catalogue';
const c = KIND_COPY.messages;
const bubbles = [
  { mine: false, w: 'w-40' }, { mine: false, w: 'w-56' }, { mine: true, w: 'w-44' }, { mine: false, w: 'w-32' }, { mine: true, w: 'w-52' },
];
---

<section class="pt-32 pb-20 sm:pt-40 sm:pb-28">
  <div class="max-w-6xl mx-auto px-6 lg:px-8 grid md:grid-cols-2 gap-12 md:gap-16 items-center">
    <div class="relative max-w-sm w-full mx-auto rounded-[32px] border border-white/10 bg-brand-dark p-5 pt-8 link-rise" aria-hidden="true">
      <div class="space-y-3 blur-[3px]">
        {bubbles.map((b) => (
          <div class:list={['flex', b.mine ? 'justify-end' : 'justify-start']}>
            <span class:list={['h-9 rounded-3xl', b.w, b.mine ? 'bg-scale-blue/70 rounded-br-md' : 'bg-white/10 rounded-bl-md']}></span>
          </div>
        ))}
      </div>
      <div class="absolute inset-0 flex items-center justify-center">
        <span class="w-16 h-16 rounded-full bg-brand-black/80 backdrop-blur-xl border border-white/15 flex items-center justify-center">
          <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" /></svg>
        </span>
      </div>
    </div>
    <div>
      <KindIntro eyebrow={c.eyebrow} title={c.title} bold={c.bold} sentence={c.sentence} align="left" />
      <OpenInApp align="left" class="mt-10" />
    </div>
  </div>
</section>
