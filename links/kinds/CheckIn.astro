---
// A practice's printed code: arriving. A pin over the site's ECG line, the three steps of checking in,
// and the reception photo. The practice's name is not read from the address: a page that guessed it
// from a slug would print whatever somebody typed.
import KindIntro from '../components/KindIntro.astro';
import OpenInApp from '../components/OpenInApp.astro';
import { CF_IMG, KIND_COPY } from '../../workers/links/src/catalogue';
const c = KIND_COPY.checkIn;
const steps = [
  { n: '01', title: 'Open the app', text: 'It knows which practice the code belongs to.' },
  { n: '02', title: 'Confirm it is you', text: 'One tap tells reception you have arrived.' },
  { n: '03', title: 'Take a seat', text: "They'll call you when they're ready." },
];
---

<section class="pt-32 pb-20 sm:pt-40 sm:pb-28 relative overflow-hidden">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">
    <div class="relative mb-10 text-center link-rise" aria-hidden="true">
      <svg class="w-full max-w-md mx-auto h-16 mb-4 opacity-25" viewBox="0 0 400 60" fill="none" preserveAspectRatio="xMidYMid meet">
        <path d="M0 30 L80 30 L100 30 L120 10 L140 50 L160 5 L180 55 L200 30 L220 30 L400 30" stroke="#22C55E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-white/5 border border-white/10">
        <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
      </span>
    </div>
    <KindIntro eyebrow={c.eyebrow} title={c.title} bold={c.bold} sentence={c.sentence} icon="providers" />
    <OpenInApp class="mt-10 mb-16" />
    <div class="grid md:grid-cols-[1fr_1.2fr] gap-6 items-stretch">
      <img src={`${CF_IMG}/${c.photo}/public`} alt="A patient checking in at reception" class="rounded-3xl w-full h-full min-h-[220px] object-cover" loading="lazy" />
      <ol class="grid gap-3">
        {steps.map((s) => (
          <li class="rounded-2xl border border-white/10 bg-white/[0.03] p-5 flex gap-4">
            <span class="font-display text-2xl font-300 text-green-400/80">{s.n}</span>
            <span>
              <span class="block font-display text-xl uppercase font-400 mb-1">{s.title}</span>
              <span class="block text-sm text-brand-gray-400">{s.text}</span>
            </span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
