---
// Devices: the family of devices, each in its own colour, as the site's product cards draw them.
// Which of them somebody owns is not the page's to know, so it shows them all.
import KindIntro from '../components/KindIntro.astro';
import OpenInApp from '../components/OpenInApp.astro';
import { CF_IMG, KIND_COPY } from '../../workers/links/src/catalogue';
const c = KIND_COPY.devices;
const devices = [
  { name: 'Ring One', image: 'ring-one', color: '#F97316' },
  { name: 'The Scale', image: 'scale', color: '#3B82F6' },
  { name: 'BP Monitor', image: 'bp-black', color: '#EF4444' },
  { name: 'Hydra One', image: 'hydra-one', color: '#06B6D4' },
  { name: 'Hema One', image: 'hema-one', color: '#A855F7' },
];
---

<section class="pt-32 pb-20 sm:pt-40 sm:pb-28">
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <KindIntro eyebrow={c.eyebrow} title={c.title} bold={c.bold} sentence={c.sentence} icon="my-health" />
    <OpenInApp class="mt-10 mb-14" />
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
      {devices.map((d, i) => (
        <div class="bg-brand-dark rounded-xl border border-white/5 overflow-hidden link-rise" style={`animation-delay:${0.1 + i * 0.08}s`}>
          <img src={`${CF_IMG}/${d.image}/public`} alt={d.name} class="w-full aspect-[4/5] object-cover" loading="lazy" />
          <div class="p-4 text-center">
            <p class="text-xs font-semibold uppercase tracking-wider mb-1" style={`color: ${d.color}`}>{d.name}</p>
            <p class="text-[11px] text-brand-gray-500 uppercase tracking-wider">Syncing in the app</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
