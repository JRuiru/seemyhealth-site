---
// The return from the hosted checkout (Flutterwave). The Worker picks the state from ?status=, a hint
// only: the webhook settles the payment and the app shows it. Neutral unless the gateway said how it
// went, and never a claim this page cannot know.
import KindIntro from '../components/KindIntro.astro';
import OpenInApp from '../components/OpenInApp.astro';
import { PAYMENT_COPY, type PaymentState } from '../../workers/links/src/catalogue';
interface Props { state: PaymentState }
const { state } = Astro.props;
const c = PAYMENT_COPY[state];
const icon = {
  pending: 'M12 6v6l3.75 2.25M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  successful: 'M4.5 12.75l6 6 9-13.5',
  notCompleted: 'M12 9v3.75m0 3.75h.008M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
}[state];
const hue = state === 'notCompleted' ? 'text-amber-300 border-amber-300/30 bg-amber-300/10' : 'text-green-400 border-green-400/30 bg-green-400/10';
---

<section class="min-h-[80vh] flex items-center pt-32 pb-20 relative overflow-hidden">
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full bg-white/[0.015] blur-[100px] pointer-events-none" aria-hidden="true"></div>
  <div class="relative max-w-xl mx-auto px-6 w-full">
    <div class="rounded-3xl border border-white/10 bg-white/[0.03] backdrop-blur-xl p-8 sm:p-12 text-center link-rise">
      <span class:list={['inline-flex items-center justify-center w-16 h-16 rounded-full border mb-8', hue]}>
        <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={icon} /></svg>
      </span>
      <KindIntro eyebrow={c.eyebrow} title={c.title} bold={c.bold} sentence={c.sentence} icon="providers" />
      <OpenInApp class="mt-10" />
    </div>
  </div>
</section>
