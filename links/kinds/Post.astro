---
// A post: a feed card with its words blurred out. Who wrote it and what it says are for people in
// the app; the card shows only the shape of a post, with its likes and comments at --.
import KindIntro from '../components/KindIntro.astro';
import OpenInApp from '../components/OpenInApp.astro';
import { CF_IMG, KIND_COPY } from '../../workers/links/src/catalogue';
const c = KIND_COPY.post;
---

<section class="pt-32 pb-20 sm:pt-40 sm:pb-28">
  <div class="max-w-6xl mx-auto px-6 lg:px-8 grid md:grid-cols-2 gap-12 md:gap-16 items-center">
    <div class="order-2 md:order-1">
      <KindIntro eyebrow={c.eyebrow} title={c.title} bold={c.bold} sentence={c.sentence} icon="community" align="left" />
      <OpenInApp align="left" class="mt-10" />
    </div>
    <article class="order-1 md:order-2 relative max-w-sm w-full mx-auto rounded-[28px] border border-white/10 bg-brand-dark p-5 shadow-2xl shadow-black/40 link-rise" aria-hidden="true">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-10 h-10 rounded-full bg-gradient-to-br from-accent/60 to-accent-light/30"></span>
        <span class="flex-1 space-y-2"><span class="block h-2.5 w-28 rounded-full bg-white/15"></span><span class="block h-2 w-16 rounded-full bg-white/[0.07]"></span></span>
      </div>
      <div class="space-y-2 mb-4 blur-[2px]">
        <span class="block h-2.5 rounded-full bg-white/15"></span>
        <span class="block h-2.5 rounded-full bg-white/15 w-11/12"></span>
        <span class="block h-2.5 rounded-full bg-white/15 w-2/3"></span>
      </div>
      <div class="rounded-2xl overflow-hidden aspect-[4/3] mb-4">
        <img src={`${CF_IMG}/${c.photo}/public`} alt="" class="w-full h-full object-cover blur-md scale-110 opacity-70" />
      </div>
      <div class="flex items-center gap-6 text-white/50 text-[13px]">
        <span class="flex items-center gap-1.5"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>--</span>
        <span class="flex items-center gap-1.5"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.76c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.076-4.076a1.526 1.526 0 011.037-.443 48.282 48.282 0 005.68-.494c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" /></svg>--</span>
      </div>
      <span class="absolute top-5 right-5 px-3 py-1 rounded-full bg-black/50 backdrop-blur border border-white/10 text-[10px] uppercase tracking-[2px] text-white/70">In the app</span>
    </article>
  </div>
</section>
