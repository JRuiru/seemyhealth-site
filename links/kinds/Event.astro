---
// An event: a ticket. A photo strip, a date tile that reads -- (when it is is the group's to say),
// a perforated tear, and the words. Nothing about which event, or whose.
import KindIntro from '../components/KindIntro.astro';
import OpenInApp from '../components/OpenInApp.astro';
import { CF_IMG, KIND_COPY } from '../../workers/links/src/catalogue';
const c = KIND_COPY.event;
---

<section class="pt-32 pb-20 sm:pt-40 sm:pb-28">
  <div class="max-w-xl mx-auto px-6">
    <article class="rounded-[28px] overflow-hidden border border-white/10 bg-brand-dark shadow-2xl shadow-black/40 link-rise">
      <div class="relative h-48 sm:h-56">
        <img src={`${CF_IMG}/${c.photo}/public`} alt="A picnic basket on the grass with a SeeMyHealth bottle" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-brand-dark to-transparent"></div>
        <div class="absolute left-5 bottom-0 translate-y-1/2 w-20 h-20 rounded-2xl bg-white text-brand-black flex flex-col items-center justify-center shadow-xl" aria-hidden="true">
          <span class="text-[11px] uppercase tracking-[2px] text-hydra-cyan font-semibold">---</span>
          <span class="font-display text-3xl font-500 leading-none">--</span>
        </div>
      </div>
      <div class="px-6 sm:px-8 pt-14 pb-6">
        <KindIntro eyebrow={c.eyebrow} title={c.title} bold={c.bold} sentence={c.sentence} icon="community" align="left" />
      </div>
      <div class="relative h-6" aria-hidden="true">
        <span class="absolute -left-3 top-0 w-6 h-6 rounded-full bg-brand-black"></span>
        <span class="absolute -right-3 top-0 w-6 h-6 rounded-full bg-brand-black"></span>
        <span class="absolute left-6 right-6 top-1/2 border-t border-dashed border-white/15"></span>
      </div>
      <div class="px-6 sm:px-8 pb-8 pt-2">
        <OpenInApp align="left" />
      </div>
    </article>
  </div>
</section>
