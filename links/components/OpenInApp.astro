---
// "Open in the App": a link to this same address. With the app installed, a tap from a message or
// an email opens the app before this page ever loads; on a page already open in the browser, iOS
// does not hand a same-site tap to the app, which is why the line under it says to tap the link
// again from where it came. The href is empty on purpose: it means "this address" without the page
// repeating it, so an invite's token is never written into the page.
interface Props { class?: string; align?: 'center' | 'left' }
const { class: className = '', align = 'center' } = Astro.props;
---

<div class:list={['flex flex-col gap-3', align === 'center' ? 'items-center' : 'items-start', className]}>
  <a href="" data-open-app class="inline-flex items-center gap-2 px-8 py-4 text-[13px] uppercase tracking-[1.5px] font-medium text-brand-black bg-white rounded-full hover:bg-brand-gray-200 transition-colors">
    Open in the App
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
  </a>
  <a href="#get" class="text-[12px] text-white/45 hover:text-white/70 transition-colors">No app yet? Get it free</a>
</div>
