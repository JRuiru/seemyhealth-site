{
  "name": "seemyhealth-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "check:bff": "npm --prefix workers/bff run typecheck",
    "preview": "astro preview",
    "astro": "astro",
    "upload": "./scripts/upload-assets.sh",
    "deploy": "./scripts/deploy.sh",
    "links:generate": "node --experimental-strip-types workers/links/scripts/generate.mjs",
    "links:check": "node --experimental-strip-types workers/links/scripts/generate.mjs --check",
    "links:typecheck": "tsc -p workers/links",
    "links:build": "astro build --config astro.links.config.mjs && node --experimental-strip-types workers/links/scripts/build-og.mjs",
    "links:test": "npm run links:build && node --experimental-strip-types --test workers/links/test/*.test.mjs",
    "links:dev": "npm run links:build && wrangler dev -c workers/links/wrangler.jsonc --local",
    "links:dry-run": "wrangler deploy -c workers/links/wrangler.jsonc --env=\"\" --dry-run"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "@resvg/resvg-wasm": "2.6.2",
    "@rive-app/canvas-lite": "2.44.0",
    "@splinetool/runtime": "2.0.101",
    "@tailwindcss/vite": "4.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "astro": "7.3.2",
    "gsap": "3.15.0",
    "hls.js": "1.6.16",
    "jpeg-js": "0.4.4",
    "lenis": "1.3.23",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "satori": "0.15.2",
    "tailwindcss": "4.3.0",
    "wrangler": "4.130.0",
    "yoga-wasm-web": "0.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@cloudflare/workers-types": "5.20261013.1",
    "typescript": "6.0.3"
  }
}
